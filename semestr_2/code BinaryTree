void MainWindow::onShowHorizontalText() {
    textOutput_->clear(); // Очищаем поле вывода
    textOutput_->append("Горизонтальная:\n" + QString::fromStdString(tree_.printHorizontal()));
}

void MainWindow::onShowVerticalText() {
    textOutput_->clear();
    textOutput_->append("Вертикальная:\n" + QString::fromStdString(tree_.printVertical()));
}


