// Содержит объявление структуры узла дерева Node и класса BinaryTree, реализующего бинарное дерево с набором операций
#ifndef BINARYTREE_H
#define BINARYTREE_H

#include <string>
#include <vector>
#include <tuple>

// Структура, представляющая узел бинарного дерева.
// Каждый узел хранит символ (char) и указатели на левое и правое поддеревья.
struct Node {
    char data;      ///< Информационное поле (ключ) узла.
    Node* left;     ///< Указатель на левое поддерево.
    Node* right;    ///< Указатель на правое поддерево.

    // Конструктор узла.
    Node(char c) : data(c), left(nullptr), right(nullptr) {}
};

// Класс бинарного дерева.
// Обеспечивает построение идеально сбалансированного дерева, преобразование в дерево поиска (BST), операции вставки, удаления, поиска, а также пошаговую визуализацию обходов и поиска.
class BinaryTree {
public:
    BinaryTree(); // Конструктор по умолчанию.
    ~BinaryTree(); // Деструктор (освобождает память).

// Построить идеально сбалансированное бинарное дерево из строки символов.
// Строка символов, из которых формируются узлы.
// Средний элемент становится корнем, затем рекурсивно левая и правая половины.
    void buildBalanced(const std::string& s);


// Преобразовать текущее дерево в сбалансированное дерево поиска (BST).
// Собирает все ключи, сортирует их и строит новое идеально сбалансированное BST. Старое дерево удаляется.
    void convertToBST();
    // Вставить ключ в дерево поиска.
    void insertBST(char key);

    // Удалить ключ из дерева поиска.
    void deleteBST(char key);

    // Проверить наличие ключа в дереве поиска (обычный, не пошаговый поиск).
    bool searchBST(char key) const;

    //Сбалансировать существующее дерево поиска.
    void balanceBST();

    // Подсчитать количество узлов с заданным ключом во всём дереве.
    int countKey(char key) const;

    // Получить последовательность узлов, посещённых при поиске в BST (пошаговый режим).
    std::vector<Node*> searchBSTSteps(char key) const;

    // Получить последовательность всех узлов (для пошагового подсчёта).
    std::vector<Node*> countKeySteps(char key) const;

    // Текстовые представления обходов
    std::string inorder() const; // Симметричный (лево-корень-право) обход в виде строки.
    std::string preorder() const; // Прямой (корень-лево-право) обход в виде строки.
    std::string postorder() const; // Обратный (лево-право-корень) обход в виде строки.
    std::string printHorizontal() const; // Горизонтальная печать (поворот на 90°).
    std::string printVertical() const; // Вертикальная печать (по уровням).

    // Вычислить координаты всех узлов для графической визуализации.
    std::vector<std::tuple<Node*, int, int>> layoutTree() const;

    void clear(); // Очистить дерево (удаляет все узлы).
    Node* root() const { return root_; } // Получить указатель на корень дерева.
    bool isBST() const { return isBST_; } // Проверить, является ли дерево деревом поиска.

    void buildSpindly(const std::string& s); // Построить вырожденное дерево ("бамбук": каждый следующий узел — правый ребёнок).
    void balanceTree(); // Сбалансировать произвольное дерево

    // Вставить узел в заданную позицию
    bool insertNode(char parentKey, char key, bool asLeftChild);

    // Удалить первый найденный узел с заданным ключом
    bool deleteNode(char key);

    // Обходы, возвращающие вектор указателей
    std::vector<Node*> inorderTraversal() const;
    std::vector<Node*> preorderTraversal() const;
    std::vector<Node*> postorderTraversal() const;

private:
    Node* root_; // Корень дерева.
    bool isBST_; // Флаг, показывающий, что дерево является BST.

    // Внутренние рекурсивные реализации
    Node* buildBalancedRec(const std::string& s, int left, int right);
    Node* insertBSTRec(Node* node, char key);
    Node* deleteBSTRec(Node* node, char key);
    Node* minValueNode(Node* node);
    bool searchBSTRec(Node* node, char key) const;
    int countKeyRec(Node* node, char key) const;
    void inorderRec(Node* node, std::string& out) const;
    void preorderRec(Node* node, std::string& out) const;
    void postorderRec(Node* node, std::string& out) const;
    void deleteRec(Node* node);
    void storeInorder(Node* node, std::vector<char>& arr) const;
    Node* buildBalancedBST(const std::vector<char>& arr, int start, int end);
    Node* buildBalancedFromVector(const std::vector<char>& arr, int start, int end);

    // Геометрия для визуализации
    void layoutRec(Node* node, int x, int y, int hGap,
                   std::vector<std::tuple<Node*, int, int>>& layout) const;
    int getHeight(Node* node) const;
    int getSubtreeWidth(Node* node) const;

    // Вспомогательные для пошагового поиска и подсчёта
    void searchBSTStepsRec(Node* node, char key, std::vector<Node*>& steps) const;
    void countKeyStepsRec(Node* node, char key, std::vector<Node*>& steps) const;

    // Для ручной вставки/удаления
    Node* findNode(Node* node, char key) const;
    std::pair<Node*, Node*> findNodeAndParent(Node* node, Node* parent, char key) const;

    // Сбор указателей при обходах
    void collectInorder(Node* node, std::vector<Node*>& vec) const;
    void collectPreorder(Node* node, std::vector<Node*>& vec) const;
    void collectPostorder(Node* node, std::vector<Node*>& vec) const;
};

#endif








