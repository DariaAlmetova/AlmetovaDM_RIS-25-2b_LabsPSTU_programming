// Визуализация дерева
void MainWindow::updateVisualization() {
    scene_->clear(); // Очищаем сцену

    if (!tree_.root()) { // Если дерево отсутствует
        QGraphicsTextItem *text = scene_->addText("Дерево пустое");
        QFont font;
        font.setPointSize(28);
        font.setBold(true);
        text->setFont(font);
        text->setDefaultTextColor(Qt::black);
        text->setPos(0, 0);
        scene_->setSceneRect(scene_->itemsBoundingRect().adjusted(-20, -20, 20, 20));
        view_->fitInView(scene_->sceneRect(), Qt::KeepAspectRatio);
        return;
    }

    auto layout = tree_.layoutTree(); // Получаем координаты всех узлов (preorder)

    // Рёбра
    for (const auto& [node, x, y] : layout) {
        if (node->left) { // Если есть левый ребёнок
            for (const auto& [child, cx, cy] : layout) {
                if (child == node->left) { // Нашли координаты левого ребёнка
                    scene_->addLine(x, y, cx, cy, QPen(Qt::black));
                    break;
                }
            }
        }
        if (node->right) { // Если есть правый ребёнок
            for (const auto& [child, cx, cy] : layout) {
                if (child == node->right) {
                    scene_->addLine(x, y, cx, cy, QPen(Qt::black));
                    break;
                }
            }
        }
    }

    // Текущий подсвеченный узел (если активен пошаговый режим)
    Node* highlightNode = nullptr;
    if (stepActive_ && stepIndex_ >= 0 && stepIndex_ < static_cast<int>(stepSequence_.size())) {
        highlightNode = stepSequence_[stepIndex_]; // Узел, который нужно выделить
    }

    // Узлы
    const int radius = 20; // Радиус кружка узла
    for (const auto& [node, x, y] : layout) {
        if (!node) continue; // Пропускаем нулевые указатели

        QColor fillColor = (node == highlightNode) ? QColor(255, 100, 100)
                                                   : QColor(235, 225, 245);
        scene_->addEllipse(x - radius, y - radius, 2*radius, 2*radius,
                           QPen(QColor(148, 0, 211)),
                           QBrush(fillColor));

        QGraphicsTextItem *text = scene_->addText(QString(node->data)); // Текст с символом
        if (text) {
            if (node == highlightNode)
                text->setDefaultTextColor(Qt::white);
            text->setPos(x - text->boundingRect().width()/2,
                         y - text->boundingRect().height()/2); // Центрирование текста
        }

        // Стрелка для режима поиска (на последнем шаге, если узел найден)
        if (mode_ == Mode::Search && stepActive_ &&
            stepIndex_ == static_cast<int>(stepSequence_.size())-1 &&
            node == searchFound_) {
            QColor arrowColor(255, 105, 180);
            QPen arrowPen(arrowColor, 2);
            const double tipY = y - radius; // Верхняя точка круга (туда нацелена стрелка)
            const double shaftTopY = tipY - 25; // Длина стрелки
            scene_->addLine(x, shaftTopY, x, tipY, arrowPen); // Стрелка
            // Наконечник стрелки (треугольник, направленный вниз)
            QPolygonF arrowHead;
            arrowHead << QPointF(x, tipY) // Остриё
                      << QPointF(x - 4, tipY - 6) // Левый угол основания
                      << QPointF(x + 4, tipY - 6); // Правый угол основания
            scene_->addPolygon(arrowHead, QPen(arrowColor), QBrush(arrowColor));
        }

        // Стрелки для режима подсчёта (все узлы с искомым ключом)
        if (mode_ == Mode::Count && countMatches_.count(node)) {
            QColor arrowColor(255, 105, 180);
            QPen arrowPen(arrowColor, 2);
            const double tipY = y - radius;
            const double shaftTopY = tipY - 25;
            scene_->addLine(x, shaftTopY, x, tipY, arrowPen);
            QPolygonF arrowHead;
            arrowHead << QPointF(x, tipY)
                      << QPointF(x - 4, tipY - 6)
                      << QPointF(x + 4, tipY - 6);
            scene_->addPolygon(arrowHead, QPen(arrowColor), QBrush(arrowColor));
        }
    }

    // Автоматически подгоняем границы сцены под все элементы с небольшими полями
    QRectF bounds = scene_->itemsBoundingRect().adjusted(-40, -40, 40, 40);
    scene_->setSceneRect(bounds);
    view_->fitInView(bounds, Qt::KeepAspectRatio); // Вписываем с сохранением пропорций
}

// Создание дерева
void MainWindow::onBuildSpindly() {
    bool ok;
    QString input = QInputDialog::getText(this, "Бамбук", "Введите строку символов:", QLineEdit::Normal, "", &ok);
    if (ok) {
        tree_.buildSpindly(input.toStdString()); // Строим вырожденное дерево
        updateVisualization();
    }
}

void MainWindow::onBuildBalanced() {
    bool ok;
    QString input = QInputDialog::getText(this, "Сбалансированное", "Строка символов:", QLineEdit::Normal, "", &ok);
    if (ok) {
        tree_.buildBalanced(input.toStdString()); // Идеально сбалансированное дерево
        updateVisualization();
    }
}

void MainWindow::onBalanceTree() {
    if (!tree_.root()) {
        QMessageBox::warning(this, "Ошибка", "Дерево пустое.");
        return;
    }
    tree_.balanceTree(); // Балансировка произвольного дерева
    updateVisualization();
    textOutput_->append("Дерево сбалансировано.");
}

void MainWindow::onConvertToBST() {
    if (!tree_.root()) {
        QMessageBox::warning(this, "Ошибка", "Дерево не создано.");
        return;
    }
    tree_.convertToBST(); // Преобразование в BST
    updateVisualization();
    textOutput_->append("Преобразовано в сбалансированное дерево поиска.");
}

// Операции над BST
void MainWindow::onInsertBST() {
    if (!tree_.isBST()) {
        QMessageBox::warning(this, "Ошибка", "Дерево не является BST.");
        return;
    }
    bool ok;
    QString keyStr = QInputDialog::getText(this, "Вставка в BST", "Введите символ:", QLineEdit::Normal, "", &ok);
    if (ok && keyStr.length() == 1) {
        tree_.insertBST(keyStr.at(0).toLatin1()); // Вставка одного символа
        updateVisualization();
    }
}

void MainWindow::onDeleteBST() {
    if (!tree_.isBST()) {
        QMessageBox::warning(this, "Ошибка", "Дерево не является BST.");
        return;
    }
    bool ok;
    QString keyStr = QInputDialog::getText(this, "Удаление из BST", "Введите символ:", QLineEdit::Normal, "", &ok);
    if (ok && keyStr.length() == 1) {
        tree_.deleteBST(keyStr.at(0).toLatin1()); // Удаление символа
        updateVisualization();
    }
}

void MainWindow::onSearchBST() {
    if (!tree_.isBST()) {
        QMessageBox::warning(this, "Ошибка", "Дерево не является BST.");
        return;
    }
    bool ok;
    QString keyStr = QInputDialog::getText(this, "Поиск", "Символ:", QLineEdit::Normal, "", &ok);
    if (!ok || keyStr.length() != 1) return;
    char key = keyStr.at(0).toLatin1();
    stepSequence_ = tree_.searchBSTSteps(key); // Получаем пошаговый маршрут поиска
    if (stepSequence_.empty()) {
        textOutput_->append("Дерево пустое.");
        return;
    }
    // Если последний узел в маршруте содержит искомый ключ — поиск успешен
    searchFound_ = (stepSequence_.back()->data == key) ? stepSequence_.back() : nullptr;
    mode_ = Mode::Search; // Устанавливаем режим поиска
    startStepMode(stepSequence_); // Запускаем пошаговый режим
}

void MainWindow::onBalanceBST() {
    if (!tree_.isBST()) {
        QMessageBox::warning(this, "Ошибка", "Сначала преобразуйте в BST.");
        return;
    }
    tree_.balanceBST(); // Балансировка BST
    updateVisualization();
    textOutput_->append("BST сбалансировано.");
}

void MainWindow::onCountKey() {
    bool ok;
    QString keyStr = QInputDialog::getText(this, "Подсчёт", "Символ:", QLineEdit::Normal, "", &ok);
    if (!ok || keyStr.length() != 1) return;
    char key = keyStr.at(0).toLatin1();
    stepSequence_ = tree_.countKeySteps(key); // Получаем preorder-обход для подсчёта
    if (stepSequence_.empty()) {
        textOutput_->append("Дерево пустое.");
        return;
    }
    countMatches_.clear();
    // Заполняем множество узлов, содержащих искомый ключ
    for (Node* n : stepSequence_) {
        if (n && n->data == key) countMatches_.insert(n);
    }
    mode_ = Mode::Count; // Режим подсчёта
    startStepMode(stepSequence_);
}

// Произвольная правка дерева (ручная вставка и удаление)
void MainWindow::onInsertNode() {
    if (!tree_.root()) {
        QMessageBox::warning(this, "Ошибка", "Дерево пустое.");
        return;
    }
    bool ok;
    // Запрашиваем родительский узел
    QString parentStr = QInputDialog::getText(this, "Родитель", "Символ родительского узла:", QLineEdit::Normal, "", &ok);
    if (!ok || parentStr.length() != 1) return;
    char parentKey = parentStr.at(0).toLatin1();

    // Выбираем сторону (лево/право)
    QStringList sides = {"Левый", "Правый"};
    QString side = QInputDialog::getItem(this, "Сторона", "Куда вставить:", sides, 0, false, &ok);
    if (!ok) return;
    bool asLeft = (side == "Левый");

    // Запрашиваем символ нового узла
    QString keyStr = QInputDialog::getText(this, "Новый узел", "Символ нового узла:", QLineEdit::Normal, "", &ok);
    if (!ok || keyStr.length() != 1) return;
    char key = keyStr.at(0).toLatin1();

    if (tree_.insertNode(parentKey, key, asLeft)) { // Пытаемся вставить
        updateVisualization();
        textOutput_->append(QString("Узел '%1' добавлен к '%2' как %3 ребёнок.")
                                .arg(key).arg(parentKey).arg(asLeft ? "левый" : "правый"));
    } else {
        QMessageBox::warning(this, "Ошибка", "Не удалось вставить: родитель не найден или позиция занята.");
    }
}

void MainWindow::onDeleteNode() {
    if (!tree_.root()) {
        QMessageBox::warning(this, "Ошибка", "Дерево пустое.");
        return;
    }
    bool ok;
    QString keyStr = QInputDialog::getText(this, "Удаление узла", "Символ удаляемого узла:", QLineEdit::Normal, "", &ok);
    if (!ok || keyStr.length() != 1) return;
    char key = keyStr.at(0).toLatin1();
    if (tree_.deleteNode(key)) { // Удаляем первый попавшийся узел с таким ключом
        updateVisualization();
        textOutput_->append(QString("Узел '%1' удалён.").arg(key));
    } else {
        QMessageBox::information(this, "Не найдено", "Узел с таким символом не найден.");
    }
}

// Пошаговый режим (общий для обходов, поиска, подсчёта)
void MainWindow::startStepMode(const std::vector<Node*>& nodes) {
    stepSequence_ = nodes; // Сохраняем последовательность узлов
    stepIndex_ = -1; // Индекс перед первым элементом
    stepActive_ = true; // Активируем пошаговый режим
    traversalBar_->setEnabled(true); // Включаем панель инструментов
    onStepForward(); // Сразу показываем первый элемент
}

QString MainWindow::collectTraversalString(const std::vector<Node*>& nodes) const {
    QString result;
    for (const auto& n : nodes) {
        if (n) {
            result += n->data; // Добавляем символ узла
            result += ' '; // Разделитель
        }
    }
    if (!result.isEmpty()) result.chop(1); // Убираем последний пробел
    return result;
}

void MainWindow::onStepForward() {
    if (!stepActive_ || stepSequence_.empty()) return;
    if (stepIndex_ < static_cast<int>(stepSequence_.size()) - 1) {
        stepIndex_++; // Переход к следующему узлу
        if (stepSequence_[stepIndex_]) {
            updateVisualization(); // Перерисовываем с выделением
            textOutput_->append(QString("Текущий: '%1'").arg(stepSequence_[stepIndex_]->data));
        }
    }
}

void MainWindow::onStepBackward() {
    if (!stepActive_ || stepSequence_.empty()) return;
    if (stepIndex_ > 0) {
        stepIndex_--; // Возврат к предыдущему узлу
        if (stepSequence_[stepIndex_]) {
            updateVisualization();
            textOutput_->append(QString("Текущий: '%1'").arg(stepSequence_[stepIndex_]->data));
        }
    }
}

void MainWindow::onStopTraversal() {
    if (stepActive_ && !stepSequence_.empty()) {
        // Выводим итоговую информацию в зависимости от режима
        if (mode_ == Mode::Traversal) {
            textOutput_->append("Итог обхода: " + collectTraversalString(stepSequence_));
        } else if (mode_ == Mode::Search) {
            if (searchFound_) textOutput_->append(QString("Элемент '%1' найден.").arg(searchFound_->data));
            else textOutput_->append("Элемент не найден.");
        } else if (mode_ == Mode::Count) {
            int cnt = static_cast<int>(countMatches_.size());
            if (!countMatches_.empty()) {
                char c = (*countMatches_.begin())->data;
                textOutput_->append(QString("Количество '%1': %2").arg(c).arg(cnt));
            } else {
                textOutput_->append(QString("Количество: 0"));
            }
        }
    }
    // Сброс состояния пошагового режима
    stepActive_ = false;
    stepIndex_ = -1;
    stepSequence_.clear();
    searchFound_ = nullptr;
    countMatches_.clear();
    mode_ = Mode::None;
    traversalBar_->setEnabled(false);
    updateVisualization();
    textOutput_->append("Режим завершён.");
}

// Запуск обходов
void MainWindow::onShowInorder()  { mode_ = Mode::Traversal; startStepMode(tree_.inorderTraversal()); }
void MainWindow::onShowPreorder() { mode_ = Mode::Traversal; startStepMode(tree_.preorderTraversal()); }
void MainWindow::onShowPostorder(){ mode_ = Mode::Traversal; startStepMode(tree_.postorderTraversal()); }

