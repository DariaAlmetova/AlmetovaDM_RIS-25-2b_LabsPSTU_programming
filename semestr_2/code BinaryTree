#include "binarytree.h"
#include <algorithm>
#include <sstream>
#include <queue>
#include <cmath>
#include <functional>

// Конструктор и деструктор
BinaryTree::BinaryTree() : root_(nullptr), isBST_(false) {} // Изначально дерево пусто, не BST
BinaryTree::~BinaryTree() { clear(); } // Освобождаем всю память

void BinaryTree::clear() {
    deleteRec(root_); // Рекурсивно удаляем все узлы
    root_ = nullptr; // Обнуляем корень
    isBST_ = false; // Сбрасываем флаг BST
}

// Построение идеально сбалансированного дерева
void BinaryTree::buildBalanced(const std::string& s) {
    clear(); // Удаляем предыдущее дерево
    if (!s.empty()) {
        int n = static_cast<int>(s.size()); // Определяем длину строки
        root_ = buildBalancedRec(s, 0, n - 1); // Рекурсивное построение
    }
}

Node* BinaryTree::buildBalancedRec(const std::string& s, int left, int right) {
    if (left > right) return nullptr; // Условие выхода из рекурсии
    int mid = left + (right - left) / 2; // Средний элемент для баланса
    Node* node = new Node(s[mid]); // Создаём корень поддерева
    node->left = buildBalancedRec(s, left, mid - 1); // Левая половина
    node->right = buildBalancedRec(s, mid + 1, right); // Правая половина
    return node;
}

// Преобразование в дерево поиска
void BinaryTree::convertToBST() {
    if (!root_) return; // Нет дерева – выходим
    std::vector<char> arr;
    storeInorder(root_, arr); // Собираем все ключи inorder
    std::sort(arr.begin(), arr.end()); // Сортируем по возрастанию
    int n = static_cast<int>(arr.size());
    Node* newRoot = buildBalancedBST(arr, 0, n - 1); // Новое сбалансированное BST
    deleteRec(root_); // Удаляем старое дерево
    root_ = newRoot;
    isBST_ = true; // Теперь дерево – BST
}

Node* BinaryTree::buildBalancedBST(const std::vector<char>& arr, int start, int end) {
    if (start > end) return nullptr;
    int mid = start + (end - start) / 2; // Такой же принцип баланса
    Node* node = new Node(arr[mid]);
    node->left = buildBalancedBST(arr, start, mid - 1);
    node->right = buildBalancedBST(arr, mid + 1, end);
    return node;
}

// Вставка / удаление в BST
void BinaryTree::insertBST(char key) {
    if (!isBST_) return; // Вставка допустима только в BST
    root_ = insertBSTRec(root_, key);
}

Node* BinaryTree::insertBSTRec(Node* node, char key) {
    if (!node) return new Node(key); // Базовый случай – создаём новый узел
    if (key < node->data) // Меньше – идём влево
        node->left = insertBSTRec(node->left, key);
    else if (key > node->data) // Больше – идём вправо
        node->right = insertBSTRec(node->right, key);
    // Дубликаты игнорируются
    return node;
}

void BinaryTree::deleteBST(char key) {
    if (!isBST_) return;  // Удаление только в BST
    root_ = deleteBSTRec(root_, key);
}

Node* BinaryTree::deleteBSTRec(Node* node, char key) {
    if (!node) return node;
    if (key < node->data)
        node->left = deleteBSTRec(node->left, key);
    else if (key > node->data)
        node->right = deleteBSTRec(node->right, key);
    else {
        // Нашли узел для удаления
        if (!node->left) { // Нет левого поддерева
            Node* temp = node->right;
            delete node;
            return temp;
        } else if (!node->right) { // Нет правого поддерева
            Node* temp = node->left;
            delete node;
            return temp;
        }
        // Два поддерева: заменяем минимальным из правого
        Node* temp = minValueNode(node->right);
        node->data = temp->data;
        node->right = deleteBSTRec(node->right, temp->data);
    }
    return node;
}

Node* BinaryTree::minValueNode(Node* node) {
    Node* current = node;
    while (current && current->left) // Самый левый узел – минимальный
        current = current->left;
    return current;
}

// Поиск в BST (обычный)
bool BinaryTree::searchBST(char key) const {
    if (!isBST_) return false; // Только для BST
    return searchBSTRec(root_, key);
}

bool BinaryTree::searchBSTRec(Node* node, char key) const {
    if (!node) return false;
    if (key == node->data) return true; // Нашли
    if (key < node->data) return searchBSTRec(node->left, key); // Ищем влево
    return searchBSTRec(node->right, key); // Ищем вправо
}

// Балансировка существующего BST
void BinaryTree::balanceBST() {
    if (!isBST_ || !root_) return; // Балансируем только BST
    std::vector<char> arr;
    storeInorder(root_, arr); // Собираем отсортированный массив (inorder даёт порядок)
    int n = static_cast<int>(arr.size());
    Node* newRoot = buildBalancedBST(arr, 0, n - 1); // Строим идеально сбалансированное BST
    deleteRec(root_);
    root_ = newRoot;  // Старое удалено
}

// Подсчёт узлов с заданным ключом (во всём дереве)
int BinaryTree::countKey(char key) const {
    return countKeyRec(root_, key); // Простой рекурсивный обход
}

int BinaryTree::countKeyRec(Node* node, char key) const {
    if (!node) return 0;
    int cnt = (node->data == key) ? 1 : 0; // Текущий узел совпадает?
    cnt += countKeyRec(node->left, key); // Добавляем левое поддерево
    cnt += countKeyRec(node->right, key); // Добавляем правое
    return cnt;
}

// Текстовые обходы (возвращают строку)
std::string BinaryTree::inorder() const {
    std::string result;
    inorderRec(root_, result);
    return result;
}
void BinaryTree::inorderRec(Node* node, std::string& out) const {
    if (!node) return;
    inorderRec(node->left, out); // Левое
    out += node->data; // Корень
    out += ' ';
    inorderRec(node->right, out); // Правое
}

std::string BinaryTree::preorder() const {
    std::string result;
    preorderRec(root_, result);
    return result;
}
void BinaryTree::preorderRec(Node* node, std::string& out) const {
    if (!node) return;
    out += node->data; out += ' '; // Корень
    preorderRec(node->left, out); // Левое
    preorderRec(node->right, out); // Правое
}

std::string BinaryTree::postorder() const {
    std::string result;
    postorderRec(root_, result);
    return result;
}
void BinaryTree::postorderRec(Node* node, std::string& out) const {
    if (!node) return;
    postorderRec(node->left, out); // Левое
    postorderRec(node->right, out); // Правое
    out += node->data; out += ' '; // Корень
}

// Текстовые представления дерева
std::string BinaryTree::printHorizontal() const {
    std::ostringstream oss;
    std::function<void(Node*, int)> print = [&](Node* p, int level) {
        if (!p) return;
        print(p->right, level + 1); // Сначала правое (будет сверху)
        oss << std::string(level * 4, ' ') << p->data << "\n"; // Узел с отступом
        print(p->left, level + 1); // Затем левое (снизу)
    };
    print(root_, 0);
    return oss.str();
}

std::string BinaryTree::printVertical() const {
    if (!root_) return "Дерево пустое.\n";
    std::ostringstream oss;
    std::queue<Node*> q;
    q.push(root_);
    while (!q.empty()) {
        size_t sz = q.size();
        for (size_t i = 0; i < sz; ++i) {
            Node* node = q.front(); q.pop();
            if (node) {
                oss << node->data << ' '; // Выводим узел
                q.push(node->left); // Планируем детей
                q.push(node->right);
            } else {
                oss << "  "; // Пустое место
            }
        }
        oss << '\n'; // Переход на новый уровень
    }
    return oss.str();
}

// Вспомогательные функции для обхода и очистки
void BinaryTree::storeInorder(Node* node, std::vector<char>& arr) const {
    if (!node) return;
    storeInorder(node->left, arr);
    arr.push_back(node->data); // Сохраняем данные
    storeInorder(node->right, arr);
}

void BinaryTree::deleteRec(Node* node) {
    if (!node) return;
    deleteRec(node->left); // Удаляем левое поддерево
    deleteRec(node->right); // Удаляем правое
    delete node; // Удаляем сам узел
}

// Геометрия для графической визуализации
int BinaryTree::getHeight(Node* node) const {
    if (!node) return 0;
    return 1 + std::max(getHeight(node->left), getHeight(node->right)); // Высота от потомков
}

int BinaryTree::getSubtreeWidth(Node* node) const {
    if (!node) return 0;
    return std::max(60, 30 * static_cast<int>(std::log2(getHeight(node) + 1))); // ширина
}

void BinaryTree::layoutRec(Node* node, int x, int y, int hGap,
                           std::vector<std::tuple<Node*, int, int>>& layout) const {
    if (!node) return;
    layout.emplace_back(node, x, y); // Запоминаем координаты узла
    int childHGap = std::max(40, hGap / 2); // для детей
    layoutRec(node->left,  x - hGap, y + 80, childHGap, layout); // Левое поддерево
    layoutRec(node->right, x + hGap, y + 80, childHGap, layout); // Правое
}

std::vector<std::tuple<Node*, int, int>> BinaryTree::layoutTree() const {
    std::vector<std::tuple<Node*, int, int>> layout;
    if (!root_) return layout;
    int height = getHeight(root_);
    int baseHGap = 60 * height; // Начальный отступ от корня
    layoutRec(root_, 0, 0, baseHGap, layout);
    return layout;
}

// Создание вырожденного дерева ("бамбук")
void BinaryTree::buildSpindly(const std::string& s) {
    clear();
    if (s.empty()) return;
    root_ = new Node(s[0]); // Первый символ – корень
    Node* cur = root_;
    for (size_t i = 1; i < s.size(); ++i) {
        cur->right = new Node(s[i]); // Каждый следующий – правый ребёнок
        cur = cur->right;
    }
    // isBST_ остаётся false
}

// Балансировка произвольного дерева (без сортировки, по inorder-порядку)
void BinaryTree::balanceTree() {
    if (!root_) return;
    std::vector<char> arr;
    storeInorder(root_, arr); // Получаем inorder-последовательность
    Node* newRoot = buildBalancedFromVector(arr, 0, static_cast<int>(arr.size()) - 1);
    deleteRec(root_);
    root_ = newRoot; // Замена старого дерева
}

Node* BinaryTree::buildBalancedFromVector(const std::vector<char>& arr, int start, int end) {
    if (start > end) return nullptr;
    int mid = start + (end - start) / 2; // Середина для баланса
    Node* node = new Node(arr[mid]);
    node->left  = buildBalancedFromVector(arr, start, mid - 1);
    node->right = buildBalancedFromVector(arr, mid + 1, end);
    return node;
}

// Ручная вставка и удаление
bool BinaryTree::insertNode(char parentKey, char key, bool asLeftChild) {
    Node* parent = findNode(root_, parentKey); // Ищем родительский узел
    if (!parent) return false;
    if (asLeftChild) {
        if (parent->left) return false; // Место занято
        parent->left = new Node(key);
    } else {
        if (parent->right) return false;
        parent->right = new Node(key);
    }
    return true;
}

bool BinaryTree::deleteNode(char key) {
    auto [node, parent] = findNodeAndParent(root_, nullptr, key); // Ищем узел и его родителя
    if (!node) return false;
    if (parent) {
        if (parent->left == node) parent->left = nullptr; // Удаляем связь у родителя
        else if (parent->right == node) parent->right = nullptr;
    } else {
        root_ = nullptr; // Удаляемый узел – корень
    }
    deleteRec(node); // Рекурсивно удаляем всё поддерево
    return true;
}

Node* BinaryTree::findNode(Node* node, char key) const {
    if (!node) return nullptr;
    if (node->data == key) return node; // Нашли
    Node* leftRes = findNode(node->left, key); // Ищем в левом
    if (leftRes) return leftRes;
    return findNode(node->right, key); // Ищем в правом
}

std::pair<Node*, Node*> BinaryTree::findNodeAndParent(Node* node, Node* parent, char key) const {
    if (!node) return {nullptr, nullptr};
    if (node->data == key) return {node, parent}; // Возвращаем узел и его родителя
    auto left = findNodeAndParent(node->left, node, key);
    if (left.first) return left;
    return findNodeAndParent(node->right, node, key);
}

// Обходы, возвращающие вектор указателей (для пошаговой визуализации)
void BinaryTree::collectInorder(Node* node, std::vector<Node*>& vec) const {
    if (!node) return;
    collectInorder(node->left, vec);
    vec.push_back(node); // Добавляем после левого
    collectInorder(node->right, vec);
}

void BinaryTree::collectPreorder(Node* node, std::vector<Node*>& vec) const {
    if (!node) return;
    vec.push_back(node); // Корень первым
    collectPreorder(node->left, vec);
    collectPreorder(node->right, vec);
}

void BinaryTree::collectPostorder(Node* node, std::vector<Node*>& vec) const {
    if (!node) return;
    collectPostorder(node->left, vec);
    collectPostorder(node->right, vec);
    vec.push_back(node); // Корень последним
}

std::vector<Node*> BinaryTree::inorderTraversal() const {
    std::vector<Node*> result;
    collectInorder(root_, result);
    return result;
}

std::vector<Node*> BinaryTree::preorderTraversal() const {
    std::vector<Node*> result;
    collectPreorder(root_, result);
    return result;
}

std::vector<Node*> BinaryTree::postorderTraversal() const {
    std::vector<Node*> result;
    collectPostorder(root_, result);
    return result;
}

// Пошаговый поиск в BST (возвращает маршрут от корня до цели)
void BinaryTree::searchBSTStepsRec(Node* node, char key, std::vector<Node*>& steps) const {
    if (!node) return;
    steps.push_back(node); // Запоминаем текущий узел
    if (key == node->data) return; // Достигли цели
    if (key < node->data)
        searchBSTStepsRec(node->left, key, steps); // Идём влево
    else
        searchBSTStepsRec(node->right, key, steps); // Идём вправо
}

std::vector<Node*> BinaryTree::searchBSTSteps(char key) const {
    std::vector<Node*> steps;
    searchBSTStepsRec(root_, key, steps);
    return steps;
}

// Пошаговый подсчёт (preorder) для визуализации
void BinaryTree::countKeyStepsRec(Node* node, char key, std::vector<Node*>& steps) const {
    if (!node) return;
    steps.push_back(node); // Посещаем узел (preorder)
    countKeyStepsRec(node->left, key, steps);
    countKeyStepsRec(node->right, key, steps);
}

std::vector<Node*> BinaryTree::countKeySteps(char key) const {
    std::vector<Node*> steps;
    countKeyStepsRec(root_, key, steps);
    return steps;
}







