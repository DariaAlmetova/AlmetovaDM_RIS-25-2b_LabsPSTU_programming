#include <QtMath>

EdgeItem::EdgeItem(VertexItem *from, VertexItem *to, int weight,
                   QGraphicsItem *parent)
    : QGraphicsItem(parent), m_from(from), m_to(to), m_weight(weight)
{
    setFlag(QGraphicsItem::ItemIsSelectable); // позволяет выделять ребро мышью
    m_pen = QPen(Qt::black, 1.5); // стандартная чёрная линия
    setZValue(0); // рёбра рисуются под вершинами (у вершин z=1)
    updatePosition(); // первичный расчёт геометрии
}

int EdgeItem::fromIdx() const { return m_from->index(); } // индекс вершины-начала
int EdgeItem::toIdx() const { return m_to->index(); } // индекс вершины-конца
int EdgeItem::weight() const { return m_weight; } // вес (стоимость) ребра

void EdgeItem::setWeight(int w) {
    m_weight = w; // обновляем вес
    update(); // запрашиваем перерисовку (метка изменится)
}

void EdgeItem::updatePosition() {
    prepareGeometryChange(); // уведомляем сцену о возможном изменении геометрии
    update(); // перерисовываем линию с новыми координатами вершин
}

void EdgeItem::setColor(const QColor &color, int width) {
    m_pen.setColor(color); // задаём цвет
    m_pen.setWidth(width); // и толщину линии
    update(); // перерисовываем
}

void EdgeItem::resetColor() {
    m_pen.setColor(Qt::black); // возвращаем чёрный цвет
    m_pen.setWidth(1.5); // стандартную толщину
    update();
}

void EdgeItem::setHighlight(bool on) {
    if (on)
        setColor(Qt::red, 3); // красная жирная подсветка
    else
        resetColor(); // сброс к обычному виду
}

void EdgeItem::updateIndices() {} // индексы вершин обновляет сцена, здесь ничего делать не нужно

QRectF EdgeItem::boundingRect() const {
    QPointF p1 = m_from->pos();
    QPointF p2 = m_to->pos();
    qreal extra = VertexItem::RADIUS + 5; // небольшой запас для толщины линии
    return QRectF(p1, p2).normalized().adjusted(-extra, -extra, extra, extra);
}

void EdgeItem::paint(QPainter *painter, const QStyleOptionGraphicsItem *, QWidget *) {
    QPointF p1 = m_from->pos(); // центр первой вершины
    QPointF p2 = m_to->pos(); // центр второй вершины

    // направление и расстояние между центрами
    QPointF dir = p2 - p1;
    qreal len = qSqrt(dir.x()*dir.x() + dir.y()*dir.y());
    if (len < 1.0) return; // вершины слишком близко — не рисуем

    QPointF unit = dir / len; // единичный вектор направления
    qreal r = VertexItem::RADIUS; // радиус кругов

    // отступаем от центров на радиус, чтобы линия упиралась в край кружков
    QPointF start = p1 + unit * r;
    QPointF end   = p2 - unit * r;

    // рисуем линию
    painter->setPen(m_pen);
    painter->drawLine(start, end);

    // рисуем вес ребра красным жирным шрифтом около середины линии
    QPointF mid = (p1 + p2) / 2.0;
    painter->setPen(Qt::red);
    painter->setFont(QFont("Arial", 10, QFont::Bold));
    painter->drawText(mid + QPointF(5, -5), QString::number(m_weight));
}







