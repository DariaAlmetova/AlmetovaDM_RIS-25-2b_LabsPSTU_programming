VertexItem::VertexItem(int index, const QString &name, const QPointF &pos,
                       GraphScene *scene, QGraphicsItem *parent)
    : QGraphicsEllipseItem(-RADIUS, -RADIUS, 2*RADIUS, 2*RADIUS, parent), // эллипс размером 2*RADIUS
    m_index(index), m_name(name), m_scene(scene)
{
    setPos(pos); // устанавливаем позицию на сцене
    setFlag(QGraphicsItem::ItemIsMovable); // разрешаем перетаскивание
    setFlag(QGraphicsItem::ItemIsSelectable); // разрешаем выделение
    setFlag(QGraphicsItem::ItemSendsGeometryChanges); // уведомления об изменении позиции
    setBrush(QColor(200, 230, 255)); // светло-голубая заливка
    setPen(QPen(Qt::blue, 2.5)); // синяя обводка
    setZValue(1); // вершины отрисовываются поверх рёбер

    m_label = new QGraphicsSimpleTextItem(m_name, this); // текст внутри круга
    m_label->setFont(QFont("Arial", 12, QFont::Bold)); // жирный шрифт
    m_label->setBrush(Qt::black); // чёрный цвет текста
    updateLabelPosition(); // центрируем подпись
}

int VertexItem::index() const { return m_index; }
void VertexItem::setIndex(int idx) {
    m_index = idx;
    // имя остаётся прежним
}

QString VertexItem::name() const { return m_name; }

void VertexItem::setHighlight(bool on) {
    m_highlight = on;
    // при подсветке — красная обводка, иначе синяя
    setPen(on ? QPen(Qt::red, 3.5) : QPen(Qt::blue, 2.5));
}

QVariant VertexItem::itemChange(GraphicsItemChange change, const QVariant &value) {
    if (change == ItemPositionHasChanged) {
        // когда вершину перетащили, сообщаем сцене обновить связанные рёбра
        if (m_scene)
            m_scene->vertexMoved(m_index, value.toPointF());
    }
    return QGraphicsEllipseItem::itemChange(change, value);
}

void VertexItem::updateLabelPosition() {
    // центрируем текст внутри круга
    QRectF textRect = m_label->boundingRect();
    m_label->setPos(-textRect.width()/2, -textRect.height()/2);
}
