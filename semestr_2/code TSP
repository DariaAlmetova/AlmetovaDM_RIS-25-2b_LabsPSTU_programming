// переключение режима
void GraphScene::setMode(Mode mode) {
    m_mode = mode;
    m_edgeSource = nullptr; // сбрасываем начальную вершину
    m_drawingEdge = false; // прекращаем процесс рисования ребра
}

GraphScene::Mode GraphScene::mode() const { return m_mode; }

// создание вершины
VertexItem* GraphScene::addVertex(const QPointF &pos, const QString &name) {
    int idx = m_vertices.size(); // индекс новой вершины
    auto *v = new VertexItem(idx, name, pos, this); // создаём графический элемент
    addItem(v); // добавляем на сцену
    m_vertices.append(v); // запоминаем в списке
    emit graphModified(); // оповещаем об изменении графа
    return v;
}

// создание ребра
EdgeItem* GraphScene::addEdge(int fromIdx, int toIdx, int weight) {
    if (fromIdx == toIdx) return nullptr; // петли не допускаются

    // проверяем, нет ли уже такого ребра (в любом направлении)
    for (auto *e : m_edges) {
        if ((e->fromIdx() == fromIdx && e->toIdx() == toIdx) ||
            (e->fromIdx() == toIdx && e->toIdx() == fromIdx))
            return nullptr;
    }

    VertexItem *v1 = m_vertices[fromIdx];
    VertexItem *v2 = m_vertices[toIdx];
    auto *e = new EdgeItem(v1, v2, weight); // создаём ребро
    addItem(e);
    m_edges.append(e);
    emit graphModified();
    return e;
}

// удаление выделенных элементов
void GraphScene::removeSelected() {
    QList<QGraphicsItem*> selected = selectedItems();
    for (auto *item : selected) {
        if (auto *v = dynamic_cast<VertexItem*>(item)) {
            // сначала удаляем все рёбра, связанные с этой вершиной
            QMutableVectorIterator<EdgeItem*> it(m_edges);
            while (it.hasNext()) {
                EdgeItem *e = it.next();
                if (e->fromIdx() == v->index() || e->toIdx() == v->index()) {
                    removeItem(e);
                    delete e;
                    it.remove();
                }
            }
            removeItem(v);
            m_vertices.removeOne(v);
            delete v;
        } else if (auto *e = dynamic_cast<EdgeItem*>(item)) {
            removeItem(e);
            m_edges.removeOne(e);
            delete e;
        }
    }

    // перенумеровываем оставшиеся вершины (индексы сдвигаются)
    for (int i = 0; i < m_vertices.size(); ++i)
        m_vertices[i]->setIndex(i);
    for (auto *e : m_edges)
        e->updateIndices(); // заставляет рёбра обновить ссылки
    emit graphModified();
}

// полная очистка сцены
void GraphScene::clearAll() {
    for (auto *e : m_edges) { removeItem(e); delete e; }
    for (auto *v : m_vertices) { removeItem(v); delete v; }
    m_edges.clear();
    m_vertices.clear();
    emit graphModified();
}

// сброс цветов всех рёбер к обычному (чёрному)
void GraphScene::resetEdgeColors() {
    for (auto *e : m_edges)
        e->resetColor();
}

// построение матрицы смежности для алгоритма
std::vector<std::vector<int>> GraphScene::toMatrix() const {
    int n = m_vertices.size();
    std::vector<std::vector<int>> mat(n, std::vector<int>(n, TspSolver::INF));
    for (int i = 0; i < n; ++i) mat[i][i] = TspSolver::INF; // диагональ — бесконечность (петли запрещены)

    for (auto *e : m_edges) {
        int i = e->fromIdx();
        int j = e->toIdx();
        mat[i][j] = e->weight(); // граф двунаправленный
        mat[j][i] = e->weight();
    }
    return mat;
}

// поиск ребра по двум вершинам
EdgeItem* GraphScene::findEdge(int from, int to) const {
    for (auto *e : m_edges)
        if ((e->fromIdx() == from && e->toIdx() == to) ||
            (e->fromIdx() == to && e->toIdx() == from))
            return e;
    return nullptr;
}

// вызывается VertexItem при перетаскивании
void GraphScene::vertexMoved(int idx, QPointF /*newPos*/) {
    for (auto *e : m_edges) {
        if (e->fromIdx() == idx || e->toIdx() == idx)
            e->updatePosition(); // перерисовать ребро с новыми координатами
    }
    emit graphModified();
}

// обработка нажатий мыши в зависимости от режима
void GraphScene::mousePressEvent(QGraphicsSceneMouseEvent *event) {
    if (m_mode == AddVertex) {
        // запрос имени вершины у пользователя
        bool ok;
        QString name = QInputDialog::getText(nullptr, "Имя вершины",
                                             "Введите имя:", QLineEdit::Normal,
                                             QString::number(m_vertices.size()), &ok);
        if (ok && !name.isEmpty())
            addVertex(event->scenePos(), name);
        event->accept();
        return;
    }

    if (m_mode == AddEdge) {
        QGraphicsItem *item = itemAt(event->scenePos(), QTransform());
        if (auto *v = dynamic_cast<VertexItem*>(item)) {
            if (!m_edgeSource) {
                // первая выбранная вершина – начало ребра
                m_edgeSource = v;
                v->setBrush(Qt::yellow); // подсветка выбранной вершины
                m_drawingEdge = true;
            } else {
                // вторая вершина – завершаем создание ребра
                if (v != m_edgeSource) {
                    bool ok;
                    int weight = QInputDialog::getInt(nullptr, "Вес ребра",
                                                      "Введите вес:", 1, 1, 10000, 1, &ok);
                    if (ok) addEdge(m_edgeSource->index(), v->index(), weight);
                }
                m_edgeSource->setBrush(QColor(200,230,255)); // возвращаем обычный цвет
                m_edgeSource = nullptr;
                m_drawingEdge = false;
            }
        }
        event->accept();
        return;
    }

    // в режиме Select – стандартное поведение (перетаскивание, выделение)
    QGraphicsScene::mousePressEvent(event);
}








#include <QApplication>
#include <QCommandLineParser>
#include <QTextStream>
#include "mainwindow.h"
#include "tspsolver.h"

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);
    QApplication::setApplicationName("TSP Solver");
    QApplication::setApplicationVersion("1.0");

    // парсер аргументов командной строки
    QCommandLineParser parser;
    parser.setApplicationDescription("TSP Branch and Bound Solver");
    parser.addHelpOption();
    parser.addVersionOption();
    QCommandLineOption consoleOption("console", "Run in console mode (read matrix from stdin)");
    parser.addOption(consoleOption);
    parser.process(app);

    // консольный режим (запуск с флагом --console)
    if (parser.isSet(consoleOption)) {
        QTextStream in(stdin);
        QTextStream out(stdout);

        int n;
        in >> n; // число вершин
        if (n <= 0) {
            out << "Invalid number of vertices" << Qt::endl;
            return 1;
        }

        // чтение матрицы смежности (INF обозначается отрицательным числом)
        std::vector<std::vector<int>> mat(n, std::vector<int>(n, TspSolver::INF));
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                int val;
                in >> val;
                if (val < 0) mat[i][j] = TspSolver::INF;
                else mat[i][j] = val;
            }
        }

        // запуск решения
        TspSolver solver(mat);
        solver.setFindAll(false); // ищем только первый оптимальный маршрут
        auto [cost, allPaths] = solver.solve();

        if (allPaths.empty()) {
            out << "No solution" << Qt::endl;
        } else {
            const auto &path = allPaths.front();
            out << "Optimal cost: " << cost << Qt::endl;
            out << "Route: ";
            for (int v : path) out << v << " ";
            out << Qt::endl;
        }
        return 0; // завершение без запуска GUI
    }

    // графический режим (обычный запуск)
    MainWindow w;
    w.show();
    return app.exec();
}









