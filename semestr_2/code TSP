#ifndef TSPSOLVER_H
#define TSPSOLVER_H

#include <vector>
#include <utility>
#include <queue>
#include <functional>
#include <string>

class TspSolver
{
public:
    static constexpr int INF = 1'000'000'000; // "бесконечность" для отсутствующих рёбер

    // типы шагов для пошаговой демонстрации
    enum class StepType { Consider, Include, Exclude };

    // описание одного шага алгоритма (для визуализации)
    struct Step {
        int level; // глубина узла в дереве решений
        int lowerBound; // нижняя граница стоимости в этом узле
        int from, to; // исходные вершины рассматриваемого ребра
        StepType type; // что происходит с ребром
        // список всех нулевых клеток текущей матрицы (исходные вершины, штраф)
        std::vector<std::pair<std::pair<int,int>, int>> zeros;
    };

    // узел дерева ветвлений
    struct Node {
        std::vector<std::vector<int>> matrix; // текущая приведённая матрица
        std::vector<int> rowVertices; // rowVertices[i] -> исходная вершина
        std::vector<int> colVertices; // colVertices[j] -> исходная вершина
        int lowerBound = 0; // нижняя граница стоимости
        std::vector<std::pair<int,int>> edges; // уже включённые рёбра (в исходных номерах)
        int level = 0; // глубина в дереве
        bool operator>(const Node &other) const { return lowerBound > other.lowerBound; }
    };

    TspSolver() : m_n(0), m_rootLowerBound(0) {}
    explicit TspSolver(const std::vector<std::vector<int>> &costMatrix);

    void setFindAll(bool findAll) { m_findAll = findAll; } // true – искать все оптимальные маршруты

    // запускает решение, возвращает (стоимость, список маршрутов)
    std::pair<int, std::vector<std::vector<int>>> solve();

    int getRootLowerBound() const { return m_rootLowerBound; } // нижняя граница корня (после редукции)

    const std::vector<Step>& steps() const { return m_steps; } // доступ к шагам (для пошагового режима)

private:
    // приведение матрицы: вычитание минимумов строк и столбцов, возвращает сумму вычетов
    int reduceMatrix(std::vector<std::vector<int>> &mat);

    // выбор нуля с максимальным штрафом
    std::pair<int,int> selectBestZero(const std::vector<std::vector<int>> &mat);

    // восстановление гамильтонова цикла по списку включённых рёбер
    std::vector<int> buildPath(const std::vector<std::pair<int,int>> &edges) const;

    // сбор всех нулей текущей матрицы узла с вычислением штрафа
    std::vector<std::pair<std::pair<int,int>, int>> getAllZeros(const Node &node) const;

    std::vector<std::vector<int>> m_original; // исходная матрица стоимости
    int m_n; // число вершин
    int m_rootLowerBound; // нижняя граница корневого узла
    bool m_findAll = false; // искать ли все оптимальные решения
    std::vector<Step> m_steps; // сохранённые шаги для пошаговой демонстрации
};

#endif







