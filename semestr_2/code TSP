void MatrixDialog::onSizeChanged(int n) {
    // изменяем размер таблицы
    m_table->setRowCount(n);
    m_table->setColumnCount(n);

    // обновляем заголовки строк и столбцов (0..n-1)
    QStringList headers;
    for (int i = 0; i < n; ++i) headers << QString::number(i);
    m_table->setHorizontalHeaderLabels(headers);
    m_table->setVerticalHeaderLabels(headers);

    // для всех ячеек: если ячейки ещё нет – создаём, диагональ заполняем "INF"
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            auto *item = m_table->item(i, j);
            if (!item) {
                item = new QTableWidgetItem();
                m_table->setItem(i, j, item);
            }
            if (i == j) item->setText("INF");
        }
    }
}

std::pair<std::vector<std::vector<int>>, QVector<QPointF>> MatrixDialog::getData() const {
    int n = m_sizeSpin->value();
    std::vector<std::vector<int>> mat(n, std::vector<int>(n, TspSolver::INF));

    // считываем значения из таблицы
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            QString text = m_table->item(i, j)->text().trimmed().toUpper();
            if (text == "INF" || text.isEmpty())
                mat[i][j] = TspSolver::INF; // отсутствие ребра
            else
                mat[i][j] = text.toInt(); // вес ребра
        }
    }

    return {mat, {}}; // позиции вершин не заданы – сцена распределит их случайно
}






#include "tspsolver.h"
#include <algorithm>
#include <limits>

// поиск минимального элемента в строке r (игнорируя бесконечности)
static int rowMin(const std::vector<std::vector<int>> &mat, int r) {
    int best = TspSolver::INF;
    for (int x : mat[r]) best = std::min(best, x);
    return best;
}

// поиск минимального элемента в столбце c
static int colMin(const std::vector<std::vector<int>> &mat, int c) {
    int best = TspSolver::INF;
    for (const auto &row : mat) best = std::min(best, row[c]);
    return best;
}

TspSolver::TspSolver(const std::vector<std::vector<int>> &costMatrix)
    : m_original(costMatrix), m_n(static_cast<int>(costMatrix.size()))
{
    m_rootLowerBound = 0;
}

// приведение матрицы: вычитаем минимумы строк и столбцов, возвращаем сумму вычетов
int TspSolver::reduceMatrix(std::vector<std::vector<int>> &mat) {
    int n = static_cast<int>(mat.size());
    int total = 0;

    // редукция строк
    for (int i = 0; i < n; ++i) {
        int mn = rowMin(mat, i);
        if (mn == INF) continue; // вся строка – INF, недопустимый узел
        if (mn > 0) {
            for (int j = 0; j < n; ++j)
                if (mat[i][j] != INF) mat[i][j] -= mn;
            total += mn;
        }
    }
    // редукция столбцов
    for (int j = 0; j < n; ++j) {
        int mn = colMin(mat, j);
        if (mn == INF) continue;
        if (mn > 0) {
            for (int i = 0; i < n; ++i)
                if (mat[i][j] != INF) mat[i][j] -= mn;
            total += mn;
        }
    }
    return total;
}

// выбор нулевой клетки с максимальным штрафом
std::pair<int,int> TspSolver::selectBestZero(const std::vector<std::vector<int>> &mat) {
    int n = static_cast<int>(mat.size());
    int bestPenalty = -1;
    std::pair<int,int> bestPos = {-1, -1};

    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            if (mat[i][j] != 0) continue;

            // штраф = мин. в строке (кроме j) + мин. в столбце (кроме i)
            int rmin = INF, cmin = INF;
            for (int k = 0; k < n; ++k) if (k != j) rmin = std::min(rmin, mat[i][k]);
            for (int k = 0; k < n; ++k) if (k != i) cmin = std::min(cmin, mat[k][j]);
            int penalty = (rmin == INF ? 0 : rmin) + (cmin == INF ? 0 : cmin);

            if (penalty > bestPenalty) {
                bestPenalty = penalty;
                bestPos = {i, j};
            }
        }
    }
    return bestPos;
}

// получить список всех нулей текущей матрицы с исходными вершинами и штрафами
std::vector<std::pair<std::pair<int,int>, int>> TspSolver::getAllZeros(const Node &node) const {
    std::vector<std::pair<std::pair<int,int>, int>> result;
    int n = static_cast<int>(node.matrix.size());
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            if (node.matrix[i][j] != 0) continue;

            int rmin = INF, cmin = INF;
            for (int k = 0; k < n; ++k) if (k != j) rmin = std::min(rmin, node.matrix[i][k]);
            for (int k = 0; k < n; ++k) if (k != i) cmin = std::min(cmin, node.matrix[k][j]);
            int penalty = (rmin == INF ? 0 : rmin) + (cmin == INF ? 0 : cmin);

            // восстанавливаем исходные номера вершин по rowVertices/colVertices
            int origFrom = node.rowVertices[i];
            int origTo   = node.colVertices[j];
            result.push_back({{origFrom, origTo}, penalty});
        }
    }
    return result;
}

// восстановление гамильтонова цикла по списку включённых рёбер
std::vector<int> TspSolver::buildPath(const std::vector<std::pair<int,int>> &edges) const {
    std::vector<std::vector<int>> adj(m_n);
    for (const auto &e : edges) {
        adj[e.first].push_back(e.second);
        adj[e.second].push_back(e.first);
    }

    std::vector<int> path;
    int start = 0;
    while (start < m_n && adj[start].empty()) ++start; // первая вершина с рёбрами
    if (start == m_n) return path; // нет рёбер (не должно случиться)

    int cur = start, prev = -1;
    for (int i = 0; i < m_n; ++i) {
        path.push_back(cur);
        if (i == m_n - 1) break;
        bool moved = false;
        for (int nxt : adj[cur]) {
            if (nxt != prev) {
                prev = cur;
                cur = nxt;
                moved = true;
                break;
            }
        }
        if (!moved) return {}; // не удалось продолжить – ошибка в данных
    }
    return path;
}

// основная процедура – поиск оптимального маршрута методом ветвей и границ
std::pair<int, std::vector<std::vector<int>>> TspSolver::solve() {
    std::vector<std::vector<int>> bestPaths;
    int bestCost = INF;
    m_steps.clear();

    // корневой узел: полная матрица
    Node root;
    root.matrix = m_original;
    for (int i = 0; i < m_n; ++i) root.matrix[i][i] = INF; // запрет петель
    root.rowVertices.resize(m_n);
    root.colVertices.resize(m_n);
    for (int i = 0; i < m_n; ++i) {
        root.rowVertices[i] = i;
        root.colVertices[i] = i;
    }
    root.lowerBound = reduceMatrix(root.matrix);
    m_rootLowerBound = root.lowerBound;
    root.level = 0;

    // первый шаг для демонстрации: все нули исходной приведённой матрицы
    {
        Step startStep;
        startStep.level = 0;
        startStep.lowerBound = root.lowerBound;
        startStep.from = -1;
        startStep.to = -1;
        startStep.type = StepType::Consider;
        startStep.zeros = getAllZeros(root);
        m_steps.push_back(startStep);
    }

    // очередь с приоритетом по нижней границе (меньше – лучше)
    std::priority_queue<Node, std::vector<Node>, std::greater<Node>> pq;
    pq.push(root);

    while (!pq.empty()) {
        Node cur = pq.top(); pq.pop();

        if (cur.lowerBound > bestCost) continue; // отсечение бесперспективных узлов

        int size = static_cast<int>(cur.matrix.size());

        // матрица 1×1 – завершаем цикл добавлением единственного ребра
        if (size == 1) {
            if (cur.matrix[0][0] == INF) continue;
            int origFrom = cur.rowVertices[0];
            int origTo   = cur.colVertices[0];
            Node finalNode = cur;
            finalNode.edges.emplace_back(origFrom, origTo);
            int totalCost = cur.lowerBound + cur.matrix[0][0];
            if (totalCost < bestCost) {
                bestCost = totalCost;
                bestPaths.clear();
                bestPaths.push_back(buildPath(finalNode.edges));
                if (!m_findAll) break;
            } else if (totalCost == bestCost && m_findAll) {
                bestPaths.push_back(buildPath(finalNode.edges));
            }
            continue;
        }

        // выбираем нулевую клетку с максимальным штрафом
        auto [r, c] = selectBestZero(cur.matrix);
        if (r == -1) continue;   // нет нулей – ветвь тупиковая

        int origFrom = cur.rowVertices[r];
        int origTo   = cur.colVertices[c];

        // сохраняем шаг "Рассматриваем" для пошаговой демонстрации
        {
            Step considerStep;
            considerStep.level = cur.level;
            considerStep.lowerBound = cur.lowerBound;
            considerStep.from = origFrom;
            considerStep.to = origTo;
            considerStep.type = StepType::Consider;
            considerStep.zeros = getAllZeros(cur);
            m_steps.push_back(considerStep);
        }

        // ветвь «Включить ребро»
        Node incNode = cur;
        incNode.edges.emplace_back(origFrom, origTo);
        std::vector<std::vector<int>> newMat(size-1, std::vector<int>(size-1));
        std::vector<int> newRowVert, newColVert;

        // удаляем строку r и столбец c из матрицы и списков вершин
        for (int i = 0; i < size; ++i) {
            if (i == r) continue;
            newRowVert.push_back(incNode.rowVertices[i]);
            std::vector<int> newRow;
            for (int j = 0; j < size; ++j) {
                if (j == c) continue;
                newRow.push_back(incNode.matrix[i][j]);
            }
            newMat[newRowVert.size()-1] = newRow;
        }
        for (int j = 0; j < size; ++j) {
            if (j == c) continue;
            newColVert.push_back(incNode.colVertices[j]);
        }
        incNode.matrix = std::move(newMat);
        incNode.rowVertices = std::move(newRowVert);
        incNode.colVertices = std::move(newColVert);

        // запрет обратного ребра (origTo, origFrom), если ещё присутствует
        for (int i = 0; i < size-1; ++i)
            for (int j = 0; j < size-1; ++j)
                if (incNode.rowVertices[i] == origTo && incNode.colVertices[j] == origFrom)
                    incNode.matrix[i][j] = INF;

        int addInc = reduceMatrix(incNode.matrix);
        incNode.lowerBound = cur.lowerBound + addInc;
        incNode.level = cur.level + 1;

        {
            Step incStep;
            incStep.level = incNode.level;
            incStep.lowerBound = incNode.lowerBound;
            incStep.from = origFrom;
            incStep.to = origTo;
            incStep.type = StepType::Include;
            m_steps.push_back(incStep);
        }
        if (incNode.lowerBound <= bestCost) pq.push(incNode);

        // ветвь «Запретить ребро»
        Node excNode = cur;
        excNode.matrix[r][c] = INF;
        int addExc = reduceMatrix(excNode.matrix);
        excNode.lowerBound = cur.lowerBound + addExc;
        excNode.level = cur.level + 1;

        {
            Step excStep;
            excStep.level = excNode.level;
            excStep.lowerBound = excNode.lowerBound;
            excStep.from = origFrom;
            excStep.to = origTo;
            excStep.type = StepType::Exclude;
            m_steps.push_back(excStep);
        }
        if (excNode.lowerBound <= bestCost) pq.push(excNode);
    }

    if (bestPaths.empty()) return {INF, {}};
    return {bestCost, bestPaths};
}





#include "vertexitem.h"
