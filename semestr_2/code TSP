void MainWindow::loadExample() { // загрузка примера (6 вершин)
    clearGraph();
    QVector<QPointF> positions = {
        QPointF(50, 50), QPointF(250, 50), QPointF(450, 150),
        QPointF(550, 400), QPointF(250, 500), QPointF(50, 350)
    };
    int n = 6;
    int mat[6][6] = {
        {TspSolver::INF, 2, 4, 7, TspSolver::INF, 3},
        {2, TspSolver::INF, 2, TspSolver::INF, 5, 3},
        {4, 2, TspSolver::INF, 3, 4, TspSolver::INF},
        {7, TspSolver::INF, 3, TspSolver::INF, 3, 5},
        {TspSolver::INF, 5, 4, 3, TspSolver::INF, 3},
        {3, 3, TspSolver::INF, 5, 3, TspSolver::INF}
    };
    for (int i = 0; i < n; ++i)
        m_scene->addVertex(positions[i], QString::number(i));
    for (int i = 0; i < n; ++i)
        for (int j = i+1; j < n; ++j)
            if (mat[i][j] != TspSolver::INF)
                m_scene->addEdge(i, j, mat[i][j]);
    m_statusLabel->setText("Загружен пример");
}

void MainWindow::importMatrix() { // импорт матрицы
    MatrixDialog dialog(this);
    if (dialog.exec() == QDialog::Accepted) {
        auto [mat, pos] = dialog.getData();
        clearGraph();
        int n = static_cast<int>(mat.size());
        if (pos.isEmpty())
            for (int i = 0; i < n; ++i)
                m_scene->addVertex(QPointF(rand() % 500 + 50, rand() % 400 + 50),
                                   QString::number(i));
        else
            for (int i = 0; i < n; ++i)
                m_scene->addVertex(pos[i], QString::number(i));
        for (int i = 0; i < n; ++i)
            for (int j = i+1; j < n; ++j)
                if (mat[i][j] != TspSolver::INF)
                    m_scene->addEdge(i, j, mat[i][j]);
        m_statusLabel->setText("Матрица импортирована");
    }
}

void MainWindow::exportMatrix() { // экспорт матрицы
    auto mat = m_scene->toMatrix();
    if (mat.empty()) {
        QMessageBox::warning(this, "Экспорт", "Граф пуст");
        return;
    }
    QString fileName = QFileDialog::getSaveFileName(this, "Сохранить матрицу", "",
                                                    "Text files (*.txt)");
    if (fileName.isEmpty()) return;
    QFile file(fileName);
    if (file.open(QIODevice::WriteOnly | QIODevice::Text)) {
        QTextStream out(&file);
        int n = static_cast<int>(mat.size());
        out << n << "\n";
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (mat[i][j] == TspSolver::INF) out << -1 << " ";
                else out << mat[i][j] << " ";
            }
            out << "\n";
        }
        m_statusLabel->setText("Матрица экспортирована");
    }
}

void MainWindow::generateRandomGraph() { // генерация случайного графа
    bool ok;
    int n = QInputDialog::getInt(this, "Случайный граф",
                                 "Количество вершин (4–15):", 6, 4, 15, 1, &ok);
    if (!ok) return;

    int minW = QInputDialog::getInt(this, "Веса", "Минимальный вес:", 1, 1, 100, 1, &ok);
    if (!ok) return;
    int maxW = QInputDialog::getInt(this, "Веса", "Максимальный вес:", 10, minW, 100, 1, &ok);
    if (!ok) return;

    int prob = QInputDialog::getInt(this, "Плотность", "Вероятность ребра (%):", 70, 10, 100, 1, &ok);
    if (!ok) return;

    std::vector<std::vector<int>> mat(n, std::vector<int>(n, TspSolver::INF));
    std::srand(std::time(nullptr));
    for (int i = 0; i < n; ++i) {
        for (int j = i+1; j < n; ++j) {
            if (std::rand() % 100 < prob) {
                int w = minW + std::rand() % (maxW - minW + 1);
                mat[i][j] = mat[j][i] = w;
            }
        }
    }

    clearGraph();
    for (int i = 0; i < n; ++i) {
        qreal x = 50 + std::rand() % 700;
        qreal y = 50 + std::rand() % 500;
        m_scene->addVertex(QPointF(x, y), QString::number(i));
    }
    for (int i = 0; i < n; ++i)
        for (int j = i+1; j < n; ++j)
            if (mat[i][j] != TspSolver::INF)
                m_scene->addEdge(i, j, mat[i][j]);

    m_statusLabel->setText(QString("Случайный граф из %1 вершин").arg(n));
}

// поиск оптимальных маршрутов
void MainWindow::findFirstOptimal() {
    auto mat = m_scene->toMatrix();
    if (mat.size() < 3) {
        QMessageBox::warning(this, "Ошибка", "Граф должен содержать хотя бы 3 вершины");
        return;
    }
    m_solver = TspSolver(mat);
    m_solver.setFindAll(false);
    auto [cost, paths] = m_solver.solve();
    m_optimalRoutes.clear();
    for (const auto &p : paths) m_optimalRoutes.push_back(p);
    m_treeWidget->clear();

    m_routeCombo->clear();
    m_routeCombo->setEnabled(false);
    m_prevRouteAction->setEnabled(false);
    m_nextRouteAction->setEnabled(false);

    if (m_optimalRoutes.empty()) {
        addTreeItem("Нет решения", -1, "Ошибка");
        m_statusLabel->setText("Нет решения");
        return;
    }
    m_currentRouteIndex = 0;
    addTreeItem(QString("H=%1").arg(m_solver.getRootLowerBound()), m_solver.getRootLowerBound(), "Корень");
    QString routeStr = routeToString(m_optimalRoutes[0]);
    addTreeItem(QString("Цикл: %1").arg(routeStr), cost, "Оптимум");
    m_statusLabel->setText(QString("Оптимум: стоимость %1, маршрут %2").arg(cost).arg(routeStr));
    updateRouteHighlight();
}

void MainWindow::findAllOptimal() {
    auto mat = m_scene->toMatrix();
    if (mat.size() < 3) {
        QMessageBox::warning(this, "Ошибка", "Граф должен содержать хотя бы 3 вершины");
        return;
    }
    m_solver = TspSolver(mat);
    m_solver.setFindAll(true);
    auto [cost, paths] = m_solver.solve();
    m_optimalRoutes.clear();
    for (const auto &p : paths) m_optimalRoutes.push_back(p);
    m_treeWidget->clear();

    if (m_optimalRoutes.empty()) {
        m_routeCombo->clear();
        m_routeCombo->setEnabled(false);
        m_prevRouteAction->setEnabled(false);
        m_nextRouteAction->setEnabled(false);
        addTreeItem("Нет решения", -1, "Ошибка");
        m_statusLabel->setText("Нет решения");
        return;
    }

    addTreeItem(QString("H=%1").arg(m_solver.getRootLowerBound()), m_solver.getRootLowerBound(), "Корень");
    for (int i = 0; i < (int)m_optimalRoutes.size(); ++i) {
        QString routeStr = routeToString(m_optimalRoutes[i]);
        addTreeItem(QString("Цикл %1: %2").arg(i+1).arg(routeStr), cost, "Оптимум");
    }

    rebuildRouteCombo();
    bool multiple = m_optimalRoutes.size() > 1;
    m_routeCombo->setEnabled(true);
    m_prevRouteAction->setEnabled(multiple);
    m_nextRouteAction->setEnabled(multiple);

    m_currentRouteIndex = 0;
    m_routeCombo->setCurrentIndex(0);
    updateRouteHighlight();

    m_statusLabel->setText(QString("Найдено %1 оптимальных маршрутов стоимостью %2. "
                                   "Переключайте через список или стрелки.")
                               .arg(m_optimalRoutes.size()).arg(cost));
}
// вспомогательные методы интерфейса
void MainWindow::rebuildRouteCombo() {
    m_routeCombo->blockSignals(true);
    m_routeCombo->clear();
    for (int i = 0; i < (int)m_optimalRoutes.size(); ++i) {
        QString routeStr = routeToString(m_optimalRoutes[i]);
        m_routeCombo->addItem(QString("Маршрут %1: %2").arg(i+1).arg(routeStr));
    }
    m_routeCombo->blockSignals(false);
}

void MainWindow::onRouteComboChanged(int index) {
    if (index < 0 || index >= (int)m_optimalRoutes.size()) return;
    if (index == m_currentRouteIndex) return;
    m_currentRouteIndex = index;
    updateRouteHighlight();
}

void MainWindow::onTreeItemClicked(QTreeWidgetItem *item, int /*column*/) {
    QString text = item->text(0);
    if (text.startsWith("Цикл ")) {
        QRegularExpression re("^Цикл (\\d+):");
        auto match = re.match(text);
        if (match.hasMatch()) {
            int cycleIndex = match.captured(1).toInt() - 1;
            if (cycleIndex >= 0 && cycleIndex < (int)m_optimalRoutes.size()) {
                m_currentRouteIndex = cycleIndex;
                m_routeCombo->setCurrentIndex(cycleIndex);
                updateRouteHighlight();
            }
        }
    }
}
// сброс цветов, подсветка рёбер текущего маршрута красным
void MainWindow::updateRouteHighlight() {
    if (m_currentRouteIndex < 0 || m_currentRouteIndex >= (int)m_optimalRoutes.size()) return;
    const auto &route = m_optimalRoutes[m_currentRouteIndex];
    m_scene->resetEdgeColors();
    for (auto *edge : m_scene->edges()) edge->setHighlight(false);
    int n = (int)route.size();
    for (int i = 0; i < n; ++i) {
        int from = route[i];
        int to = route[(i+1)%n];
        auto *edge = m_scene->findEdge(from, to);
        if (edge) edge->setHighlight(true);
    }
    m_statusLabel->setText(QString("Маршрут %1/%2: %3")
                               .arg(m_currentRouteIndex+1).arg(m_optimalRoutes.size())
                               .arg(routeToString(route)));
}

void MainWindow::previousRoute() {
    if (m_optimalRoutes.empty()) return;
    int total = (int)m_optimalRoutes.size();
    m_currentRouteIndex = (m_currentRouteIndex - 1 + total) % total;
    m_routeCombo->setCurrentIndex(m_currentRouteIndex);
    updateRouteHighlight();
}

void MainWindow::nextRoute() {
    if (m_optimalRoutes.empty()) return;
    int total = (int)m_optimalRoutes.size();
    m_currentRouteIndex = (m_currentRouteIndex + 1) % total;
    m_routeCombo->setCurrentIndex(m_currentRouteIndex);
    updateRouteHighlight();
}

QString MainWindow::routeToString(const std::vector<int> &route) { // превращает вектор индексов в строку вида "0-5-4-3-2-1-0"
    QStringList lst;
    for (int v : route) {
        if (v >= 0 && v < m_scene->vertices().size())
            lst << m_scene->vertices()[v]->name();
        else
            lst << QString::number(v);
    }
    return lst.join("-");
}

void MainWindow::addTreeItem(const QString &desc, int h, const QString &status) {
    auto *item = new QTreeWidgetItem(m_treeWidget);
    item->setText(0, desc);
    item->setText(1, h < 0 ? "" : QString::number(h));
    item->setText(2, status);
}

// пошаговый режим
void MainWindow::startStepByStep() {
    auto mat = m_scene->toMatrix();
    if (mat.size() < 3) {
        QMessageBox::warning(this, "Ошибка", "Граф должен содержать хотя бы 3 вершины");
        return;
    }
    m_solver = TspSolver(mat);
    m_solver.setFindAll(false);
    m_solver.solve();
    m_currentStep = 0;
    m_stepByStepActive = true;
    m_includedEdges.clear();
    m_currentConsiderEdge = {-1, -1};
    m_scene->resetEdgeColors();
    m_stopStepAction->setEnabled(true);
    m_stepAction->setEnabled(true);
    m_treeWidget->clear();
    addTreeItem("Пошаговый разбор", m_solver.getRootLowerBound(), "Старт");
    m_statusLabel->setText("Пошаговый режим. Нажмите «Шаг»");
}

void MainWindow::stepNext() {
    if (!m_stepByStepActive) return;
    const auto &steps = m_solver.steps();
    if (m_currentStep >= (int)steps.size()) {
        m_statusLabel->setText("Демонстрация завершена");
        stopStepByStep();
        return;
    }
    const TspSolver::Step &step = steps[m_currentStep];

    QString status;
    switch (step.type) {
    case TspSolver::StepType::Consider:
        m_currentConsiderEdge = {step.from, step.to};
        status = "Рассматривается";
        break;
    case TspSolver::StepType::Include:
        m_includedEdges.push_back({step.from, step.to});
        m_currentConsiderEdge = {-1, -1};
        status = "Включено";
        break;
    case TspSolver::StepType::Exclude:
        m_currentConsiderEdge = {-1, -1};
        status = "Исключено";
        break;
    }

    updateStepVisualization();

    QString actionText;
    switch (step.type) {
    case TspSolver::StepType::Consider:
        actionText = QString("Рассм. (%1,%2)").arg(step.from).arg(step.to);
        break;
    case TspSolver::StepType::Include:
        actionText = QString("Вкл. (%1,%2)").arg(step.from).arg(step.to);
        break;
    case TspSolver::StepType::Exclude:
        actionText = QString("Искл. (%1,%2)").arg(step.from).arg(step.to);
        break;
    }

    QTreeWidgetItem *item = new QTreeWidgetItem(m_treeWidget);
    item->setText(0, actionText);
    item->setText(1, QString::number(step.lowerBound));
    item->setText(2, status);
    m_treeWidget->addTopLevelItem(item);

    if (step.type == TspSolver::StepType::Consider && !step.zeros.empty()) {
        for (const auto &z : step.zeros) {
            int vFrom = z.first.first;
            int vTo   = z.first.second;
            int pen   = z.second;
            QString zeroDesc = QString("  Ноль (%1,%2): штраф %3")
                                   .arg(vFrom).arg(vTo).arg(pen);
            QTreeWidgetItem *zeroItem = new QTreeWidgetItem(item);
            zeroItem->setText(0, zeroDesc);
        }
        item->setExpanded(true);
    }

    m_treeWidget->scrollToBottom();
    m_statusLabel->setText(QString("Шаг %1: %2 (H=%3)")
                               .arg(m_currentStep).arg(actionText).arg(step.lowerBound));
    m_currentStep++;
}

void MainWindow::stopStepByStep() {
    m_stepByStepActive = false;
    m_stopStepAction->setEnabled(false);
    m_stepAction->setEnabled(false);
    m_currentStep = -1;
    m_statusLabel->setText("Пошаговый режим остановлен");
}

void MainWindow::updateStepVisualization() { // зелёные – включённые рёбра, жёлтое – рассматриваемое
    m_scene->resetEdgeColors();
    for (const auto &e : m_includedEdges) {
        EdgeItem *edge = m_scene->findEdge(e.first, e.second);
        if (edge) edge->setColor(Qt::green, 3);
    }
    if (m_currentConsiderEdge.first != -1) {
        EdgeItem *edge = m_scene->findEdge(m_currentConsiderEdge.first,
                                           m_currentConsiderEdge.second);
        if (edge) edge->setColor(Qt::yellow, 3);
    }
}







