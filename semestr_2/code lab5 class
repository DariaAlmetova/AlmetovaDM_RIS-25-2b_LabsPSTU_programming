#include "Object.h"
#include "Pair.h"
#include "Rational.h"
#include "Vector.h"
#include <iostream>
using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");

    // создаём вектор на 3 элемента
    Vector v(3); // вызывается конструктор Vector(3) — выделяется массив из 3 указателей

    // создаём объекты
    Pair p(5, 3); // конструктор Pair(int,int) создаёт пару (5,3)
    Rational r1(2, 3); // дробь 2/3
    Rational r2(6, 8); // дробь 6/8 (будет сокращена до 3/4)

    // добавляем указатели в вектор
    v.Add(&p); // добавляем адрес объекта p (тип Pair) — неявное преобразование Pair* -> Object*
    v.Add(&r1); // добавляем адрес r1 (Rational* -> Object*)
    v.Add(&r2); // добавляем адрес r2

    // выводим все объекты через полиморфный оператор <<
    cout << "Содержимое вектора:" << endl;
    cout << v; // вызов operator<<(cout, v) — внутри цикл, для каждого указателя вызывается Show()

    // демонстрация работы методов
    cout << "\nДемонстрация операций с дробями:" << endl;
    cout << r1 << " + " << r2 << " = " << (r1 + r2) << endl;
    cout << r1 << " - " << r2 << " = " << (r1 - r2) << endl;
    cout << r1 << " * " << r2 << " = " << (r1 * r2) << endl;

    cout << "\nДемонстрация вычитания пар:" << endl;
    Pair p2(8, 2);
    Pair p3(5, 1);
    cout << p2 << " - " << p3 << " = " << (p2 - p3) << endl;

    return 0;
}


