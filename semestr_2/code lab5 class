#include "Vector.h"

Vector::Vector(void) // создаёт пустой вектор
{
    beg = 0; // обнуляем указатель (нет массива)
    size = 0;
    cur = 0;
}

Vector::Vector(int n) // n — максимальное количество элементов
{
    beg = new Object * [n]; // выделяем память под массив указателей на Object
    cur = 0;
    size = n;
}

Vector::~Vector(void)
{
    if (beg != 0) delete[] beg; // если массив был выделен, освобождаем память
    beg = 0;
}

void Vector::Add(Object* p)
{
    if (cur < size) // если ещё есть свободное место
    {
        beg[cur] = p; // помещаем указатель в текущую позицию
        cur++;
    }
}

ostream& operator<<(ostream& out, const Vector& v)
{
    if (v.size == 0) out << "Empty" << endl; // если вектор пуст, выводим "Empty"
    Object** p = v.beg; // устанавливаем временный указатель на начало массив
    for (int i = 0; i < v.cur; i++) // проходим по всем добавленным элементам
    {
        (*p)->Show(); // полиморфный вызов. вызываем виртуальную функцию Show() для объекта. позднее связывание: вызывается версия Show() в зависимости от реального типа объекта
        p++; // перемещаем указатель на следующий элемент массива
    }
    return out; // возвращаем поток
}


