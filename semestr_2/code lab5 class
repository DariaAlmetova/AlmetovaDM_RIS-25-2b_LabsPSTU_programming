#include "Rational.h"

Rational::Rational(void) : Pair()
{
    first = 0;
    second = 1;
}

Rational::~Rational(void) {}

Rational::Rational(int num, int den) : Pair(num, den)
{
    if (second == 0)
    {
        cout << "Ошибка: знаменатель не может быть нулем! Установлено значение 1." << endl;
        second = 1;
    }
    Reduce();
}

Rational::Rational(const Rational& r) : Pair(r) {}

void Rational::Set_numerator(int num)
{
    first = num;
    Reduce();
}

void Rational::Set_denominator(int den)
{
    if (den != 0)
    {
        second = den;
        Reduce();
    }
    else
    {
        cout << "Ошибка: знаменатель не может быть нулем!" << endl;
    }
}

// алгоритм Евклида для нахождения НОД
int Rational::gcd(int a, int b) const
{
    a = abs(a);
    b = abs(b);
    while (b != 0)
    {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

void Rational::Reduce()
{
    if (second == 0) return;
    int divisor = gcd(first, second);
    if (divisor != 0)
    {
        first /= divisor;
        second /= divisor;
    }
    if (second < 0) // если знаменатель отрицательный
    {
        first = -first; // переносим минус в числитель
        second = -second; // делаем знаменатель положительным
    }
}

Rational& Rational::operator=(const Rational& r)
{
    if (&r == this) return *this;
    first = r.first;
    second = r.second;
    return *this;
}

Rational Rational::operator+(const Rational& r) const
{
    Rational result;
    result.first = this->first * r.second + r.first * this->second; // числитель суммы
    result.second = this->second * r.second;
    result.Reduce(); // сокращаем результат
    return result;
}

Rational Rational::operator-(const Rational& r) const
{
    Rational result;
    result.first = this->first * r.second - r.first * this->second;
    result.second = this->second * r.second;
    result.Reduce();
    return result;
}

Rational Rational::operator*(const Rational& r) const
{
    Rational result;
    result.first = this->first * r.first;
    result.second = this->second * r.second;
    result.Reduce();
    return result;
}

istream& operator>>(istream& in, Rational& r)
{
    cout << "Введите числитель: ";
    in >> r.first;
    cout << "Введите знаменатель: ";
    in >> r.second;
    if (r.second == 0)
    {
        cout << "Ошибка: знаменатель не может быть нулем! Установлено значение 1." << endl;
        r.second = 1;
    }
    r.Reduce();
    return in;
}

ostream& operator<<(ostream& out, const Rational& r)
{
    if (r.second == 1)
        out << r.first;
    else if (r.first == 0)
        out << 0;
    else
        out << r.first << "/" << r.second;
    return out;
}

void Rational::Show()
{
    cout << "Rational: " << *this << endl; // используем перегруженный operator<< для вывода дроби
}


