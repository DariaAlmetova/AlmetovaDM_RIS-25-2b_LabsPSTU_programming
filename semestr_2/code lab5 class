#include <string>
using namespace std;

class Pair : public Object // класс Pair публично наследует Object (теперь Pair — конкретный класс, если переопределит Show)
{
public:
    // конструкторы
    Pair(void); // без параметров
    Pair(int, int); // с параметрами
    Pair(const Pair&); // копирования

    // деструктор
    virtual ~Pair(void); // виртуальный деструктор (переопределяет Object:: ~Object)

    // селекторы
    int Get_first() const { return first; }
    int Get_second() const { return second; }

    // модификаторы
    void Set_first(int); // устанавливает новое значение для first
    void Set_second(int);

    // методы
    bool IsEqual(const Pair&) const; // сравнивает текущую пару с другой на равенство
    int Multiply() const; // возвращает произведение first и second

    // перегрузка операций
    Pair& operator=(const Pair&); // оператор присваивания
    Pair operator-(const Pair&) const; // вычитание пар по формуле (a,b)-(c,d) = (a-b, c-d)

    friend istream& operator>>(istream&, Pair&); // для ввода из потока
    friend ostream& operator<<(ostream&, const Pair&); // для вывода в поток

    // переопределение чисто виртуальной функции
    virtual void Show() override; // override явно указывает, что переопределяем метод базового класса

protected:
    int first; // первое число пары
    int second;
};


