#include "Pair.h"

Pair::Pair(void) : first(0), second(0) {} // конструктор без параметров. инициализирует first и second нулями через список инициализации

Pair::~Pair(void) {} // деструктор

Pair::Pair(int f, int s) : first(f), second(s) {} // конструктор с параметрами

Pair::Pair(const Pair& p) : first(p.first), second(p.second) {} // копирует поля из объекта p. конструктор копирования

void Pair::Set_first(int f) { first = f; } // модификаторы. определение метода установки first
void Pair::Set_second(int s) { second = s; }

bool Pair::IsEqual(const Pair& p) const // константный метод проверки на равенство
{
    return (first == p.first && second == p.second); // возвращает true, если оба поля равны
}

int Pair::Multiply() const // метод перемножения полей
{
    return first * second;
}

Pair& Pair::operator=(const Pair& p) // оператор присваивания. возвращает ссылку на текущий объект
{
    if (&p == this) return *this;
    first = p.first; // копируем first
    second = p.second;
    return *this; // возвращаем ссылку на себя
}

Pair Pair::operator-(const Pair& p) const // оператор вычитания пар
{
    Pair result; // создаём временный объект
    result.first = this->first - this->second; // first = first текущего - second текущего
    result.second = p.first - p.second; // second = first переданного - second переданного
    return result; // возвращаем результат
}

istream& operator>>(istream& in, Pair& p) // глобальная функция ввода (друг класса)
{
    cout << "Введите first: ";
    in >> p.first;
    cout << "Введите second: ";
    in >> p.second;
    return in;
}

ostream& operator<<(ostream& out, const Pair& p) // глобальная функция вывода (друг класса)
{
    out << "(" << p.first << ", " << p.second << ")";
    return out;
}

void Pair::Show() // переопределённый метод Show (из Object). реализация виртуальной функции
{
    cout << "Pair: first = " << first << ", second = " << second << endl;
}


