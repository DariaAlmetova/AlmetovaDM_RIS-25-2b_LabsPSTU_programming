// дружественный оператор вывода
ostream& operator<<(ostream& out, const Set& s) {
    if (s.size == 0) // если множество пусто
        out << "Empty"; // выводим "Empty"
    else {
        for (int i = 0; i < s.size; ++i) // проходим по всем элементам
            out << s.data[i] << " "; // выводим каждый через пробел
    }
    return out; // возвращаем поток для цепочек вывода
}

// дружественный оператор ввода
istream& operator>>(istream& in, Set& s) {
    for (int i = 0; i < s.size; ++i) { // для каждого элемента
        cout << "> "; // выводим приглашение
        in >> s.data[i]; // считываем значение
    }
    return in; // возвращаем поток
}


