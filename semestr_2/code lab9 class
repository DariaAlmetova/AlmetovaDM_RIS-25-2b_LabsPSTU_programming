Error3.h

#pragma once
#include <iostream>
using namespace std;

// базовый абстрактный класс для всех исключений
class Error {
public:
    virtual void what() const = 0; // чисто виртуальный метод вывода сообщения
    virtual ~Error() {} // виртуальный деструктор
};

// ошибки размера
class SizeError : public Error {}; // промежуточный класс для ошибок размера

// превышение максимального размера (исключение 1)
class MaxSizeError : public SizeError {
public:
    virtual void what() const { cout << "Ошибка: размер превышает MAX_SIZE (30)" << endl; }
};

// удаление из пустого множества (исключение 5)
class EmptySetError : public SizeError {
public:
    virtual void what() const { cout << "Ошибка: попытка удалить из пустого множества" << endl; }
};

// ошибки индекса
class IndexError : public Error {}; // промежуточный класс для ошибок индекса

// индекс меньше 0 (исключение 2)
class IndexNegative : public IndexError {
public:
    virtual void what() const { cout << "Ошибка: индекс меньше 0" << endl; }
};

// индекс больше или равен текущему размеру (исключение 3)
class IndexTooLarge : public IndexError {
public:
    virtual void what() const { cout << "Ошибка: индекс >= текущего размера множества" << endl; }
};

// ошибка добавления при достижении MAX_SIZE (исключение 4)
class AddOverflow : public SizeError {
public:
    virtual void what() const { cout << "Ошибка: добавление элемента невозможно – достигнут MAX_SIZE" << endl; }
};

