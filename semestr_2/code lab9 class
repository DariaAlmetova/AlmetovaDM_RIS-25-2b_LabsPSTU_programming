#pragma once
#include <iostream>
using namespace std;

const int MAX_SIZE = 30; // максимально допустимый размер множества

class Set { // объявление класса Set
    int size; // текущее количество элементов
    int* data; // указатель на динамический массив целых чисел
public:
    Set() : size(0), data(nullptr) {} // конструктор по умолчанию (пустое множество)

    Set(int s); // конструктор с размером (инициализирует нулями)
    Set(int s, int* arr); // конструктор с массивом (копирует данные)
    Set(const Set& other); // конструктор копирования
    ~Set(); // деструктор

    const Set& operator=(const Set& other); // оператор присваивания
    int operator[](int i); // оператор доступа по индексу
    operator int() const; // оператор приведения к int (возвращает size)
    Set operator*(const Set& other) const; // пересечение множеств
    Set operator+(int val); // добавление элемента в конец
    Set operator--(); // префиксный декремент – удаление последнего
    //void Remove(int value);

    // дружественные операторы ввода/вывода
    friend ostream& operator<<(ostream& out, const Set& s);
    friend istream& operator>>(istream& in, Set& s);
};



