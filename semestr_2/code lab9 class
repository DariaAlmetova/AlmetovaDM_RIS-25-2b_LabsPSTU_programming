#include <iostream>
using namespace std;

// конструктор по умолчанию
Set::Set() : size(0), data(nullptr) {} // инициализация: пустое множество, указатель null

// конструктор с размером
Set::Set(int s) {
    if (s > MAX_SIZE) throw Error("Ошибка 1: размер превышает MAX_SIZE"); // проверка и генерация исключения
    size = s; // сохраняем размер
    data = new int[size]; // выделяем память под массив
    for (int i = 0; i < size; ++i) // цикл по всем элементам
        data[i] = 0; // инициализируем нулями
}

// конструктор с массивом
Set::Set(int s, int* arr) {
    if (s > MAX_SIZE) throw Error("Ошибка 1: размер превышает MAX_SIZE"); // проверка предела
    size = s; // сохраняем размер
    data = new int[size]; // выделяем память
    for (int i = 0; i < size; ++i) // копируем элементы из переданного массива
        data[i] = arr[i];
}

// конструктор копирования
Set::Set(const Set& other) {
    size = other.size; // копируем размер
    data = new int[size]; // выделяем новую память
    for (int i = 0; i < size; ++i) // копируем элементы из other
        data[i] = other.data[i];
}

// деструктор
Set::~Set() {
    delete[] data; // освобождаем динамически выделенную память
}

// оператор присваивания
const Set& Set::operator=(const Set& other) {
    if (this == &other) return *this; // защита от самоприсваивания
    delete[] data; // удаляем старые данные
    size = other.size; // копируем размер
    data = new int[size]; // выделяем новую память
    for (int i = 0; i < size; ++i) // копируем элементы
        data[i] = other.data[i];
    return *this; // возвращаем ссылку на текущий объект
}

// оператор доступа по индексу
int Set::operator[](int i) {
    if (i < 0) throw Error("Ошибка 2: индекс меньше 0"); // проверка отрицательного индекса
    if (i >= size) throw Error("Ошибка 3: индекс больше или равен размеру"); // проверка выхода за границы
    return data[i]; // возвращаем элемент
}

// оператор приведения к int (размер множества)
Set::operator int() const {
    return size; // просто возвращаем текущий размер
}

// оператор пересечения множеств
Set Set::operator*(const Set& other) const {
    // вычисляем максимально возможное количество общих элементов (не более меньшего размера)
    int maxPossible = (size < other.size) ? size : other.size;
    int* temp = new int[maxPossible]; // временный массив для хранения общих элементов
    int count = 0; // счётчик найденных общих элементов
    for (int i = 0; i < size; ++i) { // перебираем элементы первого множества
        for (int j = 0; j < other.size; ++j) { // перебираем элементы второго
            if (data[i] == other.data[j]) { // если элементы равны (общие)
                temp[count++] = data[i]; // добавляем во временный массив
                break; // выходим из внутреннего цикла, чтобы не дублировать
            }
        }
    }
    Set result(count, temp); // создаём новое множество из найденных элементов
    delete[] temp; // освобождаем временный массив
    return result; // возвращаем результат
}

// оператор добавления элемента в конец
Set Set::operator+(int val) {
    if (size + 1 > MAX_SIZE) throw Error("Ошибка 4: добавление невозможно, достигнут MAX_SIZE"); // проверка переполнения
    Set temp(size + 1, data); // создаём временное множество с размером на 1 больше
    temp.data[size] = val; // записываем новый элемент в конец
    return temp; // возвращаем новое множество
}

// префиксный оператор удаления последнего элемента
Set Set::operator--() {
    if (size == 0) throw Error("Ошибка 5: удаление из пустого множества"); // проверка пустоты
    if (size == 1) { // если был только один элемент
        delete[] data; // удаляем массив
        data = nullptr; // обнуляем указатель
        size = 0; // размер становится 0
        return *this; // возвращаем текущий (пустой) объект
    }
    // если элементов больше одного:
    Set temp(size, data); // копируем текущее множество во временное
    delete[] data; // удаляем старый массив
    --size; // уменьшаем размер на 1
    data = new int[size]; // выделяем новый массив меньшего размера
    for (int i = 0; i < size; ++i) // копируем все элементы, кроме последнего
        data[i] = temp.data[i];
    return *this; // возвращаем текущий объект
}

