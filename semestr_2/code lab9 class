#include "Set1.h"

// конструктор с размером
Set::Set(int s) {
    if (s > MAX_SIZE) throw 1; // если размер больше MAX_SIZE – исключение 1
    size = s; // сохраняем размер
    data = new int[size]; // выделяем память под массив
    for (int i = 0; i < size; ++i) data[i] = 0; // заполняем нулями
}

// конструктор с массивом
Set::Set(int s, int* arr) {
    if (s > MAX_SIZE) throw 1; // проверка на превышение MAX_SIZE
    size = s;
    data = new int[size];
    for (int i = 0; i < size; ++i) data[i] = arr[i]; // копируем данные из arr
}

// конструктор копирования
Set::Set(const Set& other) {
    size = other.size; // копируем размер
    data = new int[size]; // выделяем новую память
    for (int i = 0; i < size; ++i) data[i] = other.data[i]; // копируем элементы
}

// деструктор
Set::~Set() {
    delete[] data; // освобождаем динамическую память
}

// оператор присваивания
const Set& Set::operator=(const Set& other) {
    if (this == &other) return *this; // защита от самоприсваивания
    delete[] data; // удаляем старые данные
    size = other.size; // копируем размер
    data = new int[size]; // выделяем новую память
    for (int i = 0; i < size; ++i) data[i] = other.data[i]; // копируем элементы
    return *this; // возвращаем ссылку на текущий объект
}

// оператор доступа по индексу
int Set::operator[](int i) {
    if (i < 0) throw 2; // тндекс меньше 0 – исключение 2
    if (i >= size) throw 3; // индекс выходит за границы – исключение 3
    return data[i]; // возвращаем элемент
}

// оператор приведения к int
Set::operator int() const {
    return size; // возвращаем текущий размер
}

// оператор пересечения множеств
Set Set::operator*(const Set& other) const {
    // определяем максимально возможный размер результата (не больше меньшего из двух)
    int maxSize = (size < other.size) ? size : other.size;
    int* temp = new int[maxSize]; // временный массив для общих элементов
    int k = 0; // счётчик найденных общих элементов
    for (int i = 0; i < size; ++i) { // перебираем элементы первого множества
        for (int j = 0; j < other.size; ++j) { // перебираем элементы второго
            if (data[i] == other.data[j]) { // если элемент общий
                temp[k++] = data[i]; // добавляем во временный массив
                break; // выходим из внутреннего цикла (чтобы не дублировать)
            }
        }
    }
    Set result(k, temp); // создаём новое множество из найденных элементов
    delete[] temp; // освобождаем временный массив
    return result; // возвращаем результат
}

// оператор добавления элемента (в конец)
Set Set::operator+(int val) {
    if (size + 1 > MAX_SIZE) throw 4; // если новый размер превысит MAX_SIZE – исключение 4
    Set temp(size + 1, data); // создаём временное множество с размером на 1 больше
    temp.data[size] = val; // добавляем новый элемент в конец
    return temp; // возвращаем новое множество
}

// префиксный оператор -- (удаление последнего элемента)
Set Set::operator--() {
    if (size == 0) throw 5; // если множество пусто – исключение 5
    if (size == 1) { // если был один элемент
        delete[] data; // удаляем массив
        data = nullptr; // обнуляем указатель
        size = 0; // размер становится 0
        return *this; // возвращаем текущий объект (пустое множество)
    }
    // если элементов больше одного:
    Set temp(size, data); // копируем текущее множество во временное
    delete[] data; // удаляем старый массив
    size--; // уменьшаем размер
    data = new int[size]; // выделяем новый массив меньшего размера
    for (int i = 0; i < size; ++i) data[i] = temp.data[i]; // копируем данные (кроме последнего)
    return *this; // возвращаем текущий объект
}

