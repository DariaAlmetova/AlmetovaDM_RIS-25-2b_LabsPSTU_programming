#include <iostream>
#include <clocale>
using namespace std;

int main() {
    setlocale(LC_ALL, "ru");
    const int n = 3; // количество строк
    const int m = 3; // количество столбцов
    int arr[n][m];

    // заполняем массив вручную
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < m; ++j) {
            cin >> arr[i][j];
        }
    }

    // теперь отсортируем строки по элементам второй строки (столбец с индексом 1)
    for (int i = 0; i < m - 1; ++i) {
        int min_el = arr[1][i]; // начальное минимальное значение индекса
        int min_i = i; // храним минимальный элемент из второго столбца

        // поиск минимального элемента среди оставшихся строк
        for (int j = i + 1; j < m; ++j) {
            if (arr[1][j] < min_el) {
                min_el = arr[1][j];
                min_i = j;
            }
        }

        // если найден новый минимум, меняем местами строки
        for (int k = 0; k < n; ++k) {
            int t;
            t = arr[k][i];
            arr[k][i] = arr[k][min_i];
            arr[k][min_i] = t;
        }
    }

    // печать результата
    cout << "Отсортированный массив:" << endl;
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < m; ++j) {
            cout << arr[i][j] << ' ';
        }
        cout << endl;
    }

    return 0;
}
