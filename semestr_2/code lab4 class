#include "Rational.h"
#include <cmath>

// конструктор без параметров
Rational::Rational(void) : Pair()
{
    // first = 0, second = 1 по умолчанию (дробь 0/1)
    first = 0;
    second = 1;
}

// деструктор
Rational::~Rational(void)
{
}

// конструктор с параметрами
Rational::Rational(int num, int den) : Pair(num, den) // num - числитель, den - знаменатель
{
    if (second == 0)
    {
        cout << "Ошибка: знаменатель не может быть нулем! Установлено значение 1." << endl;
        second = 1;
    }
    Reduce(); // сразу сокращаем дробь
}

// конструктор копирования
Rational::Rational(const Rational& r) : Pair(r)
{
    // поля уже скопированы через конструктор Pair
}

// модификаторы
void Rational::Set_numerator(int num)
{
    first = num;
    Reduce();
}

void Rational::Set_denominator(int den)
{
    if (den != 0)
    {
        second = den;
        Reduce();
    }
    else
    {
        cout << "Ошибка: знаменатель не может быть нулем!" << endl;
    }
}

// алгоритм Евклида для нахождения НОД
int Rational::gcd(int a, int b) const
{
    a = abs(a);
    b = abs(b);
    while (b != 0)
    {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// сокращение дроби
void Rational::Reduce()
{
    if (second == 0) return;

    int divisor = gcd(first, second); // находим наибольший общий делитель
    if (divisor != 0)
    {
        first /= divisor; // делим числитель на НОД
        second /= divisor;
    }

    // если знаменатель отрицательный, переносим знак в числитель
    if (second < 0)
    {
        first = -first; // умножаем числитель на -1
        second = -second;
    }
}

// перегрузка операции присваивания
Rational& Rational::operator=(const Rational& r)
{
    if (&r == this) return *this;
    first = r.first;
    second = r.second;
    return *this;
}

// сложение дробей: a/b + c/d = (a*d + c*b) / (b*d)
Rational Rational::operator+(const Rational& r) const
{
    Rational result;
    result.first = this->first * r.second + r.first * this->second;
    result.second = this->second * r.second;
    result.Reduce();
    return result;
}

// вычитание дробей: a/b - c/d = (a*d - c*b) / (b*d)
Rational Rational::operator-(const Rational& r) const
{
    Rational result;
    result.first = this->first * r.second - r.first * this->second;
    result.second = this->second * r.second;
    result.Reduce();
    return result;
}

// умножение дробей: a/b * c/d = (a*c) / (b*d)
Rational Rational::operator*(const Rational& r) const
{
    Rational result;
    result.first = this->first * r.first;
    result.second = this->second * r.second;
    result.Reduce();
    return result;
}

// оператор ввода
istream& operator>>(istream& in, Rational& r)
{
    cout << "Введите числитель: ";
    in >> r.first;
    cout << "Введите знаменатель: ";
    in >> r.second;

    if (r.second == 0)
    {
        cout << "Ошибка: знаменатель не может быть нулем! Установлено значение 1." << endl;
        r.second = 1;
    }
    r.Reduce();
    return in;
}

// оператор вывода
ostream& operator<<(ostream& out, const Rational& r)
{
    if (r.second == 1)
        out << r.first;
    else if (r.first == 0)
        out << 0;
    else
        out << r.first << "/" << r.second;
    return out;
}


