    Pair(const Pair&); // копирования

    // деструктор
    virtual ~Pair(void);

    // селекторы (геттеры)
    int Get_first() const { return first; }
    int Get_second() const { return second; }

    // модификаторы (сеттеры)
    void Set_first(int);
    void Set_second(int);

    // Метод проверки на равенство
    bool IsEqual(const Pair&) const;

    // операция перемножения полей
    int Multiply() const;

    // перегрузка операции присваивания
    Pair& operator=(const Pair&);

    // операция вычитания пар: (a,b)-(c,d) = (a-b, c-d)
