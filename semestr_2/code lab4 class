#include "Pair.h"

// конструктор без параметров
Pair::Pair(void)
{
    first = 0;
    second = 0;
}

// деструктор
Pair::~Pair(void)
{
}

// конструктор с параметрами
Pair::Pair(int f, int s)
{
    first = f;
    second = s;
}

// конструктор копирования
Pair::Pair(const Pair& p)
{
    first = p.first;
    second = p.second;
}

// модификаторы
void Pair::Set_first(int f)
{
    first = f;
}

void Pair::Set_second(int s)
{
    second = s;
}

// метод проверки на равенство
bool Pair::IsEqual(const Pair& p) const
{
    return (first == p.first && second == p.second);
}

// операция перемножения полей
int Pair::Multiply() const
{
    return first * second;
}

// перегрузка операции присваивания
Pair& Pair::operator=(const Pair& p)
{
    if (&p == this) return *this;
    first = p.first;
    second = p.second;
    return *this;
}

// операция вычитания пар: (a,b)-(c,d) = (a-b, c-d)
Pair Pair::operator-(const Pair& p) const
{
    Pair result;
    result.first = this->first - this->second;
    result.second = p.first - p.second;
    return result;
}

// глобальная функция для ввода
istream& operator>>(istream& in, Pair& p)
{
    cout << "Введите first: ";
    in >> p.first;
    cout << "Введите second: ";
    in >> p.second;
    return in;
}

// глобальная функция для вывода
ostream& operator<<(ostream& out, const Pair& p)
{
    out << "(" << p.first << ", " << p.second << ")";
    return out;
}


