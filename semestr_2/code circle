#include <iostream>
#include <cstdarg>
#include <clocale>
#include <cmath>

using namespace std;

// функция для подсчета точек, лежащих на окружности радиуса r
int circle(double r, int count, ...) {
    va_list args;
    va_start(args, count); // инициализация списка аргументов

    int p = 0;

    for (int i = 0; i < count / 2; ++i) { // перебираем пары координат (x,y)
        double x = va_arg(args, double); // получаем первый аргумент (координата X)
        double y = va_arg(args, double); // получаем второй аргумент (координата Y)

        double d = x * x + y * y; // вычисляем квадрат расстояния от начала координат
        double ra = r * r; // вычисляем квадрат радиуса окружности

        // Проверяем близость точки к окружности с заданной точностью
        const double epsilon = 1e-6;
        if (fabs(d - ra) < epsilon) { // модуль
            ++p; // увеличиваем счётчик точек на окружности
        }
    }

    va_end(args); // завершение обработки переменных аргументов
    return p;
}

int main() {
    setlocale(LC_ALL, "ru");
    double rad = 5.0; // задаём радиус окружности

    // вызов 1: проверяем три точки
    int res1 = circle(rad, 6, 3.0, 4.0, 0.0, 5.0, -3.0, -4.0);
    cout << "Вызов 1 (три точки): " << res1 << " точек лежит на окружности." << endl;

    // вызов 2: проверяем шесть точек
    int res2 = circle(rad, 12, 3.0, 4.0, 0.0, 5.0, -3.0, -4.0, 5.0, 0.0, -5.0, 0.0);
    cout << "Вызов 2 (шесть точек): " << res2 << " точек лежит на окружности." << endl;

    // вызов 3: проверяем девять точек
    int res3 = circle(rad, 18,
        3.0, 4.0, 0.0, 5.0, -3.0, -4.0,
        5.0, 0.0, -5.0, 0.0, 4.0, 3.0,
        -4.0, -3.0, 1.0, 2.0, 2.0, 1.0);
    cout << "Вызов 3 (девять точек): " << res3 << " точек лежит на окружности." << endl;

    return 0;
}

