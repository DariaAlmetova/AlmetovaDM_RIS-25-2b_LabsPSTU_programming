#include <iostream>
#include <fstream>
#include <string>
#include <clocale>

using namespace std;

bool cons(char c) {
    c = tolower(c);
    return isalpha(c) && !(c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == 'y');
}

int main() {
    setlocale(LC_ALL, "RU");

    ifstream fin("G1.txt");
    ofstream fout("G2.txt");

    if (!fin) {
        cout << "Ошибка открытия файла G1" << endl;
        return 1;
    }
    if (!fout) {
        cout << "Ошибка открытия файла G2" << endl;
        return 1;
    }

    int m = -1; // максимальное количество согласных среди всех слов
    int mv = -1; // номер слова с максимальным количеством согласных
    int t = 0; // общее количество слов по всему файлу

    int wor[50]; // массив для хранения номеров слов с максимальным количеством согласных
    int cnt = 0; // число слов с максимальным количеством согласных

    string s; // строка для чтения из файла

    while (getline(fin, s)) {
        // подсчет количества слов в строке
        int w = 0; // счетчик слов в текущей строке
        int start = 0; // индекс начала текущего слова

        for (int i = 0; i <= s.length(); i++) { // проходим по символам строки
            if (i == s.length() || s[i] == ' ') {
                if (i > start) { // если есть слово
                    w++;
                }
                start = i + 1; // начинаем новое слово с следующей позиции
            }
        }

        // проверка, 2 ли слова
        if (w == 2) {
            // записываем строку
            fout << s << endl;
        }

        start = 0; // сбрасываем начальную позицию для анализа слов в строке и для поиска слова с максимальным количеством согласных
        for (int i = 0; i <= s.length(); i++) {
            if (i == s.length() || s[i] == ' ') {
                if (i > start) {
                    string word = s.substr(start, i - start);
                    int consc = 0; // счетчик согласных в текущем слов
                    for (char c : word) {
                        if (cons(c))
                            consc++;
                    }
                    t++;
                    if (consc > m) {
                        m = consc;
                        mv = t;
                        // очищаем список слов с максимумом и добавляем текущий
                        cnt = 1;
                        wor[0] = t;
                    }
                    else if (consc == m && m != -1) {
                        // добавляем в список, если равно текущему максимуму
                        if (cnt < 50) { // чтобы не выйти за границы
                            wor[cnt] = t;
                            cnt++;
                        }
                    }
                }
                start = i + 1;
            }
        }
    }

    // вывод результата
    if (m != -1 && cnt > 1) {
        fout << endl;
        fout << "Слов с максимальным количеством согласных (" << m << "): " << cnt << endl;
        fout << "Номера слов: ";
        for (int i = 0; i < cnt; i++) {
            fout << wor[i];
            if (i != cnt - 1)
                fout << ", ";
        }
        fout << endl;
    }
    else if (m != -1) {
        // только одно слово с максимумом
        fout << endl;
        fout << "Номер слова с максимальным количеством согласных из файла G1: " << mv << endl;
    }
    else {
        fout << "Не найдено слов с согласными." << endl;
    }

    fin.close();
    fout.close();

    return 0;
}
