#pragma once
#include <iostream>

template <class T>
class Vector {
private:
    T* data; // указатель на динамический массив
    int size; // размер вектора (количество элементов)
public:
    // конструктор: выделяет память под n элементов и заполняет их через ввод
    Vector(int n) : size(n) {
        data = new T[size];
        for (int i = 0; i < size; ++i) {
            std::cout << "Элемент " << i + 1 << ":\n";
            std::cin >> data[i];
        }
    }

    // деструктор
    ~Vector() { delete[] data; }

    // конструктор копирования
    Vector(const Vector& other) : size(other.size) {
        data = new T[size];
        for (int i = 0; i < size; ++i)
            data[i] = other.data[i];
    }

    // оператор присваивания
    Vector& operator=(const Vector& other) {
        if (this != &other) {
            delete[] data;
            size = other.size;
            data = new T[size];
            for (int i = 0; i < size; ++i)
                data[i] = other.data[i];
        }
        return *this;
    }

    // метод печати
    void Print() const {
        for (int i = 0; i < size; ++i)
            std::cout << data[i] << " ";
        std::cout << std::endl;
    }

    // поиск минимума
    T FindMin() const {
        if (size == 0) return T();
        T m = data[0];
        for (int i = 1; i < size; ++i)
            if (data[i] < m) m = data[i];
        return m;
    }

    // добавление минимума в конец (требует перевыделения памяти)
    void AddMinToEnd() {
        if (size == 0) return;
        T minVal = FindMin();
        T* newData = new T[size + 1];
        for (int i = 0; i < size; ++i)
            newData[i] = data[i];
        newData[size] = minVal;
        delete[] data;
        data = newData;
        ++size;
    }

    // удаление первого вхождения по ключу
    bool DeleteByKey(const T& key) {
        int index = -1;
        for (int i = 0; i < size; ++i) {
            if (data[i] == key) {
                index = i;
                break;
            }
        }
        if (index == -1) return false;
        T* newData = new T[size - 1];
        for (int i = 0, j = 0; i < size; ++i) {
            if (i != index)
                newData[j++] = data[i];
        }
        delete[] data;
        data = newData;
        --size;
        return true;
    }

    // добавление суммы min+max к каждому элементу
    void AddSumMinMax() {
        if (size == 0) return;
        T minv = data[0], maxv = data[0];
        for (int i = 1; i < size; ++i) {
            if (data[i] < minv) minv = data[i];
            if (data[i] > maxv) maxv = data[i];
        }
        T sum = minv + maxv;
        for (int i = 0; i < size; ++i)
            data[i] = data[i] + sum;
    }
};



