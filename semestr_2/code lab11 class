#include <iostream>
#include <vector>
#include "Money.h"
using namespace std;

typedef vector<Money> Vec; // определение псевдонима Vec для типа vector<Money>

// функция формирования вектора из n элементов типа Money (пользовательский ввод)
Vec make_vector(int n) {
    Vec v; // создаём пустой вектор v (тип vector<Money>)
    for (int i = 0; i < n; ++i) {
        Money m; // создаём временный объект Money (вызывается конструктор по умолчанию)
        cout << "Элемент " << i + 1 << ":\n";
        cin >> m; // вводим денежную сумму (используется перегруженный оператор >>)
        v.push_back(m);
    }
    return v; // возвращаем заполненный вектор
}

// функция печати вектора
void print_vector(const Vec& v) {
    for (const Money& m : v)
        cout << m << " ";
    cout << endl;
}

// функция поиска минимального элемента в векторе (возвращает копию найденного минимума)
Money find_min(const Vec& v) {
    if (v.empty()) return Money(); // если вектор пуст – возвращаем нулевую сумму (0,00)
    Money m = v[0];
    for (size_t i = 1; i < v.size(); ++i)
        if (v[i] < m) m = v[i];
    return m;
}

// функция добавления минимального элемента в конец вектора
void add_min_to_end(Vec& v) {
    if (v.empty()) return;
    v.push_back(find_min(v));
}

// функция удаления первого вхождения элемента с заданным ключом (значением) из вектора
bool delete_by_key(Vec& v, const Money& key) {
    for (auto it = v.begin(); it != v.end(); ++it)
        if (*it == key) {
            v.erase(it); // удаляем элемент по текущему итератору (erase возвращает итератор на следующий элемент, но нам он не нужен)
            return true; // возвращаем true – удаление успешно
        }
    return false;
}

// aункция добавления к каждому элементу вектора суммы минимального и максимального элементов
void add_sum_min_max(Vec& v) {
    if (v.empty()) return;
    Money minv = v[0], maxv = v[0];
    for (const Money& x : v) {
        if (x < minv) minv = x;
        if (x > maxv) maxv = x;
    }
    Money sum = minv + maxv;
    for (Money& x : v)
        x = x + sum;
}

int main() {
    setlocale(LC_ALL, "ru");
    int n;
    cout << "Размер вектора: "; cin >> n;

    Vec v = make_vector(n);
    cout << "Исходный: "; print_vector(v);

    add_min_to_end(v);
    cout << "После добавления min в конец: "; print_vector(v);

    Money key;
    cout << "Введите ключ для удаления:\n";
    cin >> key;

    if (delete_by_key(v, key)) {
        cout << "После удаления: ";
        print_vector(v);
    }
    else {
        cout << "Элемент не найден\n";
    }

    add_sum_min_max(v);
    cout << "После + (min+max): "; print_vector(v);

    return 0;
}



