#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <algorithm>     // подключение для алгоритма find() (поиск элемента в контейнере)
using namespace std;

typedef vector<float> Vec; // определение псевдонима Vec для типа vector<float>

// функция формирования вектора из n случайных вещественных чисел (типа float)
Vec make_vector(int n) {
    Vec v; // создаём пустой вектор v
    for (int i = 0; i < n; ++i)
        v.push_back((float)(rand() % 100) / 10.0f - 5.0f);
    // rand()%100 -> случайное целое от 0 до 99
    // /10.0f -> деление на 10, получаем число от 0.0 до 9.9
    // -5.0f -> сдвиг в диапазон [-5.0, 4.9]
    // push_back() добавляет элемент в конец вектора
    return v; // возвращаем заполненный вектор
}

// функция печати вектора
void print_vector(const Vec& v) {
    for (float x : v) // перебираем все элементы вектора v
        cout << x << " ";
    cout << endl;
}

// функция поиска минимального элемента в векторе
float find_min(const Vec& v) {
    if (v.empty()) return 0; // если вектор пуст – возвращаем 0 (нет элементов)
    float m = v[0]; // инициализируем минимум первым элементом
    for (float x : v)
        if (x < m) m = x;
    return m;
}

// функция добавления минимального элемента в конец вектора
void add_min_to_end(Vec& v) {
    if (v.empty()) return; // если вектор пуст – ничего не делаем
    v.push_back(find_min(v)); // находим минимум и добавляем его в конец вектора
}

// функция удаления первого вхождения элемента с заданным ключом (значением)
bool delete_by_key(Vec& v, float key) {
    auto it = find_if(v.begin(), v.end(), [key](float x) {
        // find() ищет элемент key в диапазоне [begin, end) и возвращает итератор на него (или end, если не найден)
        // auto – автоматическое определение типа (в данном случае vector<float>::iterator)
        return fabs(x - key) < 1e-6; // допуск 0.000001
        });
    if (it != v.end()) { // если элемент найден (итератор не указывает на конец)
        v.erase(it); // удаляем элемент по этому итератору
        return true; // возвращаем true – удаление успешно
    }
    return false;
}

// функция добавления к каждому элементу вектора суммы минимального и максимального элементов
void add_sum_min_max(Vec& v) {
    if (v.empty()) return;
    float minv = v[0], maxv = v[0]; // инициализируем минимум и максимум первым элементом
    for (float x : v) {
        if (x < minv) minv = x;
        if (x > maxv) maxv = x;
    }
    float sum = minv + maxv;
    for (float& x : v) // перебираем элементы по ссылке (чтобы изменять)
        x += sum; // Добавляем сумму к каждому элементу
}

int main() {
    setlocale(LC_ALL, "ru");
    srand((unsigned)time(0));

    int n;
    cout << "Размер вектора: "; cin >> n;

    Vec v = make_vector(n); // создаём вектор v, вызывая функцию формирования
    cout << "Исходный: "; print_vector(v);

    add_min_to_end(v);
    cout << "После добавления min в конец: "; print_vector(v);

    float key;
    cout << "Ключ для удаления: "; cin >> key;
    if (delete_by_key(v, key)) {
        cout << "После удаления: ";
        print_vector(v);
    }
    else {
        cout << "Элемент не найден\n";
    }

    add_sum_min_max(v);
    cout << "После + (min+max): "; print_vector(v);
    return 0;
}



