#pragma once
#include <iostream>

template <class T>
class Queue {
private:
    struct Node {
        T data;
        Node* next;
        Node(const T& val) : data(val), next(nullptr) {}
    };
    Node* head; // начало очереди (откуда удаляем)
    Node* tail; // конец очереди (куда добавляем)
    int count;  // количество элементов

public:
    Queue(int n) : head(nullptr), tail(nullptr), count(0) {
        for (int i = 0; i < n; ++i) {
            T a;
            std::cout << "Элемент " << i + 1 << ":\n";
            std::cin >> a;
            push(a);
        }
    }

    ~Queue() {
        while (!empty())
            pop();
    }

    void push(const T& val) {
        Node* newNode = new Node(val);
        if (tail) tail->next = newNode;
        else head = newNode;
        tail = newNode;
        ++count;
    }

    void pop() {
        if (!head) return;
        Node* temp = head;
        head = head->next;
        if (!head) tail = nullptr;
        delete temp;
        --count;
    }

    T front() const { return head->data; }
    bool empty() const { return head == nullptr; }
    int size() const { return count; }

    void Print() const {
        Node* cur = head;
        while (cur) {
            std::cout << cur->data << " ";
            cur = cur->next;
        }
        std::cout << std::endl;
    }

    T FindMin() const {
        if (empty()) return T();
        Node* cur = head;
        T m = cur->data;
        while (cur) {
            if (cur->data < m) m = cur->data;
            cur = cur->next;
        }
        return m;
    }

    T FindMax() const {
        if (empty()) return T();
        Node* cur = head;
        T m = cur->data;
        while (cur) {
            if (cur->data > m) m = cur->data;
            cur = cur->next;
        }
        return m;
    }

    void AddMinToEnd() {
        if (empty()) return;
        push(FindMin());
    }

    bool DeleteByKey(const T& key) {
        if (empty()) return false;
        // удаляем голову
        if (head->data == key) {
            pop();
            return true;
        }
        Node* cur = head;
        while (cur->next) {
            if (cur->next->data == key) {
                Node* toDelete = cur->next;
                cur->next = toDelete->next;
                if (toDelete == tail) tail = cur;
                delete toDelete;
                --count;
                return true;
            }
            cur = cur->next;
        }
        return false;
    }

    void AddSumMinMax() {
        if (empty()) return;
        T minv = FindMin();
        T maxv = FindMax();
        T sum = minv + maxv;
        Node* cur = head;
        while (cur) {
            cur->data = cur->data + sum;
            cur = cur->next;
        }
    }
};
