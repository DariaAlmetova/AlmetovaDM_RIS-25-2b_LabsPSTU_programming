#pragma once
#ifndef MONEY_H
#define MONEY_H
#include <iostream>
#include <iomanip>
using namespace std;

class Money {
private:
    long rubles;
    int kopeks;

    void normalize() {
        if (kopeks >= 100) {
            rubles += kopeks / 100; // добавляем к рублям целое количество сотен копеек
            kopeks %= 100; // оставляем остаток копеек (от 0 до 99)
        }
    }

public:
    Money() : rubles(0), kopeks(0) {} // конструктор по умолчанию: создаёт сумму 0,00 (инициализирует поля нулями)

    Money(long r, int k) : rubles(r), kopeks(k) { // конструктор с параметрами: рубли и копейки
        if (rubles < 0) rubles = 0; // если переданы отрицательные рубли – принудительно обнуляем
        if (kopeks < 0) kopeks = 0; // если отрицательные копейки – обнуляем
        normalize(); // вызываем нормализацию (на случай, если копеек >= 100)
    }

    Money(const Money& other) : rubles(other.rubles), kopeks(other.kopeks) {} // конструктор копирования

    Money(long total_kopeks) { // конструктор из общего количества копеек
        if (total_kopeks < 0) total_kopeks = 0; // отрицательные суммы запрещены – заменяем на 0
        rubles = total_kopeks / 100; // целая часть (рубли) = целое от деления на 100
        kopeks = total_kopeks % 100; // остаток (копейки) = остаток от деления на 100
        normalize();
    }

    Money& operator=(const Money& other) { // перегрузка оператора =
        if (this != &other) { // проверка на самоприсваивание (если объект не равен сам себе)
            rubles = other.rubles; // копируем рубли
            kopeks = other.kopeks; // копируем копейки
        }
        return *this; // возвращаем ссылку на текущий объект
    }

    Money operator+(const Money& other) const { // сложение двух сумм
        return Money(toKopeks() + other.toKopeks()); // переводим обе суммы в копейки, складываем, создаём новый Money
    }

    Money operator/(int divisor) const { // деление суммы на целое число (например, для среднего арифметического)
        if (divisor == 0) { // защита от деления на ноль
            cerr << "Ошибка: деление на 0\n"; // выводим сообщение об ошибке в поток ошибок
            return Money(0, 0); // возвращаем нулевую сумму
        }
        return Money(toKopeks() / divisor); // делим копейки на целое число, создаём новый Money
    }

    Money operator/(const Money& other) const { // деление одной суммы на другую (возвращает отношение, упакованное в Money)
        if (other.toKopeks() == 0) { // если делитель равен нулю
            cerr << "Ошибка: деление на 0\n";
            return Money(0, 0);
        }
        double ratio = (double)toKopeks() / other.toKopeks(); // вычисляем вещественное отношение
        return Money((long)(ratio * 100)); // умножаем на 100 и преобразуем в копейки, создаём Money
    }

    Money operator*(double factor) const { // умножение суммы на дробное число
        if (factor < 0) factor = -factor; // запрещаем отрицательный множитель (делаем положительным)
        return Money((long)(toKopeks() * factor)); // умножаем копейки на factor, округляем до целых, создаём Money
    }

    bool operator<(const Money& other) const { // оператор "меньше"
        return toKopeks() < other.toKopeks(); // сравниваем общие количества копеек
    }
    bool operator>(const Money& other) const { // оператор "больше"
        return toKopeks() > other.toKopeks();
    }
    bool operator==(const Money& other) const { // оператор "равно"
        return toKopeks() == other.toKopeks();
    }
    bool operator!=(const Money& other) const { // оператор "не равно"
        return !(*this == other); // реализуем через оператор ==
    }


    Money& operator++() { // префиксный ++ (++a)
        *this = Money(toKopeks() + 1); // увеличиваем общее количество копеек на 1, присваиваем себе
        return *this; // возвращаем ссылку на себя (уже изменённый объект)
    }
    Money operator++(int) { // постфиксный ++ (a++)
        Money temp = *this; // сохраняем старое значение
        ++(*this); // вызываем префиксный инкремент для увеличения текущего объекта
        return temp; // возвращаем старое значение (копию)
    }

    long toKopeks() const { // возвращает сумму в копейках (рубли*100 + копейки)
        return rubles * 100 + kopeks;
    }

    friend istream& operator>>(istream& in, Money& m) { // перегрузка оператора ввода >>
        long r; // временная переменная для рублей
        int k; // временная переменная для копеек
        bool ok = false; // флаг корректного ввода
        while (!ok) { // цикл до тех пор, пока не введут правильно
            cout << "Рубли (>=0): "; in >> r;
            cout << "Копейки (0-99): "; in >> k;
            if (r < 0 || k < 0) {
                cout << "Ошибка: рубли и копейки не могут быть отрицательными. Повторите ввод.\n";
            }
            else if (k >= 100) {
                cout << "Ошибка: копейки должны быть в диапазоне 0..99. Повторите ввод.\n";
            }
            else {
                ok = true; // ввод корректен – выходим из цикла
            }
        }
        m.rubles = r; // присваиваем полям объекта введённые значения
        m.kopeks = k;
        m.normalize();
        return in; // возвращаем поток для цепочечных операций (cin >> a >> b)
    }

    friend ostream& operator<<(ostream& out, const Money& m) { // перегрузка оператора вывода <<
        out << m.rubles << ","; // выводим рубли и запятую-разделитель
        if (m.kopeks < 10) out << "0"; // всли копеек меньше 10, выводим ведущий ноль (для формата 5,05)
        out << m.kopeks; // выводим копейки
        return out; // возвращаем поток
    }
};

#endif



