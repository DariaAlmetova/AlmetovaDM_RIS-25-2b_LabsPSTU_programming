#include <iostream>
#include <queue>
#include <vector>
#include "Money.h" 
using namespace std;

typedef queue<Money> Queue; // определение псевдонима Queue для очереди из объектов Money

// функция формирования очереди из n элементов (пользовательский ввод)
Queue make_queue(int n) {
    Queue q; // создаём пустую очередь q
    for (int i = 0; i < n; ++i) {
        Money m;
        cout << "Элемент " << i + 1 << ":\n";
        cin >> m;
        q.push(m); // добавляем элемент в конец очереди
    }
    return q; // возвращаем сформированную очередь
}

// функция печати очереди (принимает копию)
void print_queue(Queue q) {
    while (!q.empty()) { // пока очередь не пуста
        cout << q.front() << " "; // выводим первый элемент (оператор << класса Money)
        q.pop(); // удаляем первый элемент (извлекаем из очереди)
    }
    cout << endl;
}

// функция поиска минимального элемента в очереди (без изменения исходной очереди)
Money find_min(const Queue& q) {
    if (q.empty()) return Money(); // если очередь пуста – возвращаем нулевую сумму
    Queue temp = q; // создаём копию очереди
    Money m = temp.front();
    temp.pop();
    while (!temp.empty()) {
        if (temp.front() < m)
            m = temp.front();
        temp.pop(); // удаляем текущий элемент (продвигаемся по очереди)
    }
    return m;
}

// функция добавления минимального элемента в конец очереди
void add_min_to_end(Queue& q) {
    if (q.empty()) return;
    q.push(find_min(q));
}

// функция удаления первого вхождения элемента с заданным ключом из очереди
bool delete_by_key(Queue& q, const Money& key) {
    vector<Money> temp; // вспомогательный вектор для хранения оставшихся элементов
    bool removed = false; // флаг: удалён ли уже элемент
    while (!q.empty()) {
        Money cur = q.front();
        q.pop();
        if (!removed && cur == key) { // если элемент равен ключу и ещё не удаляли
            removed = true; // устанавливаем флаг
            continue; // пропускаем добавление этого элемента (удаляем)
        }
        temp.push_back(cur); // иначе сохраняем элемент во вспомогательный вектор
    }
    for (const Money& m : temp) // перебираем все сохранённые элементы
        q.push(m); // возвращаем их обратно в очередь (сохраняя порядок)
    return removed; // возвращаем true, если удаление произошло
}

// функция добавления к каждому элементу очереди суммы минимального и максимального элементов
void add_sum_min_max(Queue& q) {
    if (q.empty()) return;
    Queue temp = q;
    Money minv = temp.front(), maxv = temp.front();
    while (!temp.empty()) {
        Money cur = temp.front();
        if (cur < minv) minv = cur;
        if (cur > maxv) maxv = cur;
        temp.pop(); // удаляем обработанный элемент из копии
    }
    Money sum = minv + maxv;
    vector<Money> buf; // вектор для хранения изменённых элементов
    while (!q.empty()) { // извлекаем все элементы из исходной очереди
        Money cur = q.front(); q.pop();
        buf.push_back(cur + sum); // добавляем к каждому сумму и сохраняем в вектор
    }
    for (const Money& m : buf) // перебираем изменённые элементы
        q.push(m); // возвращаем их обратно в очередь (сохраняя порядок)
}

int main() {
    setlocale(LC_ALL, "ru");
    int n;
    cout << "Размер очереди: "; cin >> n;

    Queue q = make_queue(n);
    cout << "Исходная очередь: "; print_queue(q);

    add_min_to_end(q);
    cout << "После добавления min в конец: "; print_queue(q);

    Money key;
    cout << "Введите ключ для удаления:\n";
    cin >> key;

    if (delete_by_key(q, key)) {
        cout << "После удаления: "; print_queue(q);
    }
    else {
        cout << "Элемент не найден\n";
    }

    add_sum_min_max(q);
    cout << "После + (min+max): "; print_queue(q);

    return 0;
}




