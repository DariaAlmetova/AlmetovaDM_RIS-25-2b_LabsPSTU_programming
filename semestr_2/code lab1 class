#include <iostream>
#include "phone.h"
using namespace std;

// внешняя функция make_phone() для создания структуры
PhoneCall make_phone(int duration, double costPerMinute) {
    PhoneCall temp; // создаем временную переменную
    temp.Init(duration, costPerMinute); // инициализируем поля
    return temp; // возвращаем структуру как результат
}

// функция для демонстрации работы со ссылкой
void demonstrateReference(PhoneCall& ref) { // ref — это ссылка, которая является псевдонимом для объекта, переданного из main()
    cout << "Демонстрация работы со ссылкой:" << endl;
    cout << "Ссылка на объект -> те же данные:" << endl;
    ref.Show();

    // изменяем данные через ссылку
    cout << "Изменяем данные через ссылку (новая стоимость минуты - 3.0 руб):" << endl;
    ref.Init(ref.first, 3.0);
    ref.Show();
}

