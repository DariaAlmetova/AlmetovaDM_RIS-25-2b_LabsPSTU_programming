#ifndef PHONE_H // если PHONE_H НЕ определен
#define PHONE_H // то определи его

struct PhoneCall {
    int first;      // продолжительность разговора в минутах
    double second;  // стоимость одной минуты в рублях

    // метод для инициализации полей с контролем корректности
    void Init(int duration, double costPerMinute);

    // метод для ввода полей с клавиатуры
    void Read();

    // метод для вывода полей на экран
    void Show() const;  // добавлен const, так как метод не изменяет объект

    // метод для вычисления общей стоимости разговора
    double Cost() const;
};

#endif // конец блока условной компиляции
