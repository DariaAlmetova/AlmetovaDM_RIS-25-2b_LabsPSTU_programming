#include <iostream>
#include "phone.h"
using namespace std;

// реализация метода для инициализации полей структуры с контролем корректности
void PhoneCall::Init(int duration, double costPerMinute) {
    if (duration <= 0) {
        cout << "ОШИБКА: Продолжительность разговора должна быть положительным целым числом!" << endl;
        cout << "Программа завершает работу." << endl;
        exit(1);
    }

    if (costPerMinute <= 0) {
        cout << "ОШИБКА: Стоимость минуты разговора должна быть положительным числом!" << endl;
        cout << "Программа завершает работу." << endl;
        exit(1);
    }

    first = duration;
    second = costPerMinute;
}

// реализация метода для чтения значений полей с клавиатуры
void PhoneCall::Read() {
    int duration;
    double costPerMinute;

    cout << "Введите продолжительность разговора (в минутах, целое положительное число): ";
    cin >> duration;

    cout << "Введите стоимость одной минуты разговора (в рублях, положительное число): ";
    cin >> costPerMinute;

    Init(duration, costPerMinute);
}

// реализация метода для вывода значений полей на экран
void PhoneCall::Show() const {
    cout << "Продолжительность разговора: " << first << " минут" << endl;
    cout << "Стоимость одной минуты: " << second << " руб." << endl;
    cout << "Общая стоимость разговора: " << Cost() << " руб." << endl;
    cout << endl;
}

// метод для вычисления общей стоимости разговора
double PhoneCall::Cost() const {
    return first * second;
}


