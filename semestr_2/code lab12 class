#pragma once
#include <iostream>
using namespace std;

template <class T> // объявление шаблона класса с параметром типа T (тип хранимых элементов)
class MultiSetContainer { // начало определения шаблонного класса MultiSetContainer
private:
    T* data; // указатель на динамический массив элементов
    int size; // текущее количество элементов
    int capacity; // выделенная ёмкость

    // вспомогательная функция для расширения ёмкости
    void reserve(int new_capacity) {
        if (new_capacity <= capacity) return;
        T* new_data = new T[new_capacity];
        for (int i = 0; i < size; ++i)
            new_data[i] = data[i];
        delete[] data;
        data = new_data;
        capacity = new_capacity;
    }

    // бинарный поиск позиции для вставки элемента (первая позиция, где element >= value)
    int lower_bound_position(const T& value) const {
        int left = 0, right = size;
        while (left < right) {
            int mid = left + (right - left) / 2;
            if (data[mid] < value)
                left = mid + 1;
            else
                right = mid;
        }
        return left;
    }

    // вставка элемента в отсортированный массив
    void insert_sorted(const T& value) {
        if (size == capacity) {
            int new_capacity = (capacity == 0) ? 1 : capacity * 2;
            reserve(new_capacity);
        }
        int pos = lower_bound_position(value);
        // сдвиг элементов вправо
        for (int i = size; i > pos; --i)
            data[i] = data[i - 1];
        data[pos] = value;
        ++size;
    }

public:
    // конструктор, принимающий размер n (количество элементов для ввода)
    MultiSetContainer(int n) : data(nullptr), size(0), capacity(0) {
        T a; // временная переменная для хранения вводимого значения
        for (int i = 0; i < n; ++i) {
            cout << "Элемент " << i + 1 << ":\n";
            cin >> a;
            insert_sorted(a); // вставка с сохранением порядка
        }
    }

    // конструктор копирования
    MultiSetContainer(const MultiSetContainer& other) : data(nullptr), size(other.size), capacity(other.capacity) {
        if (capacity > 0) {
            data = new T[capacity];
            for (int i = 0; i < size; ++i)
                data[i] = other.data[i];
        }
    }

    // оператор присваивания
    MultiSetContainer& operator=(const MultiSetContainer& other) {
        if (this != &other) {
            delete[] data;
            size = other.size;
            capacity = other.capacity;
            data = new T[capacity];
            for (int i = 0; i < size; ++i)
                data[i] = other.data[i];
        }
        return *this;
    }

    // деструктор
    ~MultiSetContainer() {
        delete[] data;
    }

    // метод печати содержимого контейнера (константный, не изменяет объект)
    void Print() const {
        for (int i = 0; i < size; ++i)
            cout << data[i] << " ";
        cout << endl;
    }

    // метод поиска минимального элемента (возвращает копию минимума)
    T FindMin() const {
        if (size == 0) return T(); // если контейнер пуст – возвращаем значение по умолчанию (конструктор без параметров)
        return data[0]; // так как массив отсортирован, первый элемент минимальный
    }

    // метод добавления минимального элемента в контейнер (вставка копии)
    void AddMinToEnd() {
        if (size == 0) return;
        insert_sorted(FindMin()); // вставляем копию минимума с сохранением порядка
    }

    // метод удаления первого вхождения элемента с заданным ключом (значением)
    bool DeleteByKey(const T& key) {
        int pos = lower_bound_position(key);
        if (pos < size && data[pos] == key) {
            // сдвиг элементов влево
            for (int i = pos; i < size - 1; ++i)
                data[i] = data[i + 1];
            --size;
            return true;
        }
        return false;
    }

    // метод прибавления к каждому элементу суммы минимального и максимального элементов контейнера
    void AddSumMinMax() {
        if (size == 0) return;
        T minv = data[0];
        T maxv = data[size - 1];
        T sum = minv + maxv;

        // создаём временный массив с изменёнными значениями
        T* temp = new T[size];
        for (int i = 0; i < size; ++i)
            temp[i] = data[i] + sum;
        delete[] data;
        data = temp;
        // пересортировка
        for (int i = 0; i < size - 1; ++i) {
            for (int j = 0; j < size - i - 1; ++j) {
                if (data[j] > data[j + 1]) {
                    T t = data[j];
                    data[j] = data[j + 1];
                    data[j + 1] = t;
                }
            }
        }
        // ёмкость оставляем прежней
    }
};



