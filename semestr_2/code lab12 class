#include <iostream>
#include <set>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <algorithm>
using namespace std;

typedef multiset<float> TMultiSet; // определение псевдонима TMultiSet для типа multiset<float>

// функция формирования multiset из n случайных вещественных чисел типа float
TMultiSet make_multiset(int n) {
    TMultiSet ms; // создаём пустой контейнер multiset
    for (int i = 0; i < n; ++i) {
        float val = (float)(rand() % 100) / 10.0f - 5.0f; // генерация случайного числа в диапазоне [-5.0, 4.9]
        ms.insert(val); // вставка сгенерированного значения в multiset (автоматически упорядочивается по возрастанию)
    }
    return ms; // возвращаем заполненный multiset
}

// функция печати multiset (принимает константную ссылку, чтобы не копировать)
void print_multiset(const TMultiSet& ms) {
    for (float x : ms) // перебираем все элементы в порядке возрастания
        cout << x << " ";
    cout << endl;
}

// функция поиска минимального элемента в multiset
float find_min(const TMultiSet& ms) {
    if (ms.empty()) return 0;
    return *ms.begin(); // так как multiset упорядочен по возрастанию, begin() указывает на минимальный элемент
}

// функция добавления минимального элемента в контейнер (вставка копии)
void add_min_to_end(TMultiSet& ms) {
    if (ms.empty()) return; // ксли контейнер пуст – ничего не делаем
    ms.insert(find_min(ms)); // находим минимальный элемент и вставляем его копию (дубликат)
}

// функция удаления первого вхождения элемента с заданным ключом (значением)
bool delete_by_key(TMultiSet& ms, float key) {
    auto it = ms.find(key); // ищем итератор на первый элемент, равный key (find возвращает итератор или end())
    if (it != ms.end()) { // если элемент найден (итератор не указывает на конец)
        ms.erase(it); // удаляем элемент по этому итератору
        return true;
    }
    return false;
}

// функция добавления к каждому элементу суммы минимального и максимального элементов контейнера
void add_sum_min_max(TMultiSet& ms) {
    if (ms.empty()) return;
    float min_val = *ms.begin(); // минимальный элемент (первый в упорядоченном множестве)
    float max_val = *ms.rbegin(); // максимальный элемент (последний, rbegin() – обратный итератор на конец)
    float sum = min_val + max_val;

    vector<float> temp(ms.begin(), ms.end()); // создаём вектор из всех элементов multiset (копируем)
    ms.clear(); // очищаем исходный multiset
    for (float& x : temp) { // перебираем элементы вектора по ссылке
        x += sum;
        ms.insert(x); // вставляем изменённый элемент обратно в multiset (автоматически упорядочится)
    }
}

int main() {
    setlocale(LC_ALL, "ru");
    srand((unsigned)time(0));

    int n;
    cout << "Размер multiset: "; cin >> n;
    TMultiSet ms = make_multiset(n);
    cout << "Исходный: "; print_multiset(ms);

    add_min_to_end(ms);
    cout << "После добавления min в конец: "; print_multiset(ms);

    float key;
    cout << "Ключ для удаления: "; cin >> key;
    if (delete_by_key(ms, key)) {
        cout << "После удаления: "; print_multiset(ms);
    }
    else {
        cout << "Элемент не найден\n";
    }

    add_sum_min_max(ms);
    cout << "После + (min+max): "; print_multiset(ms);

    return 0;
}



