// 1. Алгоритм Бойера-Мура
int boyerMooreSearch(const string& text, const string& pattern, bool showSteps = true) {
    int n = text.length(), m = pattern.length();
    if (m == 0 || m > n) return -1;

    // таблица символов
    int table[256];
    for (int i = 0; i < 256; i++) table[i] = m; // инициализация таблицы: по умолчанию сдвиг = длине образца
    for (int i = 0; i < m - 1; i++) table[(unsigned char)pattern[i]] = m - 1 - i; // заполняем таблицу для символов, встречающихся в образце; i < m-1 - последний символ не учитывается (сдвиг для него = m)

    if (showSteps) {
        cout << "\n=== АЛГОРИТМ БОЙЕРА-МУРА ===\n";
        cout << "Текст: " << text << "\nОбразец: " << pattern << "\n\n";
    }

    int pos = m - 1, step = 0; // начальная позиция - последний символ образца; счётчик шагов
    while (pos < n) {
        step++;
        int i = m - 1;

        if (showSteps) {
            cout << "Шаг " << step << " (позиция " << pos << "):\n";
            cout << "  " << text << "\n  ";
            for (int k = 0; k < pos - m + 1; k++) cout << " ";
            for (int k = 0; k < m; k++) cout << pattern[k];
            cout << "\n";
        }

        // сравнение справа налево; pattern[i] сравниваем с text[pos - (m - 1 - i)]; pos - (m - 1 - i) - это позиция в тексте, соответствующая текущему символу образца
        while (i >= 0 && pattern[i] == text[pos - (m - 1 - i)]) i--; // если совпало - двигаемся дальше влево

        if (i == -1) { // если дошли до начала образца (i == -1) - нашли полное совпадение
            int result = pos - m + 1; // вычисляем начальную позицию совпадения
            if (showSteps) cout << "  >>> НАЙДЕНО на позиции " << result << " <<<\n";
            return result;
        }

        int shift = table[(unsigned char)text[pos - (m - 1 - i)]]; // если не совпало - вычисляем сдвиг по таблице символов; используем символ из текста, на котором произошло несовпадение
        if (showSteps) cout << "  Несовпадение: '" << text[pos - (m - 1 - i)] << "' ≠ '" << pattern[i]
            << "', сдвиг = " << shift << "\n\n";
        pos += shift; // сдвигаем образец вправо на вычисленное значение
    }

    if (showSteps) cout << "  >>> НЕ НАЙДЕНО <<<\n";
    return -1;
}

// 2. Алгоритм Бойера-Мура-Хорспула
int horspoolSearch(const string& text, const string& pattern, bool showSteps = true) {
    int n = text.length(), m = pattern.length();
    if (m == 0 || m > n) return -1;

    // этап 1: формирование таблицы смещений
    int table[256];
    for (int i = 0; i < 256; i++) table[i] = m; // по умолчанию сдвиг = длине подстроки

    // для каждого символа в подстроке (кроме последнего) определяем смещение
    for (int i = 0; i < m - 1; i++) {
        table[(unsigned char)pattern[i]] = m - 1 - i; // расстояние от позиции символа до конца подстроки
    }

    if (showSteps) {
        cout << "\n=== АЛГОРИТМ БОЙЕРА-МУРА-ХОРСПУЛА ===\n";
        cout << "Текст: " << text << "\nОбразец: " << pattern << "\n\n";

        cout << "Таблица смещений:\n";
        for (int i = 32; i <= 126; i++) {
            if (table[i] != m) {
                cout << "  '" << (char)i << "' = " << table[i] << endl;
            }
        }
        cout << "  остальные символы = " << m << "\n\n";
    }

    // этап 2: поиск подстроки
    int pos = 0, step = 0;

    while (pos <= n - m) {
        step++;
        int i = m - 1; // начинаем с последнего символа

        if (showSteps) {
            cout << "Шаг " << step << " (позиция " << pos << "):\n";
            cout << "  " << text << "\n  ";
            for (int k = 0; k < pos; k++) cout << " ";
            for (int k = 0; k < m; k++) cout << pattern[k];
            cout << "\n";
            cout << "  Сравниваем справа налево:\n";
        }

        // сравниваем символы справа налево; в отличие от Бойера-Мура, используем простое сложение: text[pos + i]
        while (i >= 0 && pattern[i] == text[pos + i]) {
            if (showSteps) {
                cout << "    text[" << pos + i << "] = '" << text[pos + i]
                    << "' = pattern[" << i << "] = '" << pattern[i] << "' ✓\n";
            }
            i--; // если совпало - двигаемся влево
        }

        // если все символы совпали
        if (i < 0) {
            if (showSteps) cout << "\n  >>> НАЙДЕНО! Позиция " << pos << " <<<\n";
            return pos; // возвращаем позицию начала совпадения
        }

        // несовпадение - определяем сдвиг по последнему символу окна
        if (showSteps) {
            cout << "    text[" << pos + i << "] = '" << text[pos + i]
                << "' ≠ pattern[" << i << "] = '" << pattern[i] << "' ✗\n";
        }

        // важно: используем последний символ текущего фрагмента текста, который в данный момент сравнивается с образцом, для сдвига
        char lastChar = text[pos + m - 1]; // последний символ текущего фрагмента
        int shift = table[(unsigned char)lastChar]; // сдвиг из таблицы

        if (showSteps) {
            cout << "  Последний символ фрагмента текста: '" << lastChar << "'\n";
            cout << "  Сдвиг по таблице: " << shift << "\n";
            cout << "  Новая позиция: " << pos + shift << "\n\n";
        }

        pos += shift; // сдвигаем фрагмент вправо
    }

    if (showSteps) cout << "  >>> НЕ НАЙДЕНО <<<\n";
    return -1; 
}

// 3. Алгоритм Кнута-Морисса-Пратта
void buildPrefix(const string& p, int* pi) { // функция для вычисления префикс - функции(Pi - функции) для образца; p - строка-образец
    pi[0] = 0; // pi - массив для хранения префикс-функции; для первого элемента префикс-функция всегда 0
    int j = 0; // длина текущего префикса-суффикса
    for (int i = 1; i < p.length(); i++) { // проходим по всем символам образца, начиная со второго
        while (j > 0 && p[i] != p[j]) j = pi[j - 1]; // пока j > 0 и символы не совпадают, откатываем j; откат по префикс-функции
        if (p[i] == p[j]) j++; // если символы совпали - увеличиваем длину префикса
        pi[i] = j; // сохраняем значение префикс-функции для позиции i
    }
}

int kmpSearch(const string& text, const string& pattern, bool showSteps = true) {
    int n = text.length(), m = pattern.length();
    if (m == 0 || m > n) return -1;

    int* pi = new int[m]; // выделяем память для префикс-функции
    buildPrefix(pattern, pi);

    if (showSteps) {
        cout << "\n=== АЛГОРИТМ КНУТА-МОРИССА-ПРАТТА ===\n";
        cout << "Текст: " << text << "\nОбразец: " << pattern << "\n";
        cout << "Префикс-функция: ";
        for (int i = 0; i < m; i++) cout << pi[i] << " ";
        cout << "\n\n";
    }

    int j = 0, step = 0; // индекс в образце и счётчик шагов
    for (int i = 0; i < n; i++) { // проходим по всем символам текста
        step++;
        while (j > 0 && text[i] != pattern[j]) { // пока не совпадает и j не в начале - откатываем j
            if (showSteps) cout << "  Шаг " << step << ": несовпадение text[" << i << "]='" << text[i]
                << "', откат j=" << pi[j - 1] << "\n";
            j = pi[j - 1]; // откат по префикс-функции
        }
        if (text[i] == pattern[j]) { // если символы совпадают
            if (showSteps) cout << "  Шаг " << step << ": совпадение text[" << i << "]='" << text[i] << "'\n";
            j++; // увеличиваем индекс в образце
        }
        if (j == m) { // если нашли полное совпадение (j == m)
            if (showSteps) cout << "  >>> НАЙДЕНО на позиции " << i - m + 1 << " <<<\n"; // вычисляем начальную позицию
            delete[] pi; // освобождаем память
            return i - m + 1;
        }
    }

    if (showSteps) cout << "  >>> НЕ НАЙДЕНО <<<\n";
    delete[] pi;
    return -1;
}

