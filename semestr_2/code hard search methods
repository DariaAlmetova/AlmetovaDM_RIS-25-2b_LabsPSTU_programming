    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    setlocale(LC_ALL, "ru");

    string texts[] = {
        "абракадабра абра абракадабра",
        "Это пример текста для поиска подстроки в строке",
        "to be or not to be that is the question"
    };
    string patterns[] = { "абра", "поиска", "to be" };

    cout << "========================================\n";
    cout << "   АЛГОРИТМЫ ПОИСКА ПОДСТРОКИ\n";
    cout << "========================================\n";

    for (int i = 0; i < 3; i++) {
        cout << "\n--- НАБОР " << i + 1 << " ---\n";
        cout << "Текст: " << texts[i] << "\n";
        cout << "Поиск: " << patterns[i] << "\n";

        boyerMooreSearch(texts[i], patterns[i], true);
        horspoolSearch(texts[i], patterns[i], true);
        kmpSearch(texts[i], patterns[i], true);
    }

    cout << "\n========================================\n";
    cout << "   ПОЛЬЗОВАТЕЛЬСКИЙ ВВОД\n";
    cout << "========================================\n";

    string text, pattern;
    cout << "Введите строку: ";
    cin.ignore();
    getline(cin, text);
    cout << "Введите подстроку: ";
    getline(cin, pattern);

    if (!text.empty() && !pattern.empty()) {
        cout << "\n--- РЕЗУЛЬТАТЫ ---\n";
        boyerMooreSearch(text, pattern, true);
        horspoolSearch(text, pattern, true);
        kmpSearch(text, pattern, true);
    }

    return 0;
}
