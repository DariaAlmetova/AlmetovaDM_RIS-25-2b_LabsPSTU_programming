// 1. Линейный поиск
int linearSearch(int mass[], int key, const int n) {
    int count = 0; // счетчик найденных элементов
    cout << "--- Линейный поиск ---" << endl;
    cout << "Поиск элемента со значением " << key << ":" << endl;

    for (int i = 0; i < n; i++) {
        cout << "Шаг " << i + 1 << ": проверяем элемент mass[" << i << "] = " << mass[i];
        if (mass[i] == key) {
            cout << " -> СОВПАДЕНИЕ! (найден на позиции " << i + 1 << ")" << endl;
            count++;
        }
        else {
            cout << " -> не совпадает" << endl;
        }
    }

    cout << "Результат: найдено " << count << " элементов со значением " << key << endl;
    return count;
}

// 2. Бинарный поиск (возвращает позицию + 1 для нумерации с 1)
int binarySearch(int mass[], int key, const int n) {
    int left = 0;
    int right = n - 1;
    int step = 0;

    cout << "--- Бинарный поиск ---" << endl;
    cout << "Поиск элемента со значением " << key << ":" << endl;

    while (left <= right) {
        step++;
        int middle = (left + right) / 2;

        cout << "Шаг " << step << ": left=" << left << " (значение " << mass[left]
            << "), right=" << right << " (значение " << mass[right]
            << "), middle=" << middle << " (значение " << mass[middle] << ")" << endl;

        if (mass[middle] == key) {
            cout << ">>> Элемент найден на позиции " << middle + 1 << "! <<<" << endl;
            return middle + 1; // возвращаем номер (с 1)
        }
        else if (mass[middle] < key) {
            cout << "   -> Искомое больше, ищем в правой половине" << endl;
            left = middle + 1;
        }
        else {
            cout << "   -> Искомое меньше, ищем в левой половине" << endl;
            right = middle - 1;
        }
    }

    cout << ">>> Элемент не найден! <<<" << endl;
    return -1;
}

// 3. Интерполяционный поиск
int interpolationSearch(int mass[], int key, const int n) {
    int left = 0;
    int right = n - 1;
    int step = 0;

    cout << "--- Интерполяционный поиск ---" << endl;
    cout << "Поиск элемента со значением " << key << ":" << endl;
    cout << "Формула: mid = left + ((key - mass[left]) * (right - left)) / (mass[right] - mass[left])" << endl;

    while (left <= right && key >= mass[left] && key <= mass[right]) {
        step++;

        // защита от деления на ноль
        if (mass[right] == mass[left]) break;

        int mid = left + ((key - mass[left]) * (right - left)) / (mass[right] - mass[left]);

        cout << "Шаг " << step << ": left=" << left << " (значение " << mass[left]
            << "), right=" << right << " (значение " << mass[right]
            << "), mid=" << mid << " (значение " << mass[mid] << ")" << endl;

        if (mass[mid] == key) {
            cout << ">>> Элемент найден на позиции " << mid + 1 << "! <<<" << endl;
            return mid + 1;
        }
        else if (mass[mid] < key) {
            cout << "   -> Искомое больше, ищем в правой части" << endl;
            left = mid + 1;
        }
        else {
            cout << "   -> Искомое меньше, ищем в левой части" << endl;
            right = mid - 1;
        }
    }

    cout << ">>> Элемент не найден! <<<" << endl;
    return -1;
}

// аналитическое пояснение для интерполяционного поиска
void interpolationAnalytical() {
    cout << "\n--- Аналитическое пояснение интерполяционного поиска ---" << endl;
    cout << "Интерполяционный поиск использует формулу нахождения промежуточного элемента:" << endl;
    cout << "mid = left + ((key - mass[left]) * (right - left)) / (mass[right] - mass[left])" << endl;
    cout << "Эта формула получена из уравнения прямой, проходящей через точки:" << endl;
    cout << "(left, mass[left]) и (right, mass[right])" << endl;
    cout << "Каноническое уравнение прямой: (y - y0)/(y1 - y0) = (x - x0)/(x1 - x0)" << endl;
    cout << "где x0 = left, y0 = mass[left], x1 = right, y1 = mass[right], y = key" << endl;
    cout << "Решая относительно x, получаем формулу для mid\n" << endl;
}

// 4. Поиск подстроки в строке
void substringSearch(const string& text, const string& pattern) {
    int n = text.length();
    int m = pattern.length();

    cout << "--- Поиск подстроки в строке ---" << endl;
    cout << "Исходная строка: \"" << text << "\"" << endl;
    cout << "Искомая подстрока: \"" << pattern << "\"" << endl;
    cout << "Длина строки: " << n << ", длина подстроки: " << m << "\n" << endl;

    if (m > n) {
        cout << "ОШИБКА: Подстрока длиннее строки! Поиск невозможен." << endl;
        return;
    }

    bool found = false;

    // проверяем все возможные стартовые позиции
    for (int i = 0; i <= n - m; i++) {
        cout << "--------------------------------------------------" << endl;
        cout << "ШАГ " << i + 1 << ": Проверка позиции " << i << endl;
        cout << "--------------------------------------------------" << endl;

        // визуализация текущего положения
        cout << "Текст:   ";
        for (int k = 0; k < n; k++) {
            if (k == i) cout << "[";
            cout << text[k];
            if (k == i + m - 1) cout << "]";
            else if (k > i && k < i + m) cout << "";
            else cout << " ";
        }
        cout << endl;

        cout << "Проверка: ";
        for (int k = 0; k < i; k++) cout << "  ";
        for (int k = 0; k < m; k++) cout << pattern[k] << " ";
        cout << "\n" << endl;

        // пошаговое сравнение символов
        bool match = true;
        cout << "Посимвольное сравнение:" << endl;

        for (int j = 0; j < m; j++) {
            cout << "   Сравниваем текст[" << i + j << "] = '" << text[i + j]
                << "' с шаблоном[" << j << "] = '" << pattern[j] << "' → ";

            if (text[i + j] == pattern[j]) {
                cout << "СОВПАДАЕТ";
                if (j == m - 1) cout << " (последний символ)";
                cout << endl;
            }
            else {
                cout << "НЕ СОВПАДАЕТ -> поиск на этой позиции прекращен" << endl;
                match = false;
                break;
            }
        }

        // вывод результата для текущей позиции
        if (match) {
            cout << "\nНАЙДЕНО! Полное совпадение на позиции " << i << endl;
            cout << "   Подстрока \"" << pattern << "\" начинается с индекса " << i << endl;
            found = true;
        }
        else {
            cout << "\nНа позиции " << i << " совпадения нет" << endl;
        }
        cout << endl;
    }

    // итоговый результат
    cout << "--------------------------------------------------" << endl;
    cout << "ИТОГОВЫЙ РЕЗУЛЬТАТ: ";
    if (found) {
        cout << "Подстрока найдена в тексте!" << endl;
    }
    else {
        cout << "Подстрока НЕ найдена в тексте!" << endl;
    }
    cout << "--------------------------------------------------" << endl;
}

int main() {
    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    setlocale(LC_ALL, "ru");

    cout << "================================================" << endl;
    cout << "   ПРОГРАММА ДЕМОНСТРАЦИИ МЕТОДОВ ПОИСКА" << endl;
    cout << "================================================\n" << endl;

    // тест 1-3: поиск в массиве
    cout << "ЧАСТЬ 1: ПОИСК ЭЛЕМЕНТА В МАССИВЕ" << endl;
    cout << "----------------------------------------" << endl;

    const int n = 10;

    // Массив для линейного поиска (неотсортированный)
    int massLinear[n] = { 4, 0, 11, -13, -2, 6, 10, 99, 50, 77 };

    // Массив для бинарного и интерполяционного поиска (отсортированный)
    int massSorted[n] = { 1, 5, 14, 26, 32, 56, 91, 113, 115, 204 };

    int key;

    cout << "Массив для линейного поиска (неотсортированный): ";
    for (int i = 0; i < n; i++) {
        cout << massLinear[i] << " ";
    }
    cout << "\nМассив для бинарного и интерполяционного поиска (отсортированный): ";
    for (int i = 0; i < n; i++) {
        cout << massSorted[i] << " ";
    }

    cout << "\n\nВведите ключ (искомое значение): ";
    cin >> key;
    cout << endl;

    // 1. Линейный поиск
    int count = linearSearch(massLinear, key, n);
    cout << "ЛИНЕЙНЫЙ ПОИСК: найдено " << count << " элементов со значением " << key << "\n" << endl;

    // 2. Бинарный поиск
    int pos = binarySearch(massSorted, key, n);
    if (pos != -1) {
        cout << "БИНАРНЫЙ ПОИСК: элемент найден на позиции " << pos << "\n" << endl;
    }
    else {
        cout << "БИНАРНЫЙ ПОИСК: элемент не найден\n" << endl;
    }

    // 3. Интерполяционный поиск
    int pos2 = interpolationSearch(massSorted, key, n);
    if (pos2 != -1) {
        cout << "ИНТЕРПОЛЯЦИОННЫЙ ПОИСК: элемент найден на позиции " << pos2 << "\n" << endl;
    }
    else {
        cout << "ИНТЕРПОЛЯЦИОННЫЙ ПОИСК: элемент не найден\n" << endl;
    }

    // аналитическое пояснение
    interpolationAnalytical();

    // тест 4: поиск подстроки
    cout << "\nЧАСТЬ 2: ПОИСК ПОДСТРОКИ В СТРОКЕ" << endl;
    cout << "----------------------------------------" << endl;

    string text, pattern;

    cout << "Введите основную строку: ";
    cin.ignore(); // очищаем буфер после ввода числа (в данном случае \n)
    getline(cin, text);

    cout << "Введите подстроку для поиска: ";
    getline(cin, pattern);

    cout << endl;

    // проверка на пустые строки
    if (text.empty() || pattern.empty()) {
        cout << "ОШИБКА: Строка или подстрока не могут быть пустыми!" << endl;
        return 1;
    }

    // вызов функции поиска подстроки
    substringSearch(text, pattern);

    cout << "\n================================================" << endl;
    cout << "   РАБОТА ПРОГРАММЫ ЗАВЕРШЕНА" << endl;
    cout << "================================================" << endl;

    return 0;
}
