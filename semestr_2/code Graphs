// Генерация последовательностей шагов

// DFS: пошаговая рекурсивная реализация
void MainWindow::generateDFSSteps(int start)
{
    algorithmSteps.clear();
    size_t n = graph->nodeCount();
    std::vector<bool> visited(n, false);
    std::vector<int> order;

    std::function<void(int)> dfsVisit;
    dfsVisit = [&](int v) {
        visited[v] = true;
        order.push_back(v);
        algorithmSteps.push_back(AlgorithmStep{
            QString("Посещаем вершину %1").arg(graph->nodeNames()[v]),
            {v}, {}
        });

        // Собираем соседей в порядке возрастания индексов
        std::vector<int> neighbors;
        for (size_t i = 0; i < n; ++i) {
            if (graph->getWeight(v, (int)i) != -1) {
                neighbors.push_back((int)i);
            }
        }

        for (int neighbor : neighbors) {
            algorithmSteps.push_back(AlgorithmStep{
                QString("Рассматриваем соседа %1 (ребро %2→%3)")
                    .arg(graph->nodeNames()[neighbor])
                    .arg(graph->nodeNames()[v])
                    .arg(graph->nodeNames()[neighbor]),
                {v, neighbor},
                {{v, neighbor}}
            });

            if (!visited[neighbor]) {
                dfsVisit(neighbor); // Рекурсивный вызов
            } else {
                algorithmSteps.push_back(AlgorithmStep{
                    QString("Вершина %1 уже посещена.").arg(graph->nodeNames()[neighbor]),
                    {neighbor}, {}
                });
            }
        }
        algorithmSteps.push_back(AlgorithmStep{
            QString("Возврат из вершины %1").arg(graph->nodeNames()[v]),
            {v}, {}
        });
    };

    algorithmSteps.push_back(AlgorithmStep{
        QString("Начинаем обход DFS от вершины %1").arg(graph->nodeNames()[start]),
        {start}, {}
    });
    dfsVisit(start);

    // Итоговый шаг: порядок обхода
    QString result = "Итог DFS. Порядок обхода: ";
    for (size_t i = 0; i < order.size(); ++i) {
        result += graph->nodeNames()[order[i]];
        if (i != order.size() - 1) result += ", ";
    }
    algorithmSteps.push_back(AlgorithmStep{result, {}, {}});
}

// BFS: пошаговая реализация с очередью
void MainWindow::generateBFSSteps(int start)
{
    algorithmSteps.clear();
    size_t n = graph->nodeCount();
    std::vector<bool> visited(n, false);
    std::queue<int> q;
    std::vector<int> order;

    visited[start] = true;
    q.push(start);
    algorithmSteps.push_back(AlgorithmStep{
        QString("Помещаем в очередь вершину %1 и посещаем её").arg(graph->nodeNames()[start]),
        {start}, {}
    });

    while (!q.empty()) {
        int v = q.front(); q.pop();
        order.push_back(v);
        algorithmSteps.push_back(AlgorithmStep{
            QString("Извлекаем из очереди вершину %1").arg(graph->nodeNames()[v]),
            {v}, {}
        });

        for (size_t i = 0; i < n; ++i) {
            if (graph->getWeight(v, (int)i) != -1) {
                int neighbor = (int)i;
                algorithmSteps.push_back(AlgorithmStep{
                    QString("Рассматриваем соседа %1 (ребро %2→%3)")
                        .arg(graph->nodeNames()[neighbor])
                        .arg(graph->nodeNames()[v])
                        .arg(graph->nodeNames()[neighbor]),
                    {v, neighbor},
                    {{v, neighbor}}
                });

                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.push(neighbor);
                    algorithmSteps.push_back(AlgorithmStep{
                        QString("Вершина %1 не посещена, добавляем в очередь.").arg(graph->nodeNames()[neighbor]),
                        {neighbor}, {}
                    });
                } else {
                    algorithmSteps.push_back(AlgorithmStep{
                        QString("Вершина %1 уже посещена.").arg(graph->nodeNames()[neighbor]),
                        {neighbor}, {}
                    });
                }
            }
        }
    }

    QString result = "Итог BFS. Порядок обхода: ";
    for (size_t i = 0; i < order.size(); ++i) {
        result += graph->nodeNames()[order[i]];
        if (i != order.size() - 1) result += ", ";
    }
    algorithmSteps.push_back(AlgorithmStep{result, {}, {}});
}

// Дейкстра: пошаговая релаксация
void MainWindow::generateDijkstraSteps(int start)
{
    algorithmSteps.clear();
    size_t n = graph->nodeCount();
    const int INF = 1e9;
    std::vector<int> dist(n, INF);
    std::vector<int> parent(n, -1);
    std::vector<bool> used(n, false);
    dist[start] = 0;

    algorithmSteps.push_back(AlgorithmStep{
        QString("Инициализация: dist[%1] = 0, остальные ∞").arg(graph->nodeNames()[start]),
        {start}, {}
    });

    for (size_t iter = 0; iter < n; ++iter) {
        int u = -1;
        for (size_t i = 0; i < n; ++i) {
            if (!used[i] && (u == -1 || dist[i] < dist[u])) {
                u = (int)i;
            }
        }
        if (u == -1 || dist[u] == INF) break;

        algorithmSteps.push_back(AlgorithmStep{
            QString("Выбрана непосещённая вершина %1 с минимальным расстоянием %2")
                .arg(graph->nodeNames()[u]).arg(dist[u]),
            {u}, {}
        });

        used[u] = true;
        for (size_t v = 0; v < n; ++v) {
            int w = graph->getWeight(u, (int)v);
            if (w != -1) {
                int newDist = dist[u] + w;
                algorithmSteps.push_back(AlgorithmStep{
                    QString("Проверяем соседа %1 (вес %2): dist[%3] = min(%4, %5)")
                        .arg(graph->nodeNames()[v]).arg(w)
                        .arg(graph->nodeNames()[v])
                        .arg(dist[v] == INF ? "∞" : QString::number(dist[v]))
                        .arg(newDist),
                    {u, (int)v},
                    {{u, (int)v}}
                });

                if (newDist < dist[v]) {
                    dist[v] = newDist;
                    parent[v] = u;
                    algorithmSteps.push_back(AlgorithmStep{
                        QString("Обновление: dist[%1] = %2").arg(graph->nodeNames()[v]).arg(newDist),
                        {(int)v}, {{u, (int)v}}
                    });
                } else {
                    algorithmSteps.push_back(AlgorithmStep{
                        QString("Без изменений (текущее значение %1 <= %2)").arg(dist[v]).arg(newDist),
                        {}, {}
                    });
                }
            }
        }
    }

    // Итоговый вывод расстояний и путей
    QString result = "Итог Дейкстры от вершины " + graph->nodeNames()[start] + ":\n";
    for (size_t i = 0; i < n; ++i) {
        result += graph->nodeNames()[i] + ": ";
        if (dist[i] == INF) {
            result += "недостижима";
        } else {
            result += QString::number(dist[i]) + " (путь: ";
            std::vector<int> path;
            for (int v = (int)i; v != -1; v = parent[v])
                path.push_back(v);
            std::reverse(path.begin(), path.end());
            for (size_t j = 0; j < path.size(); ++j) {
                result += graph->nodeNames()[path[j]];
                if (j != path.size() - 1) result += " → ";
            }
            result += ")";
        }
        result += "\n";
    }
    algorithmSteps.push_back(AlgorithmStep{result, {}, {}});
}

// Флойд: исходная матрица, итерации, итоговая матрица
void MainWindow::generateFloydSteps()
{
    algorithmSteps.clear();
    size_t n = graph->nodeCount();
    const int INF = 1e9;

    // Инициализация матрицы D
    std::vector<std::vector<int>> D(n, std::vector<int>(n, INF));
    for (size_t i = 0; i < n; ++i) {
        for (size_t j = 0; j < n; ++j) {
            if (i == j) D[i][j] = 0;
            else {
                int w = graph->getWeight((int)i, (int)j);
                D[i][j] = (w == -1) ? INF : w;
            }
        }
    }

    // Исходная матрица
    QString initMatrix = "Исходная матрица расстояний:\n    ";
    for (size_t j = 0; j < n; ++j)
        initMatrix += QString("%1 ").arg(graph->nodeNames()[j], 3);
    initMatrix += "\n";
    for (size_t i = 0; i < n; ++i) {
        initMatrix += QString("%1 ").arg(graph->nodeNames()[i], 3);
        for (size_t j = 0; j < n; ++j) {
            if (i == j) initMatrix += " 0 ";
            else {
                int w = graph->getWeight((int)i, (int)j);
                if (w == -1) initMatrix += " ∞ ";
                else initMatrix += QString("%1 ").arg(w, 3);
            }
        }
        initMatrix += "\n";
    }
    algorithmSteps.push_back(AlgorithmStep{initMatrix, {}, {}});

    // Итерации алгоритма
    for (size_t k = 0; k < n; ++k) {
        algorithmSteps.push_back(AlgorithmStep{
            QString("Итерация k = %1 (разрешена вершина %2)").arg(k + 1).arg(graph->nodeNames()[(int)k]),
            {(int)k}, {}
        });

        for (size_t i = 0; i < n; ++i) {
            for (size_t j = 0; j < n; ++j) {
                if (i == j || i == k || j == k) continue;
                int oldDist = D[i][j];
                if (D[i][k] < INF && D[k][j] < INF) {
                    int newDist = D[i][k] + D[k][j];
                    if (newDist < oldDist) {
                        D[i][j] = newDist;

                        // Подсвечиваем рёбра, если они прямые
                        std::vector<std::pair<int,int>> edges;
                        if (graph->getWeight((int)i, (int)k) != -1)
                            edges.push_back({(int)i, (int)k});
                        if (graph->getWeight((int)k, (int)j) != -1)
                            edges.push_back({(int)k, (int)j});

                        algorithmSteps.push_back(AlgorithmStep{
                            QString("Улучшение: D[%1][%2] = %3 (путь %1 → %4 → %2)")
                                .arg(graph->nodeNames()[(int)i])
                                .arg(graph->nodeNames()[(int)j])
                                .arg(newDist)
                                .arg(graph->nodeNames()[(int)k]),
                            {(int)i, (int)j, (int)k},
                            edges
                        });
                    }
                }
            }
        }

        algorithmSteps.push_back(AlgorithmStep{
            QString("Итерация k = %1 завершена.").arg(k + 1),
            {}, {}
        });
    }

    // Итоговая матрица
    QString result = "Итоговая матрица кратчайших расстояний:\n    ";
    for (size_t j = 0; j < n; ++j)
        result += QString("%1 ").arg(graph->nodeNames()[j], 3);
    result += "\n";
    for (size_t i = 0; i < n; ++i) {
        result += QString("%1 ").arg(graph->nodeNames()[i], 3);
        for (size_t j = 0; j < n; ++j) {
            if (D[i][j] == INF)
                result += " - ";
            else
                result += QString("%1 ").arg(D[i][j], 3);
        }
        result += "\n";
    }
    algorithmSteps.push_back(AlgorithmStep{result, {}, {}});
}

// Пошаговая навигация
void MainWindow::onStepForward()
{
    if (algorithmSteps.empty() || currentStepIndex >= (int)algorithmSteps.size() - 1) return;
    currentStepIndex++;
    showCurrentStep();
}

void MainWindow::onStepBackward()
{
    if (algorithmSteps.empty() || currentStepIndex <= 0) return;
    currentStepIndex--;
    showCurrentStep();
}

// Отображение одного шага
void MainWindow::showCurrentStep()
{
    if (currentStepIndex < 0 || currentStepIndex >= (int)algorithmSteps.size()) return;

    const AlgorithmStep& step = algorithmSteps[currentStepIndex];
    stepLabel->setText(QString("Шаг %1 / %2").arg(currentStepIndex + 1).arg(algorithmSteps.size()));
    outputText->clear();
    outputText->append(step.description);
    visuals->visualizeStep(step.highlightedVertices, step.highlightedEdges);
}
