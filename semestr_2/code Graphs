GraphVisuals::GraphVisuals(QGraphicsScene *scene, QGraphicsView *view, Graph *graph)
    : scene(scene), view(view), graph(graph)
{
}

// Полная перерисовка графа в обычном режиме
void GraphVisuals::redraw()
{
    scene->clear();
    size_t n = graph->nodeCount();
    if (n == 0) return;

    if (positions.size() != n)
        assignCircularPositions();

    drawBaseGraph(); // Рисуем все рёбра и вершины
    fitToView(); // Подгоняем масштаб
}

// Визуализация одного шага алгоритма: сначала рёбра, потом вершины, потом подсветка
void GraphVisuals::visualizeStep(const std::vector<int>& vertices,
                                 const std::vector<std::pair<int,int>>& edges)
{
    scene->clear();
    size_t n = graph->nodeCount();
    if (n == 0) return;

    if (positions.size() != n)
        assignCircularPositions();

    // 1. Все обычные рёбра (чёрные, без подсветки)
    for (size_t i = 0; i < n; ++i) {
        for (size_t j = 0; j < n; ++j) {
            if (graph->getWeight((int)i, (int)j) != -1) {
                drawEdge((int)i, (int)j, Qt::black, 1);
            }
        }
    }

    // 2. Вершины: обычные (розовая обводка, белая заливка) или подсвеченные (светло-розовая заливка, красная обводка)
    for (size_t i = 0; i < n; ++i) {
        QPointF center = positions[i];
        bool highlighted = false;
        for (int v : vertices) {
            if (v == (int)i) {
                highlighted = true;
                break;
            }
        }
        if (highlighted) {
            // Подсвеченная вершина
            scene->addEllipse(center.x() - 25, center.y() - 25, 50, 50,
                              QPen(Qt::red, 3), QBrush(QColor("lightpink")));
            QGraphicsTextItem *label = scene->addText(graph->nodeNames()[(int)i]);
            label->setFont(QFont("Arial", 10, QFont::Bold));
            QRectF rect = label->boundingRect();
            label->setPos(center.x() - rect.width() / 2, center.y() - rect.height() / 2);
        } else {
            // Обычная вершина
            scene->addEllipse(center.x() - 25, center.y() - 25, 50, 50,
                              QPen(QColor("hotpink"), 2), QBrush(Qt::white));
            QGraphicsTextItem *label = scene->addText(graph->nodeNames()[(int)i]);
            label->setFont(QFont("Arial", 10));
            QRectF rect = label->boundingRect();
            label->setPos(center.x() - rect.width() / 2, center.y() - rect.height() / 2);
        }
    }

    // 3. Подсвеченные рёбра (красным, поверх вершин)
    for (const auto& e : edges) {
        drawEdge(e.first, e.second, Qt::red, 3);
    }

    fitToView();
}

// Рисование базового графа (все рёбра чёрным, вершины с розовой обводкой)
void GraphVisuals::drawBaseGraph()
{
    size_t n = graph->nodeCount();
    for (size_t i = 0; i < n; ++i) {
        for (size_t j = 0; j < n; ++j) {
            if (graph->getWeight((int)i, (int)j) != -1) {
                drawEdge((int)i, (int)j, Qt::black, 1);
            }
        }
    }
    for (size_t i = 0; i < n; ++i) {
        QPointF center = positions[i];
        scene->addEllipse(center.x() - 25, center.y() - 25, 50, 50,
                          QPen(QColor("hotpink"), 2), QBrush(Qt::white));
        QGraphicsTextItem *label = scene->addText(graph->nodeNames()[(int)i]);
        label->setFont(QFont("Arial", 10));
        QRectF rect = label->boundingRect();
        label->setPos(center.x() - rect.width() / 2, center.y() - rect.height() / 2);
    }
}

// Расстановка вершин по окружности (радиус 150)
void GraphVisuals::assignCircularPositions()
{
    size_t n = graph->nodeCount();
    positions.resize(n);
    double radius = 150.0;
    QPointF center(0, 0);
    for (size_t i = 0; i < n; ++i) {
        double angle = 2.0 * M_PI * i / n;
        positions[i] = center + QPointF(radius * cos(angle), radius * sin(angle));
    }
}

// Масштабирование сцены под размер виджета
void GraphVisuals::fitToView()
{
    scene->setSceneRect(scene->itemsBoundingRect());
    view->resetTransform();
    view->fitInView(scene->sceneRect(), Qt::KeepAspectRatio);
}

// Рисует одно ребро (линия + стрелка + подпись веса).
// from индекс вершины-источника, to индекс вершины-назначения, color цвет линии и стрелки, boldness толщина (1 - обычное ребро, >1 - подсвеченное)
// Для обычных рёбер (boldness==1) подпись веса отображается тёмно-розовым, при встречных рёбрах выводится только одна подпись (для from < to).

void GraphVisuals::drawEdge(int from, int to, QColor color, int boldness)
{
    // Если петля (from == to) - рисуем специальный указатель для подсвеченных шагов алгоритмов
    if (from == to) {
        if (boldness > 1) {
            QPointF center = positions[from];
            QPointF tip = center + QPointF(-25, 0); // остриё на левой границе круга
            double arrowSize = 5 * boldness;
            QPointF p1 = tip + QPointF(-arrowSize, -arrowSize/2);
            QPointF p2 = tip + QPointF(-arrowSize, arrowSize/2);
            QPolygonF arrowHead;
            arrowHead << tip << p1 << p2;
            scene->addPolygon(arrowHead, QPen(color), QBrush(color));
        }
        return; // обычные петли не рисуем
    }

    QPointF pFrom = positions[from];
    QPointF pTo = positions[to];
    QLineF line(pFrom, pTo);

    double angle = atan2(line.dy(), line.dx());

    // Начальная и конечная точки линии (с учётом радиуса вершин = 25)
    QPointF start = pFrom + QPointF(25 * cos(angle), 25 * sin(angle));
    QPointF end   = pTo   - QPointF(25 * cos(angle), 25 * sin(angle));

    // Рисуем линию
    scene->addLine(QLineF(start, end), QPen(color, boldness));

    // Рисуем наконечник стрелки
    double arrowSize = boldness * 5;
    QPointF arrowP1 = end - QPointF(arrowSize * cos(angle - M_PI / 6),
                                    arrowSize * sin(angle - M_PI / 6));
    QPointF arrowP2 = end - QPointF(arrowSize * cos(angle + M_PI / 6),
                                    arrowSize * sin(angle + M_PI / 6));
    QPolygonF arrowHead;
    arrowHead << end << arrowP1 << arrowP2;
    scene->addPolygon(arrowHead, QPen(color), QBrush(color));

    // Подпись веса (только для обычных рёбер, boldness == 1)
    if (boldness == 1) {
        QPointF mid = (start + end) / 2.0;
        QPointF dir = end - start;
        double len = sqrt(dir.x() * dir.x() + dir.y() * dir.y());
        if (len == 0) return;
        QPointF unit = dir / len;
        QPointF perp(-unit.y(), unit.x());
        double offset = 18.0;

        int w = graph->getWeight(from, to);
        int wReverse = graph->getWeight(to, from);
        // Выводим одну подпись (если нет обратного ребра или from < to)
        if (wReverse == -1 || from < to) {
            QGraphicsTextItem *txt = scene->addText(QString::number(w));
            txt->setDefaultTextColor(QColor("deeppink")); // Тёмно-розовый цвет текста веса
            txt->setFont(QFont("Arial", 10, QFont::Bold));
            QRectF r = txt->boundingRect();
            txt->setPos(mid - perp * offset - QPointF(r.width() / 2, r.height() / 2));
        }
    }
}






