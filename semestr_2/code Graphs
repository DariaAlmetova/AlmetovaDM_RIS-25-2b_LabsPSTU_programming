// Предварительное объявление абстрактного хранилища
class GraphStorage;

// Тип хранилища графа
enum class StorageType {
    AdjacencyMatrix, // Матрица смежности
    AdjacencyList // Список смежности
};

// Основной класс графа, предоставляющий интерфейс для работы с моделью. Делегирует все операции текущему хранилищу (GraphStorage), что позволяет переключать способ хранения во время выполнения.

class Graph {
public:
    Graph();
    ~Graph();

    // Переключить способ хранения (с сохранением данных)
    void setStorageType(StorageType type);
    StorageType storageType() const;

    // Редактирование вершин
    void addNode(const QString &name = ""); // Добавить вершину с именем
    void removeNode(int index); // Удалить вершину по индексу

    // Редактирование рёбер (ориентированный граф)
    void addEdge(int from, int to, int weight); // Добавить/обновить ребро
    void removeEdge(int from, int to); // Удалить одно направление
    void setWeight(int from, int to, int weight); // Изменить вес (аналог addEdge)
    int getWeight(int from, int to) const; // Получить вес ребра или -1
    int getNodeIndex(const QString& name) const; // Найти индекс вершины по имени

    // Алгоритмы на графе
    std::vector<int> dfs(int start) const; // Обход в глубину
    std::vector<int> bfs(int start) const; // Обход в ширину
    std::pair<std::vector<int>, std::vector<int>> dijkstra(int start) const; // Кратчайшие пути от start
    std::vector<std::vector<int>> floyd() const; // Все пары кратчайших путей

    // Информация о графе
    size_t nodeCount() const; // Количество вершин
    const std::vector<QString>& nodeNames() const; // Имена вершин

private:
    std::unique_ptr<GraphStorage> storage_; // Активное хранилище (матрица или список)
};

// Абстрактный интерфейс хранилища графа.
// Определяет чисто виртуальные методы для всех операций с графом.
// Конкретные реализации: AdjMatrixStorage, AdjListStorage.

class GraphStorage {
public:
    virtual ~GraphStorage() = default;

    virtual void addNode(const QString& name) = 0;
    virtual void removeNode(int index) = 0;
    virtual void addEdge(int from, int to, int weight) = 0;
    virtual void removeEdge(int from, int to) = 0;
    virtual int getWeight(int from, int to) const = 0;
    virtual int getNodeIndex(const QString& name) const = 0;
    virtual size_t nodeCount() const = 0;
    virtual const std::vector<QString>& nodeNames() const = 0;

    // Вспомогательная структура для экспорта данных при смене хранилища
    struct GraphData {
        std::vector<QString> names;
        struct Edge { int from, to, weight; };
        std::vector<Edge> edges;
    };
    virtual GraphData exportData() const = 0; // Сериализовать текущие вершины и рёбра
};

// Хранилище на основе матрицы смежности.
// Подходит для плотных графов. Для каждой пары (i, j) хранит вес ребра или -1.

class AdjMatrixStorage : public GraphStorage {
public:
    void addNode(const QString& name) override;
    void removeNode(int index) override;
    void addEdge(int from, int to, int weight) override;
    void removeEdge(int from, int to) override;
    int getWeight(int from, int to) const override;
    int getNodeIndex(const QString& name) const override;
    size_t nodeCount() const override;
    const std::vector<QString>& nodeNames() const override;
    GraphData exportData() const override;

private:
    std::vector<std::vector<int>> adjMatrix; // -1 = нет ребра
    std::vector<QString> names; // Имена вершин
};

// Хранилище на основе списка смежности.
// Подходит для разреженных графов. Для каждой вершины хранит список пар (сосед, вес).

class AdjListStorage : public GraphStorage {
public:
    void addNode(const QString& name) override;
    void removeNode(int index) override;
    void addEdge(int from, int to, int weight) override;
    void removeEdge(int from, int to) override;
    int getWeight(int from, int to) const override;
    int getNodeIndex(const QString& name) const override;
    size_t nodeCount() const override;
    const std::vector<QString>& nodeNames() const override;
    GraphData exportData() const override;

private:
    std::vector<std::vector<std::pair<int, int>>> adjList; // Для каждой вершины список (сосед, вес)
    std::vector<QString> names;
};

#endif








