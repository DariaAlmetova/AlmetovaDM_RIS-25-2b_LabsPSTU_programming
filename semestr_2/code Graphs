}

// Слоты редактирования графа

// Добавление вершины через диалог ввода имени
void MainWindow::onAddNode()
{
    bool ok;
    QString name = QInputDialog::getText(this, "Добавить вершину",
                                         "Введите имя вершины:", QLineEdit::Normal,
                                         "", &ok);
    if (ok && !name.isEmpty()) {
        if (graph->getNodeIndex(name) != -1) {
            QMessageBox::warning(this, "Ошибка", "Вершина с таким именем уже существует.");
            return;
        }
        graph->addNode(name);
        updateVisuals();
        outputText->append(QString("Вершина '%1' добавлена.").arg(name));
    }
}

// Удаление вершины через диалог ввода имени
void MainWindow::onRemoveNode()
{
    bool ok;
    QString name = QInputDialog::getText(this, "Удалить вершину",
                                         "Введите имя вершины для удаления:",
                                         QLineEdit::Normal, "", &ok);
    if (!ok || name.isEmpty()) return;

    int index = graph->getNodeIndex(name);
    if (index == -1) {
        QMessageBox::warning(this, "Ошибка", "Вершина с именем '" + name + "' не найдена.");
        return;
    }

    graph->removeNode(index);
    updateVisuals();
    outputText->append(QString("Вершина '%1' удалена.").arg(name));
}

// Добавление ребра (из полей Откуда/Куда/Вес)
void MainWindow::onAddEdge()
{
    QString fromName = fromEdit->text().trimmed();
    QString toName = toEdit->text().trimmed();
    int w = weightEdit->text().toInt();

    int from = graph->getNodeIndex(fromName);
    int to = graph->getNodeIndex(toName);
    if (from == -1 || to == -1) {
        QMessageBox::warning(this, "Ошибка", "Одна или обе вершины не найдены.");
        return;
    }
    if (from == to) {
        QMessageBox::warning(this, "Ошибка", "Нельзя создать ребро из вершины в саму себя.");
        return;
    }

    bool hadReverse = (graph->getWeight(to, from) != -1);
    graph->addEdge(from, to, w);
    updateVisuals();

    if (hadReverse) {
        outputText->append(QString("Ребро %1 → %2 (вес %3) добавлено. Встречное ребро %2 → %1 также обновлено до веса %3.")
                               .arg(fromName, toName).arg(w));
    } else {
        outputText->append(QString("Ребро %1 → %2 (вес %3) добавлено.").arg(fromName, toName).arg(w));
    }
}

// Удаление ребра (одного направления)
void MainWindow::onRemoveEdge()
{
    QString fromName = fromEdit->text().trimmed();
    QString toName = toEdit->text().trimmed();
    int from = graph->getNodeIndex(fromName);
    int to = graph->getNodeIndex(toName);
    if (from == -1 || to == -1) {
        QMessageBox::warning(this, "Ошибка", "Вершины не найдены.");
        return;
    }
    graph->removeEdge(from, to);
    updateVisuals();
    outputText->append(QString("Ребро %1 → %2 удалено.").arg(fromName, toName));
}

// Изменение веса ребра
void MainWindow::onSetWeight()
{
    QString fromName = fromEdit->text().trimmed();
    QString toName = toEdit->text().trimmed();
    int w = weightEdit->text().toInt();

    int from = graph->getNodeIndex(fromName);
    int to = graph->getNodeIndex(toName);
    if (from == -1 || to == -1) {
        QMessageBox::warning(this, "Ошибка", "Вершины не найдены.");
        return;
    }
    if (from == to) {
        QMessageBox::warning(this, "Ошибка", "Нельзя изменить вес петли (ребро из вершины в саму себя).");
        return;
    }

    bool hadReverse = (graph->getWeight(to, from) != -1);
    graph->setWeight(from, to, w);
    updateVisuals();

    if (hadReverse) {
        outputText->append(QString("Вес ребра %1 → %2 изменён на %3. Встречное ребро %2 → %1 также обновлено до %3.")
                               .arg(fromName, toName).arg(w));
    } else {
        outputText->append(QString("Вес ребра %1 → %2 изменён на %3.").arg(fromName, toName).arg(w));
    }
}

// Загрузка тестового графа из задания
void MainWindow::onLoadSampleGraph()
{
    while (graph->nodeCount() > 0)
        graph->removeNode(0); // Очищаем текущий граф

    // Создаём 6 вершин с именами 1..6
    for (int i = 1; i <= 6; ++i)
        graph->addNode(QString::number(i));

    // Добавляем рёбра (индексы 0..5 соответствуют именам 1..6)
    graph->addEdge(1, 3, 20);  // 2 -> 4
    graph->addEdge(1, 0, 28);  // 2 -> 1
    graph->addEdge(3, 5, 31);  // 4 -> 6
    graph->addEdge(4, 1, 21);  // 5 -> 2
    graph->addEdge(3, 4, 39);  // 4 -> 5
    graph->addEdge(4, 3, 39);  // 5 -> 4
    graph->addEdge(5, 0, 18);  // 6 -> 1
    graph->addEdge(0, 3, 15);  // 1 -> 4
    graph->addEdge(0, 2, 13);  // 1 -> 3
    graph->addEdge(2, 4, 30);  // 3 -> 5

    updateVisuals();
    outputText->append("Загружен образец графа из задания.");
}

// Полная очистка графа (удаление всех вершин)
void MainWindow::onClearGraph()
{
    while (graph->nodeCount() > 0) {
        graph->removeNode(0);
    }
    updateVisuals();
    algorithmSteps.clear();
    currentStepIndex = -1;
    stepLabel->setText("Шаг 0 / 0");
    outputText->clear();
    outputText->append("Граф очищен.");
}

