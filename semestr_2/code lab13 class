#include "Money.h" 

Money::Money() : rubles(0), kopeks(0) { // конструктор без параметров: инициализирует рубли и копейки нулями
}

Money::Money(long r, int k) : rubles(r), kopeks(k) {   // конструктор с параметрами: задаёт рубли и копейки из аргументов
    normalize();
}

Money::Money(const Money& other) : rubles(other.rubles), kopeks(other.kopeks) { // конструктор копирования: копирует поля из другого объекта
}

Money::~Money() { // деструктор класса Money
}

long Money::getRubles() const { // метод получения рублей (константный, не изменяет объект)
    return rubles; // возвращает значение поля rubles
}

int Money::getKopeks() const { // метод получения копеек (константный)
    return kopeks; // возвращает значение поля kopeks
}

void Money::setRubles(long r) { // устанавливает новое значение рублей
    rubles = r; // прямое присваивание полю rubles
}

void Money::setKopeks(int k) { // устанавливает новое значение копеек
    kopeks = k; // присваивание полю kopeks
    normalize();
}

long Money::toKopeks() const { // переводит сумму в копейки (константный метод)
    return rubles * 100 + kopeks; // рубли умножаем на 100, прибавляем копейки
}

void Money::normalize() { // приведение копеек в диапазон 0..99, корректировка рублей
    if (kopeks >= 100) { // если копеек 100 или больше
        rubles += kopeks / 100; // добавляем целые рубли (например, 150 копеек = 1 рубль)
        kopeks = kopeks % 100; // оставляем остаток копеек (0..99)
    }
    else if (kopeks < 0) { // если копейки отрицательные
        long total = rubles * 100 + kopeks; // переводим всю сумму в копейки (может быть отрицательной)
        rubles = total / 100; // целочисленное деление даёт рубли (с округлением к нулю)
        kopeks = total % 100; // остаток – копейки (может быть отрицательным)
        if (kopeks < 0) { // если копейки всё ещё отрицательны
            rubles--; // занимаем 1 рубль (уменьшаем рубли на 1)
            kopeks += 100; // добавляем 100 копеек, теперь копейки в [0,99]
        }
    }
}

Money& Money::operator=(const Money& other) { // оператор присваивания
    if (this != &other) { // проверка на самоприсваивание (адрес текущего объекта не равен адресу other)
        rubles = other.rubles; // копируем рубли
        kopeks = other.kopeks; // копируем копейки
    }
    return *this; // возвращаем ссылку на текущий объект
}

Money Money::operator/(const Money& other) const { // оператор деления двух сумм
    if (other.rubles == 0 && other.kopeks == 0) { // проверка деления на ноль
        cout << "Ошибка: деление на ноль!" << endl;
        return Money(0, 0); // возвращаем нулевую сумму
    }
    double result = (double)toKopeks() / other.toKopeks(); // вычисляем вещественное частное (копейки/копейки)
    long totalKopeks = (long)(result * 100); // переводим результат в копейки (умножаем на 100 и округляем)
    return Money(totalKopeks / 100, totalKopeks % 100); // создаём и возвращаем новую сумму из рублей и копеек
}

Money Money::operator*(double factor) const { // оператор умножения суммы на дробное число
    long totalKopeks = (long)(toKopeks() * factor); // умножаем копейки на factor, округляем до целых
    return Money(totalKopeks / 100, totalKopeks % 100); // создаём и возвращаем новую сумму
}

Money& Money::operator++() { // префиксный инкремент (++m) – увеличивает на 1 копейку
    long total = toKopeks() + 1; // увеличиваем общее количество копеек на 1
    rubles = total / 100; // вычисляем новые рубли
    kopeks = total % 100; // вычисляем новые копейки
    return *this; // возвращаем ссылку на изменённый объект
}

Money Money::operator++(int) { // постфиксный инкремент (m++) – увеличивает, но возвращает старое значение
    Money temp = *this; // сохраняем старую копию объекта
    ++(*this); // вызываем префиксный инкремент для увеличения текущего объекта
    return temp; // возвращаем старое значение (копию)
}

bool Money::operator<(const Money& other) const { // оператор "меньше"
    return toKopeks() < other.toKopeks(); // сравниваем общие суммы в копейках
}

bool Money::operator>(const Money& other) const { // оператор "больше"
    return toKopeks() > other.toKopeks(); // сравнение в копейках
}

bool Money::operator==(const Money& other) const { // оператор равенства
    return toKopeks() == other.toKopeks(); // равенство копеек означает равенство сумм
}

bool Money::operator!=(const Money& other) const { // оператор неравенства
    return !(*this == other);
}

Money Money::operator+(const Money& other) const { // оператор сложения двух сумм
    long total = toKopeks() + other.toKopeks(); // складываем копейки
    return Money(total / 100, total % 100); // возвращаем новую нормализованную сумму
}

Money& Money::operator+=(const Money& other) { // оператор сложения с присваиванием
    long total = toKopeks() + other.toKopeks(); // вычисляем сумму в копейках
    rubles = total / 100; // устанавливаем новые рубли
    kopeks = total % 100; // устанавливаем новые копейки
    return *this; // возвращаем ссылку на текущий объект
}

istream& operator>>(istream& in, Money& m) { // глобальная функция ввода (друг класса)
    cout << "Введите рубли: ";
    in >> m.rubles;
    cout << "Введите копейки: ";
    in >> m.kopeks;
    m.normalize();
    return in; // возвращаем поток для цепочечного вызова
}

ostream& operator<<(ostream& out, const Money& m) { // глобальная функция вывода (друг класса)
    out << m.rubles << ",";
    if (m.kopeks < 10) out << "0";
    out << m.kopeks;
    return out; // возвращаем поток для цепочечного вызова
}




