#pragma once
#ifndef MONEY_H
#define MONEY_H
#include <iostream>
using namespace std;

class Money {
private:
    long rubles;
    int kopeks;

public:
    Money(); // конструктор без параметров (создаёт 0,00)
    Money(long r, int k); // конструктор с параметрами (рубли, копейки)
    Money(const Money& other); // конструктор копирования

    ~Money(); // деструктор

    // селекторы (геттеры) – константные методы, не изменяющие объект
    long getRubles() const; // возвращает количество рублей
    int getKopeks() const; // возвращает количество копеек

    // модификаторы (сеттеры)
    void setRubles(long r); // устанавливает новое значение рублей
    void setKopeks(int k); // устанавливает копейки и нормализует сумму

    long toKopeks() const; // переводит всю сумму в копейки (например, 12,50 -> 1250)
    void normalize(); // приводит копейки к диапазону 0..99 (корректирует рубли)

    Money& operator=(const Money& other); // оператор присваивания
    Money operator/(const Money& other) const; // деление двух денежных сумм
    Money operator*(double factor) const; // умножение на дробное число
    Money& operator++(); // префиксный инкремент (увеличение на 1 копейку)
    Money operator++(int); // постфиксный инкремент

    bool operator<(const Money& other) const; // сравнение "меньше" (по общей сумме в копейках)
    bool operator>(const Money& other) const; // сравнение "больше"
    bool operator==(const Money& other) const; // равенство
    bool operator!=(const Money& other) const; // неравенство
    Money operator+(const Money& other) const; // сложение двух сумм
    Money& operator+=(const Money& other); // сложение с присваиванием

    friend istream& operator>>(istream& in, Money& m); // ввод из потока
    friend ostream& operator<<(ostream& out, const Money& m); // вывод в поток
};

#endif
