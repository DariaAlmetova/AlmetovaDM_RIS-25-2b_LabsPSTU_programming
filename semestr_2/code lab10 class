#pragma once
#include <iostream>
#include <fstream>
#include <string>
using namespace std;

class Money {
private:
    long rub; // поле для хранения рублей (целая часть)
    int kop; // поле для хранения копеек (дробная часть, 0..99)
    void normalize(); // приватный метод для нормализации копеек (перенос 100 копеек в 1 рубль)

public:
    Money(); // конструктор по умолчанию (создаёт сумму 0,00)
    Money(long r, int k); // конструктор с параметрами (рубли, копейки)
    Money(const Money& other); // конструктор копирования
    ~Money(); // деструктор

    Money& operator=(const Money& other); // перегрузка оператора присваивания

    bool operator==(const Money& other) const; // перегрузка оператора сравнения ==
    bool operator!=(const Money& other) const; // перегрузка оператора сравнения !=

    Money operator+(const Money& other) const; // перегрузка оператора сложения
    Money operator-(const Money& other) const; // перегрузка оператора вычитания
    Money operator*(double factor) const; // умножение суммы на дробное число
    double operator/(const Money& other) const; // деление суммы на сумму (результат double)

    // дружественные функции для ввода/вывода в стандартные потоки (консоль)
    friend ostream& operator<<(ostream& out, const Money& m);
    friend istream& operator>>(istream& in, Money& m);

    // дружественные функции для ввода/вывода в файловые потоки (чтение/запись в файл)
    friend fstream& operator<<(fstream& fout, const Money& m);
    friend fstream& operator>>(fstream& fin, Money& m);
};
