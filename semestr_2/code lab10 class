#include "Money.h"
#include "file_work.h"
#include <iostream>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");

    char file_name[30]; // массив для хранения имени файла
    int choice, result, K; // переменные: выбор меню, результат, количество записей
    Money val; // переменная для хранения заданной суммы (для сравнения)

    do {
        cout << "\n===== МЕНЮ =====\n";
        cout << "1. Создать файл\n";
        cout << "2. Печать файла\n";
        cout << "3. Удалить записи, НЕ равные заданной\n";
        cout << "4. Уменьшить записи, равные заданной, в 2 раза\n";
        cout << "5. Добавить K записей в начало файла\n";
        cout << "0. Выход\n";
        cout << "Ваш выбор: ";
        cin >> choice;

        switch (choice) {
        case 1: // создание файла
            cout << "Имя файла: ";
            cin >> file_name;
            result = make_file(file_name);
            if (result < 0) cout << "Ошибка создания файла!\n";
            else cout << "Создано " << result << " записей.\n";
            break;

        case 2: // печать файла
            cout << "Имя файла: ";
            cin >> file_name;
            result = print_file(file_name);
            if (result < 0) cout << "Ошибка открытия файла!\n";
            else if (result == 0) cout << "Файл пуст.\n";
            else cout << "Всего записей: " << result << endl;
            break;

        case 3: // удаление записей, не равных заданной
            cout << "Имя файла: ";
            cin >> file_name;
            cout << "Введите сумму для сравнения (рубли,копейки): ";
            cin >> val;          // Ввод эталонной суммы
            result = delete_not_equal(file_name, val);
            if (result < 0) cout << "Ошибка открытия файла!\n";
            else cout << "Оставлено записей (равных заданной): " << result << endl;
            break;

        case 4: // уменьшение записей, равных заданной, в 2 раза
            cout << "Имя файла: ";
            cin >> file_name;
            cout << "Введите сумму для поиска: ";
            cin >> val;
            result = decrease_equal(file_name, val);
            if (result < 0) cout << "Ошибка открытия файла!\n";
            else cout << "Изменено записей: " << result << endl;
            break;

        case 5: // добавление K записей в начало файла
            cout << "Имя файла: ";
            cin >> file_name;
            cout << "Сколько записей добавить в начало? ";
            cin >> K;
            result = add_to_begin(file_name, K);
            if (result < 0) cout << "Ошибка открытия файла!\n";
            else cout << "Добавлено " << result << " записей в начало.\n";
            break;

        case 0: // выход из программы
            cout << "Выход.\n";
            break;

        default:
            cout << "Неверный пункт меню!\n";
        }
    } while (choice != 0); // повторяем, пока не выбран выход

    return 0;
}



