#include "Money.h"

// реализация приватного метода normalize – приводит копейки в диапазон 0..99
void Money::normalize() {
    if (kop >= 100) { // если копеек 100 или больше
        rub += kop / 100; // добавляем целые рубли (копейки/100)
        kop %= 100; // оставляем остаток копеек (0..99)
    }
    else if (kop < 0) { // если копейки отрицательные
        long need_rub = (-kop + 99) / 100; // вычисляем, сколько рублей нужно вычесть
        rub -= need_rub; // вычитаем рубли
        kop += need_rub * 100; // добавляем 100 копеек за каждый вычтенный рубль
        if (kop < 0) kop = 0; // защита от отрицательных копеек
    }
}

// конструктор по умолчанию: сумма 0 рублей 0 копеек
Money::Money() : rub(0), kop(0) {}

// конструктор с параметрами: задаём рубли и копейки, затем нормализуем
Money::Money(long r, int k) : rub(r), kop(k) {
    normalize();
}

// конструктор копирования: создаём объект как копию другого
Money::Money(const Money& other) : rub(other.rub), kop(other.kop) {}

// деструктор
Money::~Money() {}

// перегрузка оператора присваивания
Money& Money::operator=(const Money& other) {
    if (this != &other) { // проверка на самоприсваивание
        rub = other.rub; // копируем рубли
        kop = other.kop; // копируем копейки
    }
    return *this; // возвращаем ссылку на текущий объект
}

// перегрузка оператора сравнения "равно"
bool Money::operator==(const Money& other) const {
    return (rub == other.rub && kop == other.kop); // сравниваем оба поля
}

// перегрузка оператора сравнения "не равно"
bool Money::operator!=(const Money& other) const {
    return !(*this == other);
}

// перегрузка оператора сложения двух денежных сумм
Money Money::operator+(const Money& other) const {
    return Money(rub + other.rub, kop + other.kop); // складываем поля, нормализация в конструкторе
}

// перегрузка оператора вычитания
Money Money::operator-(const Money& other) const {
    return Money(rub - other.rub, kop - other.kop); // вычитаем поля, нормализация в конструкторе
}

// умножение денежной суммы на дробное число (например, 0.5 для уменьшения в 2 раза)
Money Money::operator*(double factor) const {
    double total_kop = (rub * 100 + kop) * factor; // переводим всё в копейки, умножаем
    long new_rub = static_cast<long>(total_kop / 100); // целые рубли из копеек
    int new_kop = static_cast<int>(total_kop - new_rub * 100); // остаток копеек
    return Money(new_rub, new_kop); // создаём и возвращаем новую сумму
}

// деление одной денежной суммы на другую – результат вещественное число
double Money::operator/(const Money& other) const {
    double this_val = rub * 100 + kop; // текущая сумма в копейках
    double other_val = other.rub * 100 + other.kop; // делитель в копейках
    if (other_val == 0) {  // защита от деления на ноль
        cerr << "Ошибка: деление на ноль!" << endl;
        return 0;
    }
    return this_val / other_val; // возвращаем вещественное частное
}

// перегрузка оператора вывода в стандартный поток (консоль)
ostream& operator<<(ostream& out, const Money& m) {
    out << m.rub << ","; // выводим рубли и запятую
    if (m.kop < 10) out << "0"; // если копеек меньше 10, добавляем ведущий ноль
    out << m.kop; // выводим копейки
    return out; // возвращаем поток для цепочек операций
}

// перегрузка оператора ввода из стандартного потока (консоль)
istream& operator>>(istream& in, Money& m) {
    char comma; // переменная для запятой-разделителя
    in >> m.rub >> comma >> m.kop; // читаем рубли, запятую, копейки
    if (comma != ',') in.setstate(ios::failbit); // если разделитель не запятая – ошибка
    m.normalize(); // нормализуем введённое значение
    return in; // возвращаем поток
}

// перегрузка оператора вывода в файловый поток (запись в файл)
fstream& operator<<(fstream& fout, const Money& m) {
    fout << m.rub << "\n" << m.kop << "\n"; // записываем рубли и копейки с переводом строки
    return fout;  // возвращаем поток
}

// перегрузка оператора ввода из файлового потока (чтение из файла)
fstream& operator>>(fstream& fin, Money& m) {
    fin >> m.rub >> m.kop; // читаем рубли и копейки из файла
    m.normalize();
    return fin; // возвращаем поток
}



