#include "Money.h"
#include <cstdio> // функции remove и rename для работы с файлами
using namespace std;

// функция создания файла (перезапись с вводом данных с клавиатуры)
int make_file(const char* f_name) {
    // открываем файл для записи в режиме out|trunc (создание/перезапись)
    fstream stream(f_name, ios::out | ios::trunc);
    if (!stream) return -1; // если не удалось открыть, возвращаем -1 (ошибка)

    int n;
    cout << "Количество записей: ";
    cin >> n;

    Money m; // временный объект для ввода
    for (int i = 0; i < n; ++i) {
        cout << "Введите сумму (рубли,копейки): ";
        cin >> m; // ввод с консоли с помощью перегруженного >>
        stream << m; // запись в файл с помощью перегруженного << для fstream
    }
    stream.close();
    return n;
}

// функция печати содержимого файла на экран
int print_file(const char* f_name) {
    fstream stream(f_name, ios::in); // открываем файл для чтения
    if (!stream) return -1; // ошибка открытия

    Money m; // временный объект
    int i = 0; // счётчик записей
    while (stream >> m) { // читаем объекты из файла (перегруженный >> для fstream)
        cout << ++i << ": " << m << endl; // выводим номер и сумму (перегруженный << для cout)
    }
    stream.close();
    return i;
}

// функция удаления записей, НЕ равных заданному значению
int delete_not_equal(const char* f_name, const Money& val) {
    fstream in(f_name, ios::in); // открываем исходный файл для чтения
    if (!in) return -1; // ошибка открытия

    fstream out("temp.txt", ios::out); // открываем временный файл для записи
    Money m; // буфер для чтения
    int kept = 0; // счётчик оставленных записей (равных val)

    while (in >> m) { // читаем каждую запись из исходного файла
        if (m == val) { // если запись равна заданному значению
            out << m; // записываем её во временный файл
            kept++;
        }
        // если запись НЕ равна val – ничего не записываем (т.е. удаляем)
    }
    in.close(); // закрываем исходный файл
    out.close(); // закрываем временный файл

    remove(f_name); // удаляем исходный файл
    rename("temp.txt", f_name); // переименовываем временный в исходное имя
    return kept; // возвращаем количество оставленных записей
}

// функция уменьшения записей, равных заданному значению, в два раза
int decrease_equal(const char* f_name, const Money& val) {
    fstream in(f_name, ios::in); // открываем исходный файл для чтения
    if (!in) return -1; // ошибка открытия

    fstream out("temp.txt", ios::out); // открываем временный файл для записи
    Money m; // буфер для чтения
    int changed = 0; // счётчик изменённых записей

    while (in >> m) { // читаем каждую запись
        if (m == val) { // если запись равна заданному значению
            m = m * 0.5; // уменьшаем в 2 раза (умножение на 0.5)
            changed++; // увеличиваем счётчик
        }
        out << m; // записываем (возможно, изменённую) запись во временный файл
    }
    in.close();
    out.close();

    remove(f_name);
    rename("temp.txt", f_name);
    return changed;
}

// функция добавления K записей в начало файла
int add_to_begin(const char* f_name, int K) {
    // Открываем исходный файл для чтения
    fstream in(f_name, ios::in);
    if (!in) return -1;

    // сначала подсчитываем количество записей в файле
    Money temp; // временная переменная
    int count = 0; // счётчик записей
    while (in >> temp) {  // читаем все записи, просто чтобы узнать их количество
        count++;
    }
    in.clear(); // сбрасываем флаги ошибок (в частности eof)
    in.seekg(0, ios::beg); // возвращаем указатель чтения в начало файла

    // выделяем динамический массив для хранения старых записей
    Money* old = new Money[count]; // массив объектов Money размером count
    for (int i = 0; i < count; ++i) {
        in >> old[i]; // считываем все записи в массив
    }
    in.close(); // закрываем исходный файл

    // открываем временный файл для записи
    fstream out("temp.txt", ios::out);
    if (!out) { // если не удалось открыть
        delete[] old; // освобождаем память
        return -1; // возвращаем ошибку
    }

    // вводим K новых записей и сразу пишем их во временный файл
    Money new_m; // временная переменная для новой записи
    for (int i = 0; i < K; ++i) {
        cout << "Новая запись " << i + 1 << ": ";
        cin >> new_m;
        out << new_m; // запись во временный файл
    }

    // затем записываем во временный файл старые записи (сохранённые в массиве)
    for (int i = 0; i < count; ++i) {
        out << old[i]; // запись каждой старой записи
    }
    out.close(); // закрываем временный файл

    delete[] old; // освобождаем динамическую память

    // заменяем исходный файл на временный
    remove(f_name); // удаляем исходный файл
    rename("temp.txt", f_name); // переименовываем временный в исходное имя
    return K; // возвращаем количество добавленных записей
}



