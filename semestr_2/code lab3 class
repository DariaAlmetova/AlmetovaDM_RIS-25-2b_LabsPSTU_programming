#ifndef MONEY_H // если MONEY_H НЕ определён
#define MONEY_H // то определи его

#include <iostream>
using namespace std;

class Money {
private:
    long rubles; // рубли (целая часть)
    int kopeks; // копейки (дробная часть, 0-99)

public:
    // КОНСТРУКТОРЫ
    Money(); // конструктор без параметров
    Money(long r, int k); // конструктор с параметрами
    Money(const Money& other); // конструктор копирования

    // ДЕСТРУКТОР
    ~Money();

    // СЕЛЕКТОРЫ (геттеры)
    long getRubles() const;
    int getKopeks() const;

    // МОДИФИКАТОРЫ (сеттеры)
    void setRubles(long r);
    void setKopeks(int k);

    // ПЕРЕГРУЖЕННЫЕ ОПЕРАЦИИ
    Money& operator=(const Money& other); // операция присваивания
    Money operator/(const Money& other) const; // деление сумм
    Money operator*(double factor) const; // умножение на дробное число

    // префиксный и постфиксный инкремент (увеличение на 1 копейку)
    Money& operator++(); // префиксный ++
    Money operator++(int); // постфиксный ++

    // ДРУЖЕСТВЕННЫЕ ФУНКЦИИ ВВОДА/ВЫВОДА
    friend istream& operator>>(istream& in, Money& m); // теперь эта функция может читать rubles и kopeks напрямую
    friend ostream& operator<<(ostream& out, const Money& m); // это перегрузка оператора вывода (operator<<) для класса Money

    // ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ
    long toKopeks() const; // перевод в копейки
    void normalize(); // нормализация (корректировка). приведение денежной суммы к корректному формату, где количество копеек находится в диапазоне от 0 до 99
};

