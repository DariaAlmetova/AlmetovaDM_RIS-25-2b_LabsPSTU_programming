    cout << "\nПостфиксный k++: ";
    cout << k++ << endl;
    cout << "После k++: k = " << k << endl;

    // 8. КОМБИНИРОВАННЫЕ ОПЕРАЦИИ
    cout << "\n--- 8. КОМБИНИРОВАННЫЕ ОПЕРАЦИИ ---" << endl;

