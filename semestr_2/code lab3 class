    m2.setRubles(200);
    m2.setKopeks(99);
    cout << "После изменения через сеттеры: m2 = " << m2 << endl;

    // 3. ДЕМОНСТРАЦИЯ ОПЕРАЦИИ ПРИСВАИВАНИЯ
    cout << "\n--- 3. ОПЕРАЦИЯ ПРИСВАИВАНИЯ ---" << endl;
    Money m4;
    m4 = m2;
    cout << "m4 = m2 => m4 = " << m4 << endl;

    // 4. ДЕМОНСТРАЦИЯ ОПЕРАЦИИ ВВОДА/ВЫВОДА
    cout << "\n--- 4. ВВОД/ВЫВОД ---" << endl;
    Money m5;
    cin >> m5;
    cout << "Вы ввели: " << m5 << endl;

    // 5. ДЕМОНСТРАЦИЯ ОПЕРАЦИИ ДЕЛЕНИЯ
    cout << "\n--- 5. ОПЕРАЦИЯ ДЕЛЕНИЯ ( / ) ---" << endl;
    Money a(300, 0);    // 300,00 рублей
    Money b(100, 0);    // 100,00 рублей
    Money c = a / b;    // 300 / 100 = 3
    cout << a << " / " << b << " = " << c << endl;

    Money d(150, 50);   // 150,50 рублей
    Money e(50, 25);    // 50,25 рублей
    Money f = d / e;
    cout << d << " / " << e << " = " << f << endl;

    // 6. ДЕМОНСТРАЦИЯ ОПЕРАЦИИ УМНОЖЕНИЯ НА ДРОБНОЕ ЧИСЛО
    cout << "\n--- 6. ОПЕРАЦИЯ УМНОЖЕНИЯ ( * ) ---" << endl;
    Money g(100, 50);   // 100,50 рублей
    Money h = g * 2.5;  // 100,50 * 2.5 = 251,25
    cout << g << " * 2.5 = " << h << endl;

    Money i(50, 20);    // 50,20 рублей
    Money j = i * 1.75; // 50,20 * 1.75 = 87,85
    cout << i << " * 1.75 = " << j << endl;

    // 7. ДЕМОНСТРАЦИЯ ПРЕФИКСНОГО И ПОСТФИКСНОГО ИНКРЕМЕНТА
    cout << "\n--- 7. ОПЕРАЦИИ ИНКРЕМЕНТА (++ и ++) ---" << endl;

    Money k(0, 99);     // 0,99 рублей (99 копеек)
    cout << "Начальное значение k = " << k << endl;

    // префиксный инкремент (увеличивает и возвращает новое значение)
    cout << "\nПрефиксный ++k: ";
    cout << ++k << endl;
    cout << "После ++k: k = " << k << endl;

