#include "Money.h"
#include <iostream>
#include <cmath>
using namespace std;

// КОНСТРУКТОРЫ

// конструктор без параметров
Money::Money() {
    cout << "Вызван конструктор без параметров" << endl;
    rubles = 0;
    kopeks = 0;
}

// конструктор с параметрами
Money::Money(long r, int k) {
    cout << "Вызван конструктор с параметрами" << endl;
    rubles = r;
    kopeks = k;
    normalize();  // нормализуем значения
}

// конструктор копирования
Money::Money(const Money& other) {
    cout << "Вызван конструктор копирования" << endl;
    rubles = other.rubles;
    kopeks = other.kopeks;
}

// ДЕСТРУКТОР
Money::~Money() {
    cout << "Деструктор вызван для суммы: " << rubles << "," << kopeks << endl;
}

// СЕЛЕКТОРЫ (геттеры)
long Money::getRubles() const { // метод не изменяет объект
    return rubles;
}

int Money::getKopeks() const {
    return kopeks;
}

// МОДИФИКАТОРЫ (сеттеры)
void Money::setRubles(long r) {
    rubles = r;
}

void Money::setKopeks(int k) {
    kopeks = k;
    normalize();
}

// ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ

// перевод суммы в копейки
long Money::toKopeks() const {
    return rubles * 100 + kopeks;
}

// нормализация: корректировка копеек (0-99)
void Money::normalize() {
    if (kopeks >= 100) {
        rubles += kopeks / 100;
        kopeks = kopeks % 100;
    }
    else if (kopeks < 0) {
        long temp = rubles * 100 + kopeks;
        rubles = temp / 100;
        kopeks = temp % 100;
        if (kopeks < 0) {
            rubles--; // занимаем 1 рубль
            kopeks += 100;
        }
    }
}

// ПЕРЕГРУЖЕННЫЕ ОПЕРАЦИИ

// операция присваивания
Money& Money::operator=(const Money& other) {
    cout << "Вызван оператор присваивания" << endl;
    // проверка на самоприсваивание
    if (this == &other) {
        return *this; // ничего не делаем, возвращаем себя
    } // копируем данные
    rubles = other.rubles;
    kopeks = other.kopeks;
    return *this; // возвращаем ссылку на текущий объект
}

// деление двух денежных сумм
// результат - вещественное число, упакованное в Money
Money Money::operator/(const Money& other) const {
    cout << "Вызван оператор деления ( / )" << endl;

    if (other.rubles == 0 && other.kopeks == 0) {
        cout << "Ошибка: деление на ноль!" << endl;
        return Money(0, 0);
    }

    long k1 = this->toKopeks(); // копейки первого числа
    long k2 = other.toKopeks(); // копейки второго числа

    // результат деления (вещественное число)
    double result = (double)k1 / (double)k2;

    // переводим в рубли и копейки
    long totalKopeks = (long)(result * 100);

    return Money(totalKopeks / 100, totalKopeks % 100);
}

// умножение суммы на дробное число
Money Money::operator*(double factor) const {
    cout << "Вызван оператор умножения ( * )" << endl;

    long totalKopeks = (long)(this->toKopeks() * factor);

    return Money(totalKopeks / 100, totalKopeks % 100);
}

// префиксный инкремент (++m) - увеличивает на 1 копейку
Money& Money::operator++() {
    cout << "Вызван префиксный оператор ++" << endl;

    long totalKopeks = this->toKopeks() + 1;
    rubles = totalKopeks / 100;
    kopeks = totalKopeks % 100;

    return *this;
}

// постфиксный инкремент (m++) - увеличивает на 1 копейку
Money Money::operator++(int) {
    cout << "Вызван постфиксный оператор ++" << endl;

    Money temp = *this; // сохраняем старое значение
    long totalKopeks = this->toKopeks() + 1;
    rubles = totalKopeks / 100;
    kopeks = totalKopeks % 100;

    return temp; // возвращаем старое значение
}

// ГЛОБАЛЬНЫЕ ФУНКЦИИ ВВОДА/ВЫВОДА

// перегрузка операции ввода >>
istream& operator>>(istream& in, Money& m) {
    cout << "Ввод денежной суммы:" << endl;
    cout << "Рубли: ";
    in >> m.rubles; // извлекаем целое число из потока и сохраняем в rubles
    cout << "Копейки: ";
    in >> m.kopeks;
    m.normalize();
    return in;
}

// перегрузка операции вывода <<
// вывод в формате: рубли,копейки (например, 150,50)
ostream& operator<<(ostream& out, const Money& m) {
    out << m.rubles << ",";

    // выводим копейки с ведущим нулём при необходимости
    if (m.kopeks < 10) {
        out << "0" << m.kopeks;
    }
    else {
        out << m.kopeks;
    }

    return out;
}

