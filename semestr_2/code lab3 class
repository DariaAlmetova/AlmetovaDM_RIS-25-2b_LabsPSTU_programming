    Money y(2, 0);      // 2,00 рубля

    Money z = (x / y) * 3.0;
    cout << "(" << x << " / " << y << ") * 3.0 = " << z << endl;

    // 9. ДЕМОНСТРАЦИЯ РАБОТЫ ДЕСТРУКТОРА
    cout << "\n--- 9. ДЕСТРУКТОР (вызывается при завершении) ---" << endl;

    cout << "\n========================================" << endl;
    cout << "    ПРОГРАММА ЗАВЕРШИЛА РАБОТУ" << endl;
    cout << "========================================" << endl;

    return 0;
}


