    // добавление элементов
    pushBack(list, "яблоко");
    pushBack(list, "банан");
    pushBack(list, "вишня");
    cout << "Однонаправленный: "; printList(list);
    pushBackDouble(listDouble, "арбуз");
    pushBackDouble(listDouble, "груша");
    pushBackDouble(listDouble, "дыня");
