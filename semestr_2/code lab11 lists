    // вставка и удаление по индексу
    insertAt(list, 1, "клубника");
    cout << "Однонаправленный после вставки по индексу 1: "; printList(list);
    deleteAt(list, 1);
    cout << "Однонаправленный после удаления по индексу 1: "; printList(list);

    // аналогично для двунаправленного
    saveListDoubleToFile(listDouble, "list_double.txt");
    destroyListDouble(listDouble);

    // восстановление и вывод
    loadListDoubleFromFile(listDouble, "list_double.txt");
    cout << "Двунаправленный после восстановления: "; printListDouble(listDouble);

    // удаление из начала и конца двунаправленного
    popFrontDouble(listDouble);
    cout << "Двунаправленный после удаления из начала двунаправленного: "; printListDouble(listDouble);
    popBackDouble(listDouble);
    cout << "Двунаправленный после удаления из конца двунаправленного: "; printListDouble(listDouble);

    // вставка и удаление по индексу двунаправленного
    insertAtDouble(listDouble, 2, "ананас");
    cout << "Двунаправленный после вставки по индексу 2: "; printListDouble(listDouble);
    deleteAtDouble(listDouble, 2);
