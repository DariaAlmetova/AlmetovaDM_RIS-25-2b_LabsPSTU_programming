}


// 2 способа добавления

#include <iostream>
#include <cstring>
#include <clocale>

using namespace std;

// структура узла
struct Node {
    char key[100]; // поле для хранения строки
    Node* next; // следующий узел
};

// односвязный список с одной ссылкой (только на начало)
struct ListHeadOnly {
    Node* head = nullptr;    // головной узел
};

// односвязный список с двумя ссылками (на начало и конец)
struct ListWithTail {
    Node* head = nullptr;    // головной узел
    Node* tail = nullptr;    // хвостовой узел
};

// создание узлов
Node* createNode(const char* str) { // передаётся строка
    Node* new_node = new Node; // выделяется новая область памяти для узла
    int i = 0;
    while (str[i] != '\0' && i < 99) { // копируем символы из входящей строки в key
        new_node->key[i] = str[i];
        i++;
    }
    new_node->key[i] = '\0'; // завершаем копирование символом конца строки
    new_node->next = nullptr; // по умолчанию следующий узел отсутствует
    return new_node; // возвращаем созданный узел
}

// добавить элемент в конец списка (1 способ)
void pushBackHeadOnly(ListHeadOnly& list, const char* key) {
    Node* new_node = createNode(key); // новый узел
    if (!list.head) { // если список пуст
        list.head = new_node; // устанавливаем голову
    }
    else {
        Node* current = list.head; // начинаем с головы
        while (current->next != nullptr) // ищем последний узел
            current = current->next;
        current->next = new_node; // присоединяем новый узел
    }
}

// добавить элемент в конец списка (2 способ)
void pushBackWithTail(ListWithTail& list, const char* key) {
    Node* new_node = createNode(key); // новый узел
    if (!list.head) { // если список пуст
        list.head = new_node; // устанавливаем голову
        list.tail = new_node; // устанавливаем хвост
    }
    else {
        list.tail->next = new_node; // предыдущий хвост указывает на новый узел
        list.tail = new_node; // обновляем хвост
    }
}

int main() {
    setlocale(LC_ALL, "ru");
    // список с методом хранения "головной узел"
    ListHeadOnly list1;
    pushBackHeadOnly(list1, "яблоко");
    pushBackHeadOnly(list1, "банан");
    pushBackHeadOnly(list1, "вишня");
    cout << "Список 1 (только голова): ";
    for (Node* p = list1.head; p != nullptr; p = p->next)
        cout << p->key << " ";
    cout << endl;

    // список с методом хранения "голова и хвост"
    ListWithTail list2;
    pushBackWithTail(list2, "арбуз");
    pushBackWithTail(list2, "груша");
    pushBackWithTail(list2, "дыня");
    cout << "Список 2 (голова + хвост): ";
    for (Node* p = list2.head; p != nullptr; p = p->next)
        cout << p->key << " ";
    cout << endl;

    return 0;
}
