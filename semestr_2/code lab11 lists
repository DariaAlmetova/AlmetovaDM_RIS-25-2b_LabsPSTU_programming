    pushFrontDouble(listDouble, "мандарин");
    pushFrontDouble(listDouble, "лимон");
    cout << "Двунаправленный после добавления в начало: "; printListDouble(listDouble);

    // удаление
    deleteByKey(list, "банан");
    cout << "Однонаправленный после удаления 'банан': "; printList(list);
    deleteByKeyDouble(listDouble, "груша");
    cout << "Двунаправленный после удаления 'груша': "; printListDouble(listDouble);

    // вставка 2 элементов перед 'вишня'
    const char* new_keys[] = { "черешня", "киви" };
    insertBeforeKey(list, "вишня", 2, new_keys);
    cout << "Однонаправленный после вставки перед 'вишня': "; printList(list);

