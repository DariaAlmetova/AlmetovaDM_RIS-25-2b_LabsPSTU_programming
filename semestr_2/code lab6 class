#include "Set.h"
#include <iostream>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");

    cout << "========== Лабораторная работа №6, вариант 7 ==========" << endl;
    cout << "Класс-контейнер МНОЖЕСТВО (Set) с элементами int" << endl;
    cout << "Операции: [], int(), *, -- (итератор)\n" << endl;

    // 1. проверка конструктора Set(int s, int k)
    Set a(5, 7);
    cout << "a = " << a << ", размер = " << (int)a << endl;

    // 2. проверка оператора ввода >> (пользователь вводит элементы, дубликаты отсеиваются)
    Set b;
    cin >> b;
    cout << "b = " << b << ", размер = " << (int)b << endl;

    // 3. лоступ по индексу
    if ((int)b > 0) { // если множество не пустое
        cout << "b[0] = " << b[0] << endl;
        b[0] = 100; // изменяем первый элемент (прямой доступ)
        cout << "После b[0]=100: " << b << endl;
    }

    // 4. присваивание
    Set c;
    c = b; // копируем b в c
    cout << "c = b => " << c << endl;

    // 5. пересечение
    Set d = a * b;
    cout << "a * b = " << d << endl;

    // 6. итератор: переход к предыдущему элементу (--)
    cout << "\n--- Итератор (перебор в обратном порядке) ---" << endl;
    if ((int)b > 0) {
        Iterator it = b.last();   // за последним
        --it;                     // на последний
        cout << "Последний: " << *it << endl;
        if (it != b.first()) { // если не единственный элемент
            --it; // переходим к предыдущему
            cout << "Предпоследний: " << *it << endl;
        }
    }

    // 7. перебор всех элементов с помощью итератора (с использованием ++)
    cout << "\nПеребор в прямом порядке (через ++):" << endl;
    for (Iterator i = b.first(); i != b.last(); ++i) {
        cout << *i << " "; // выводим каждый элемент
    }
    cout << endl;

    // 8. приведение к int
    cout << "\nРазмер a = " << (int)a << endl;
    cout << "Размер b = " << (int)b << endl;

    return 0;
}


