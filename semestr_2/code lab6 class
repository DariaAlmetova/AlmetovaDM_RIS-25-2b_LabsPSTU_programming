#pragma once
#include <iostream>
using namespace std;

class Set; // предварительное объявление класса Set (необходимо для friend-связи в Iterator).

class Iterator { // класс - итератор для последовательного доступа к элементам множества. поддерживает операции ++ (вперёд), -- (назад), сравнение, разыменование. дружит с классом Set, чтобы Set мог создавать итераторы на свои внутренние данные.
    friend class Set; // дружба: Set имеет доступ к private-полям Iterator.
public:
    Iterator(); // конструктор по умолчанию.
    Iterator(const Iterator& it); // копирования.
    Iterator(int* p); // конструктор от указателя на int (публичный, нужен для создания beg/end).

    // орперации сравнения (нужны для циклов: i != last()).
    bool operator==(const Iterator& it) const;
    bool operator!=(const Iterator& it) const;

    // переход к следующему элементу (для перебора вперёд)
    Iterator& operator++(); // префиксный ++
    Iterator operator++(int); // постфиксный ++

    // переход к предыдущему элементу
    Iterator& operator--(); // префиксный --
    Iterator operator--(int); // постфиксный --

    int& operator*() const; // разыменование: возвращает ссылку на текущий элемент (позволяет изменять значение)

private:
    int* elem; // указатель на текущий элемент в массиве data множества
};

class Set { // класс - контейнер "Множество" (Set) для хранения уникальных целых чисел. реализован на основе динамического массива. размер меняется при добавлении.
public:
    // конструкторы
    Set(int s = 0, int k = 0); // по умолчанию – пустое множество. если s>0, создаёт множество из одного элемента k.
    Set(const Set& other); // копирования

    // деструктор
    ~Set();

    // оператор присваивания
    Set& operator=(const Set& other);

    // доступ по индексу (прямой доступ к элементу, возвращает ссылку для изменения).
    int& operator[](int index);

    // пересечение множеств. возвращает новое множество с общими элементами.
    Set operator*(const Set& other) const;

    // Приведение к int – возвращает размер
    operator int() const;

    // дружественные функции ввода/вывода (имеют доступ к private-полям)
    friend ostream& operator<<(ostream& out, const Set& s);
    friend istream& operator>>(istream& in, Set& s);

    // методы для итератора
    Iterator first() const; // итератор на первый элемент
    Iterator last() const;

private:
    int size; // текущее количество уникальных элементов
    int* data; // указатель на динамический массив уникальных элементов
    Iterator beg; // итератор на первый элемент (всегда data[0])
    Iterator end; // итератор на элемент после последнего (data[size])

    // вспомогательные методы
    bool contains(int val) const; // проверяет, есть ли значение val в множестве
    void addUnique(int val); // добавляет значение, если его ещё нет
};
