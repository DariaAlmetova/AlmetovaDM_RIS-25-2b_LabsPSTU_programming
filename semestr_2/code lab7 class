#pragma once // защита от повторного включения заголовочного файла (альтернатива #ifndef)
#ifndef SET_H // если символ SET_H не определён, то начинаем компиляцию содержимого
#define SET_H // определяем символ SET_H, чтобы при повторном включении содержимое было пропущено

#include <iostream>
using namespace std;

// щаблон класса Set (множество уникальных элементов)
template <class T> // объявляем шаблон с параметром типа T (тип элементов множества)
class Set // начало определения класса Set
{
private:
    T* data; // указатель на динамический массив элементов типа T
    int size; // текущее количество элементов в множестве

public:
    // конструкторы
    Set(); // конструктор по умолчанию (создаёт пустое множество)
    Set(const Set<T>& other); // конструктор копирования (создаёт копию другого множества)
    ~Set(); // деструктор (освобождает динамическую память)

    // оператор присваивания
    Set<T>& operator=(const Set<T>& other); // перегрузка оператора = для копирования множества

    // добавление элемента (без дубликатов)
    void Add(const T& value); // метод добавляет элемент в множество, если его там ещё нет

    T& operator[](int index); // перегрузка [] для доступа к элементу по индексу
    operator int() const; // перегрузка приведения типа к int (возвращает размер множества)
    Set<T> operator*(const Set<T>& other) const; // перегрузка * для пересечения двух множеств

    bool Contains(const T& value) const; // проверяет, содержится ли значение value в множестве

    // дружественные шаблонные функции ввода/вывода
    template <class U> // шаблон для дружественной функции вывода
    friend ostream& operator<<(ostream& out, const Set<U>& s); // вывод множества в поток
    template <class U> // шаблон для дружественной функции ввода
    friend istream& operator>>(istream& in, Set<U>& s); // ввод множества из потока

private:
    void resize(int newSize); // изменяет размер массива data на newSize (при добавлении элемента)
};

// реализация методов шаблона класса Set

// конструктор по умолчанию
template <class T> // шаблонный заголовок
Set<T>::Set() : data(nullptr), size(0) // инициализируем указатель нулём, размер нулём
{
}                                     // тело конструктора пустое

// конструктор копирования
template <class T>
Set<T>::Set(const Set<T>& other) : data(nullptr), size(other.size) // инициализируем размер как у other, data пока nullptr
{
    if (size > 0) {
        data = new T[size]; // выделяем память под size элементов типа T
        for (int i = 0; i < size; i++) // цикл по всем элементам
            data[i] = other.data[i]; // копируем каждый элемент из other в новый массив
    }
}

// деструктор
template <class T>
Set<T>::~Set() // деструктор
{
    delete[] data; // освобождаем память, выделенную под массив data
    data = nullptr; // обнуляем указатель
    size = 0; // обнуляем размер
}

// оператор присваивания
template <class T>
Set<T>& Set<T>::operator=(const Set<T>& other) // возвращает ссылку на текущий объект
{
    if (this == &other) return *this; // защита от самоприсваивания (если объект сам себе)
    delete[] data; // освобождаем старую память
    size = other.size; // копируем размер
    if (size > 0) { // если новый размер больше нуля
        data = new T[size]; // выделяем новую память
        for (int i = 0; i < size; i++) // копируем элементы
            data[i] = other.data[i];
    }
    else { // если размер нулевой
        data = nullptr; // устанавливаем указатель в nullptr
    }
    return *this; // возвращаем ссылку на текущий объект
}

// добавление элемента (без дубликатов)
template <class T>
void Set<T>::Add(const T& value) // принимает константную ссылку на добавляемое значение
{
    if (Contains(value)) return; // если элемент уже есть, выходим из метода (не добавляем)
    resize(size + 1); // увеличиваем размер массива на 1 (выделяем память)
    data[size - 1] = value; // помещаем новый элемент в конец массива (индекс size-1 после resize)
}

// проверка наличия элемента
template <class T>
bool Set<T>::Contains(const T& value) const // константный метод, не изменяет объект
{
    for (int i = 0; i < size; i++) // перебираем все элементы
        if (data[i] == value) // если нашли равный (используется operator== типа T)
            return true;
    return false;
}

// оператор доступа по индексу
template <class T>
T& Set<T>::operator[](int index) // возвращает ссылку на элемент, чтобы можно было изменять
{
    if (index < 0 || index >= size) { // если индекс вне допустимых границ
        cout << "\nОшибка: индекс вне диапазона!" << endl;
        static T dummy = T(); // создаём статический фиктивный объект (чтобы было что вернуть)
        return dummy; // возвращаем ссылку на фиктивный объект
    }
    return data[index]; // иначе возвращаем ссылку на элемент по индексу
}

// оператор приведения к int (возвращает размер)
template <class T>
Set<T>::operator int() const // константный метод, не изменяет объект
{
    return size; // возвращаем текущий размер множества
}

// оператор пересечения множеств
template <class T> 
Set<T> Set<T>::operator*(const Set<T>& other) const // константный метод, не изменяет текущее множество
{
    Set<T> result; // создаём пустое результирующее множество
    for (int i = 0; i < size; i++) { // перебираем элементы текущего множества
        if (other.Contains(data[i])) // если элемент содержится в other
            result.Add(data[i]); // добавляем его в результат
    }
    return result; //вВозвращаем результат по значению
}

// вспомогательный метод изменения размера массива
template <class T>
void Set<T>::resize(int newSize) // принимает новый размер
{
    T* newData = new T[newSize]; // выделяем новый массив размером newSize
    int minSize = (newSize < size) ? newSize : size; // определяем, сколько элементов копировать (минимум из старого и нового)
    for (int i = 0; i < minSize; i++) // копируем элементы из старого массива
        newData[i] = data[i];
    delete[] data; // удаляем старый массив
    data = newData; // перенаправляем указатель на новый массив
    size = newSize; // обновляем размер
}

// глобальная дружественная функция вывода множества в поток
template <class U> // шаблонный заголовок (U - тип элементов)
ostream& operator<<(ostream& out, const Set<U>& s) // принимает поток и константную ссылку на множество
{
    out << "{ ";
    for (int i = 0; i < s.size; i++) // перебираем все элементы множества
        out << s.data[i] << " "; // выводим каждый элемент и пробел
    out << "}";
    return out; // возвращаем поток для цепочечных операций
}

// глобальная дружественная функция ввода множества из потока
template <class U>
istream& operator>>(istream& in, Set<U>& s) // принимает поток и ссылку на множество (будет изменяться)
{
    int n; // переменная для количества элементов
    cout << "Введите количество элементов: ";
    in >> n; // считываем количество
    s = Set<U>(); // очищаем текущее множество (присваиваем пустое)
    cout << "Введите " << n << " элементов:\n";
    for (int i = 0; i < n; i++) { // цикл для ввода n элементов
        U value; // временная переменная для элемента
        in >> value; // считываем значение из потока
        s.Add(value); // добавляем его во множество (дубликаты будут проигнорированы)
    }
    return in; // возвращаем поток для цепочечных операций
}
#endif
