#include "Money.h"

Money::Money() : rub(0), kop(0) // конструктор по умолчанию: инициализируем рубли и копейки нулями
{
}                                     // тело конструктора пустое, т.к. вся инициализация выполнена в списке

Money::Money(long r, int k) // конструктор с параметрами: рубли и копейки
{
    rub = r; // присваиваем полю rub значение переданного параметра r
    kop = k; // присваиваем полю kop значение переданного параметра k
    // нормализация: если копеек >= 100
    if (kop >= 100) {
        rub += kop / 100; // добавляем к рублям целое число сотен копеек (kop/100)
        kop %= 100; // оставляем остаток копеек (от 0 до 99)
    }
    else if (kop < 0) { // иначе если копейки отрицательные
        long adjust = (-kop + 99) / 100; // вычисляем, сколько рублей нужно вычесть: округление вверх отрицательного числа
        rub -= adjust; // уменьшаем рубли на adjust
        kop += adjust * 100; // увеличиваем копейки на adjust*100, чтобы они стали в диапазоне 0..99
    }
}

Money::Money(const Money& other) : rub(other.rub), kop(other.kop) // конструктор копирования: инициализируем поля значениями из other
{
}                                     // тело пустое, инициализация выполнена в списке

Money::~Money() // деструктор класса Money (не выполняет освобождения памяти, т.к. нет динамических ресурсов)
{
}                                     // пустое тело деструктора

Money& Money::operator=(const Money& other) // перегрузка оператора присваивания: возвращает ссылку на текущий объект
{
    if (this == &other) return *this; // проверка на самоприсваивание: если адрес текущего объекта равен адресу other, возвращаем *this
    rub = other.rub; // копируем рубли из other
    kop = other.kop; // копируем копейки из other
    return *this; // возвращаем ссылку на текущий объект для цепочечных операций (a = b = c)
}

bool Money::operator==(const Money& other) const // перегрузка оператора равенства: возвращает true, если суммы равны
{
    return (rub == other.rub && kop == other.kop); // возвращаем результат сравнения рублей и копеек
}

ostream& operator<<(ostream& out, const Money& m) // перегрузка оператора вывода в поток (дружественная функция)
{
    out << m.rub << ","; // выводим рубли и запятую (как разделитель целой и дробной части)
    if (m.kop < 10) out << "0"; // если копеек меньше 10, выводим ведущий ноль (чтобы было две цифры)
    out << m.kop; // выводим копейки
    return out; // возвращаем поток для цепочечных операций (cout << m1 << m2)
}

istream& operator>>(istream& in, Money& m) // перегрузка оператора ввода из потока (дружественная функция)
{
    cout << "Введите рубли и копейки: ";
    in >> m.rub >> m.kop; // считываем два целых числа: рубли и копейки
    // нормализация
    if (m.kop >= 100) {
        m.rub += m.kop / 100; // добавляем к рублям целое число сотен копеек
        m.kop %= 100; // оставляем остаток копеек от 0 до 99
    }
    else if (m.kop < 0) { // иначе если копейки отрицательные
        long adjust = (-m.kop + 99) / 100; // вычисляем корректировку рублей (округление вверх модуля копеек)
        m.rub -= adjust; // уменьшаем рубли на adjust
        m.kop += adjust * 100; // увеличиваем копейки, чтобы они стали в диапазоне 0..99
    }
    return in; // Возвращаем поток для цепочечных операций (cin >> m1 >> m2)
}


