#include "Set.h"
#include "Money.h"
#include <iostream>
using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");

    cout << "========== Тестирование Set<int> ==========\n";

    Set<int> s1; // создаём объект s1 типа Set<int> (пустое множество)
    s1.Add(10); // добавляем элемент 10 в множество s1
    s1.Add(20);
    s1.Add(30);
    s1.Add(20); // попытка добавить дубликат 20 – метод Add не добавит, так как элемент уже есть
    cout << "Множество s1: " << s1 << endl;
    cout << "Размер s1: " << (int)s1 << endl;
    cout << "Элемент по индексу 1: " << s1[1] << endl; // доступ к элементу с индексом 1 (второй элемент) через operator[]

    Set<int> s2; // создаём второе множество целых чисел s2 (пустое)
    s2.Add(20);
    s2.Add(30);
    s2.Add(40);
    cout << "Множество s2: " << s2 << endl;

    Set<int> s3 = s1 * s2; // вычисляем пересечение множеств s1 и s2 с помощью operator* и сохраняем в s3
    cout << "Пересечение s1 * s2: " << s3 << endl;

    cout << "\n========== Тестирование Set<float> ==========\n";

    Set<float> sf;// создаём множество вещественных чисел типа float
    sf.Add(1.1f); // добавляем 1.1 (суффикс f обозначает float)
    sf.Add(2.2f);
    sf.Add(3.3f);
    cout << "sf: " << sf << endl;
    cout << "Размер: " << (int)sf << endl;

    cout << "\n========== Тестирование Set<double> ==========\n";

    Set<double> sd; // создаём множество чисел с плавающей точкой двойной точности
    sd.Add(1.11);
    sd.Add(2.22);
    sd.Add(3.33);
    cout << "sd: " << sd << endl;

    cout << "\n========== Тестирование Set<Money> ==========\n";

    Set<Money> sm; // создаём множество объектов типа Money
    Money m1(10, 50); // создаём объект Money с 10 рублями 50 копеек
    Money m2(20, 75);
    Money m3(10, 50); // создаём ещё один объект, равный m1 (дубликат)
    sm.Add(m1);// добавляем m1 в множество
    sm.Add(m2);
    sm.Add(m3); // попытка добавить дубликат – не добавится, так как m3 == m1
    cout << "Множество Money: " << sm << endl;
    cout << "Размер: " << (int)sm << endl; // выводим размер множества (2, т.к. дубликат не добавлен)

    Set<Money> sm2; // создаём второе множество Money
    sm2.Add(m2); // добавляем m2 (20,75)
    sm2.Add(Money(30, 0)); // добавляем временный объект Money(30,0)
    cout << "Множество Money sm2: " << sm2 << endl;

    Set<Money> inter = sm * sm2; // вычисляем пересечение множеств sm и sm2 (должен быть m2)
    cout << "Пересечение: " << inter << endl;

    cout << "\n========== Ввод множества Set<int> ==========\n";
    Set<int> s_in; // создаём пустое множество целых чисел
    cin >> s_in; // вызываем operator>> для ввода множества (запрашивает размер и элементы)
    cout << "Вы ввели: " << s_in << endl;

    return 0;
}


