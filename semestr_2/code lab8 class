// конструктор по умолчанию
Employee::Employee() : Person(), salary(0.0f), position("") // вызываем конструктор Person, затем свои поля
{
}                                 // тело пустое

// конструктор с параметрами
Employee::Employee(string n, int a, float s, string p)
    : Person(n, a), salary(s), position(p) // передаём параметры в Person, затем свои
{
}                                 // тело пустое

// конструктор копирования
Employee::Employee(const Employee& other)
    : Person(other), salary(other.salary), position(other.position) // копируем базовую часть и свои поля
{
}                                 // тело пустое

// деструктор (ничего не делает)
Employee::~Employee() {}           // пустое тело

// оператор присваивания
Employee& Employee::operator=(const Employee& other)
{
    if (this == &other) return *this; // защита от самоприсваивания
    Person::operator=(other); // присваиваем базовую часть через operator= Person
    salary = other.salary; // копируем зарплату
    position = other.position; // копируем должность
    return *this; // возвращаем ссылку
}

// ввод данных сотрудника
void Employee::Input()
{
    Person::Input(); // сначала вводим базовые данные (имя, возраст)
    cout << "Введите зарплату: "; cin >> salary;
    cout << "Введите должность: "; cin >> position;
}

// вывод информации о сотруднике
void Employee::Show()
{
    Person::Show(); // выводим имя и возраст
    cout << "Зарплата: " << salary << ", Должность: " << position << endl;
}

// обработчик событий для Employee
void Employee::HandleEvent(const TEvent& e)
{
    if (e.what == evMessage && e.command == cmGet) // если команда "вывести имя"
    {
        cout << "Имя сотрудника: " << name << endl; // выводим имя (унаследованное поле)
    }
    else
    {
        Person::HandleEvent(e); // иначе передаём обработку базовому классу
    }
}


