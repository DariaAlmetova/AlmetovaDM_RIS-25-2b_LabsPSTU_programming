#include "List.h"
#include "Person.h"
#include "Employee.h"
#include <iostream>
using namespace std;

// конструктор без параметров: создаёт пустой список без ограничения размера.
List::List() : head(nullptr), tail(nullptr), size(0), cur(0) {}

// конструктор с максимальным размером (size > 0).
List::List(int maxSize) : head(nullptr), tail(nullptr), size(maxSize), cur(0) {} // список изначально пуст, но при добавлении элементов будет проверяться лимит.

// деструктор: освобождает всю память, занятую узлами и объектами.
List::~List() {
    Clear(); // вызываем общую очистку
}

// очистка списка: удаляет все узлы и хранимые объекты. проход от головы к хвосту, сохраняя указатель на следующий узел перед удалением.
void List::Clear() {
    Node* current = head; // начинаем с первого узла
    while (current) {
        Node* next = current->next; // запоминаем следующий узел, так как current будет удалён
        delete current->data; // удаляем объект (Person или Employee)
        delete current; // удаляем сам узел
        current = next; // переходим к следующему
    }
    head = tail = nullptr; // обнуляем указатели начала и конца
    cur = 0; // сбрасываем счётчик
}

// оператор приведения к int: возвращает текущее количество элементов в списке.
int List::operator()() const {
    return cur;
}

// добавление объекта в конец списка. параметр: p – указатель на созданный вне списка объект (Person/Employee).
// если задан максимальный размер и он достигнут – объект удаляется, добавляется сообщение.
void List::Add(Object* p) {
    // проверка лимита размера (если size>0, значит ограничение активно)
    if (size > 0 && cur >= size) {
        cout << "Группа переполнена!" << endl;
        delete p; // иначе произойдёт утечка памяти
        return;
    }

    // создаём новый узел: данные – p, предыдущий – текущий tail, следующий – nullptr.
    Node* newNode = new Node(p, tail, nullptr);

    if (!head) { // список был пуст?
        head = tail = newNode; // тогда новый узел становится и головой, и хвостом
    }
    else {
        tail->next = newNode; // старый хвост указывает на новый узел
        tail = newNode; // новый узел становится хвостом
    }
    ++cur; // увеличиваем счётчик элементов
}

// удаление последнего элемента (из хвоста).
void List::Del() {
    if (!tail) {   // список пуст (tail == nullptr)
        cout << "Группа пуста, нечего удалять." << endl;
        return;
    }

    Node* toDelete = tail; // запоминаем удаляемый узел
    tail = tail->prev; // перемещаем tail на предыдущий узел

    if (tail) // если новый tail существует (список не станет пустым)
        tail->next = nullptr; // обрываем связь с удаляемым узлом
    else
        head = nullptr; // если список стал пустым, обнуляем и head

    delete toDelete->data; // удаляем объект (Person/Employee)
    delete toDelete; // удаляем узел
    --cur; // уменьшаем счётчик
}

// вывод всех элементов списка в консоль с нумерацией (начиная с 1).
void List::ShowAll() {
    if (cur == 0) {
        cout << "Группа пуста." << endl;
        return;
    }

    Node* current = head;
    int index = 1;
    while (current) {
        cout << index++ << ". ";
        current->data->Show(); // полиморфный вызов: Person::Show() или Employee::Show()
        current = current->next;
    }
}

// вывод имени элемента по его индексу (1-нумерация). создаётся событие TEvent с командой cmGet и отправляется выбранному объекту.
void List::ShowByIndex(int idx) {
    // Проверка границ
    if (idx < 1 || idx > cur) {
        cout << "Неверный индекс." << endl;
        return;
    }

    // находим узел с индексом idx (линейный поиск от головы)
    Node* current = head;
    for (int i = 1; i < idx; ++i)
        current = current->next;

    // формируем событие для получения имени
    TEvent ev;
    ev.what = evMessage;
    ev.command = cmGet;
    // передаём событие объекту – он сам решит, как отреагировать (выведет имя)
    current->data->HandleEvent(ev);
}

// передача события всем элементам списка. каждый объект (Person или Employee) самостоятельно обрабатывает событие, если оно ему интересно (например, cmGet).
void List::HandleEvent(const TEvent& e) {
    Node* current = head;
    while (current) {
        current->data->HandleEvent(e);
        current = current->next;
    }
}


