#include "Dialog.h"
#include "Person.h"
#include "Employee.h" 
#include <iostream>
#include <string> 
#include <cstdlib> // для atoi (преобразование строки в число)
using namespace std;

// конструктор: вызываем конструктор List (по умолчанию) и обнуляем EndState
Dialog::Dialog() : List(), EndState(0) {}

// деструктор (ничего не делает, т.к. ресурсы освобождаются в ~List)
Dialog::~Dialog() {}

// получение события от пользователя
void Dialog::GetEvent(TEvent& event)
{
    string input; // строка для хранения ввода
    char code; // первый символ (код команды)
    cout << "> "; // приглашение
    cin >> input; // считываем строку
    if (input.empty()) return; // если ничего не ввели – выходим

    code = input[0]; // берём первый символ
    event.what = evMessage; // по умолчанию событие – сообщение

    // определяем команду по первому символу
    switch (code)
    {
    case 'm': event.command = cmMake; break;   // создать группу
    case '+': event.command = cmAdd;  break;   // добавить элемент
    case '-': event.command = cmDel;  break;   // удалить элемент
    case 's': event.command = cmShow; break;   // вывести группу
    case 'z': event.command = cmGet;  break;   // вывести имя по индексу
    case 'q': event.command = cmQuit; break;   // выход
    default:  event.what = evNothing; return;  // неизвестная команда – пустое событие
    }

    // если команда 'z', после неё может быть число (например z3)
    if ((code == 'm' || code == 'z') && input.length() > 1)
    {
        string param = input.substr(1); // выделяем подстроку, начиная со второго символа
        event.a = atoi(param.c_str());  // преобразуем в целое число и сохраняем в поле a
    }
    else
    {
        event.a = 0; // для остальных команд параметр = 0
    }
}

// очистка события (помечаем как пустое)
void Dialog::ClearEvent(TEvent& event)
{
    event.what = evNothing; // устанавливаем тип "пустое событие"
}

// проверка, нужно ли завершить программу
int Dialog::Valid()
{
    return (EndState != 0); // возвращаем true, если EndState не ноль
}

// установка флага завершения
void Dialog::EndExec()
{
    EndState = 1; // устанавливаем признак "конец работы"
}

// главный цикл обработки событий
int Dialog::Execute()
{
    TEvent event; // структура для события
    do
    {
        EndState = 0; // сбрасываем флаг (ждём команду)
        GetEvent(event); // получаем событие от пользователя
        if (event.what != evNothing) // если событие не пустое
            HandleEvent(event); // обрабатываем его
    } while (!Valid()); // повторяем, пока Valid() не вернёт true (т.е. EndState != 0)
    return EndState; // возвращаем код завершения
}

// обработчик событий (команд) для диалога
void Dialog::HandleEvent(TEvent& event)
{
    if (event.what == evMessage) // если это сообщение (команда)
    {
        switch (event.command) // выбор действия по коду команды
        {
        case cmMake: // создать группу (формат m<число>)
        {
            int n = event.a;
            if (n <= 0) {
                cout << "Укажите положительный размер (например m5)" << endl;
            }
            else {
                Clear(); // очищаем текущий список
                size = n; // устанавливаем новую максимальную ёмкость
                cout << "Создана группа размером " << size << endl;
            }
            ClearEvent(event);
        }
        break;

        case cmAdd: // добавить элемент (+)
        {
            int type;
            cout << "Тип: 1 - Человек, 2 - Сотрудник: ";
            cin >> type;
            Object* p = nullptr;
            if (type == 1)
                p = new Person(); // создаём Person
            else if (type == 2)
                p = new Employee(); // создаём Employee
            else
            {
                cout << "Неверный тип." << endl;
                break;
            }
            p->Input(); // вводим данные (полиморфизм)
            Add(p); // добавляем в группу
            ClearEvent(event);
        }
        break;

        case cmDel: // удалить элемент (-)
            Del(); // удаляем последний
            ClearEvent(event);
            break;

        case cmShow: // показать всю группу (s)
            ShowAll();
            ClearEvent(event);
            break;

        case cmGet: // вывести имя элемента с номером k (z k)
            ShowByIndex(event.a); // event.a содержит индекс
            ClearEvent(event);
            break;

        case cmQuit: // выход (q)
            EndExec(); // устанавливаем флаг завершения
            ClearEvent(event);
            break;

        default:
            // если команда не распознана диалогом – передаём группе (List)
            List::HandleEvent(event);
            break;
        }
    }
}


