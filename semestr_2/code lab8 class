Event.h

#pragma once

const int evNothing = 0; // пустое событие (событие обработано)
const int evMessage = 100; // непустое событие (сообщение от пользователя)

// коды команд (что нужно сделать)
const int cmMake = 1; // создать группу (команда m)
const int cmAdd = 2; // добавить элемент (команда +)
const int cmDel = 3; // удалить элемент (команда -)
const int cmShow = 4; // вывести всю группу (команда s)
const int cmGet = 5; // вывести имя элемента по индексу (команда z)
const int cmQuit = 101; // завершить работу (команда q)

// структура, описывающая событие
struct TEvent
{
    int what; // тип события (evNothing или evMessage)
    union // объединение: разные интерпретации одних и тех же байтов
    {
        int command; // код команды (если событие – команда)
        struct // альтернативная структура для параметров
        {
            int message;// дополнительный код
            int a; // параметр команды (например, индекс элемента)
        };
    };
};
