#pragma once
#include "Object.h"
#include "Event.h"

// узел двусвязного списка
struct Node {
    Object* data; // указатель на объект (Person или Employee)
    Node* prev; // указатель на предыдущий узел
    Node* next; // указатель на следующий узел

    Node(Object* obj, Node* p = nullptr, Node* n = nullptr) // конструктор структуры Node
        : data(obj), prev(p), next(n) {
    }
};

class List {
public:
    List(); // конструктор без параметров
    List(int maxSize); // конструктор с максимальным размером
    List(const List& other) = delete; // запрет копирования
    List& operator=(const List& other) = delete; // запрет присваивания
    virtual ~List(); // деструктор

    int operator()() const; // возвращает текущее количество элементов

    void Add(Object* p); // добавить объект в конец
    void Del(); // удалить последний элемент
    void ShowAll(); // вывести все элементы
    void ShowByIndex(int idx); // вывести имя элемента по индексу (1-нумерация)
    void Clear(); // очистить список (удалить все элементы)

    virtual void HandleEvent(const TEvent& e); // передать событие всем элементам

protected:
    Node* head; // начало списка
    Node* tail; // конец списка
    int size; // максимальная ёмкость (0 – без ограничений)
    int cur; // текущее количество элементов
};


